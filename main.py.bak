# ---- 서버 시작 시 딱 1번 로딩 (질문마다 다시 안 읽음) ----
print("검색 인덱스 로딩 중...")
with open("chunks.json", encoding="utf-8") as f:
    chunks = json.load(f)
with open("embeddings.json", encoding="utf-8") as f:
    embs = json.load(f)
idx_list = [e["idx"] for e in embs]
matrix = np.array([e["embedding"] for e in embs])
matrix = matrix / np.linalg.norm(matrix, axis=1, keepdims=True)
print(f"로딩 완료: 청크 {len(idx_list)}개")

# ---- v7: 경량 BM25 키워드 인덱스 (외부 라이브러리 없이 직접 구현) ----
import math
from collections import Counter

def _tok(text):
    """한국어 대응 토큰화: 공백 단어 + 2글자 조각(바이그램)"""
    words = text.lower().split()
    grams = []
    for w in words:
        grams.append(w)
        grams += [w[i:i + 2] for i in range(len(w) - 1)]
    return grams

try:
    print("BM25 키워드 인덱스 구축 중... (수십 초 걸릴 수 있음)")
    _N = len(idx_list)
    _doc_len = np.zeros(_N)
    _df = {}
    _tmp = []
    for i, j in enumerate(idx_list):
        c = Counter(_tok(chunks[j]["text"]))
        _tmp.append(c)
        _doc_len[i] = sum(c.values())
        for t in c:
            _df[t] = _df.get(t, 0) + 1
    _avg_len = float(_doc_len.mean()) or 1.0
    # 너무 흔한 토큰(전체 40% 이상 문서에 등장)은 제외 → 메모리·속도 절약
    _idf = {t: math.log(1 + (_N - n + 0.5) / (n + 0.5))
            for t, n in _df.items() if n <= _N * 0.4}
    _inv = {}
    for i, c in enumerate(_tmp):
        for t, tf in c.items():
            if t in _idf:
                _inv.setdefault(t, []).append((i, tf))
    _inverted = {t: (np.array([p[0] for p in v], dtype=np.int32),
                     np.array([p[1] for p in v], dtype=np.float32))
                 for t, v in _inv.items()}
    del _tmp, _inv, _df

    def bm25_scores(query, k1=1.5, b=0.75):
        s = np.zeros(_N)
        norm = k1 * (1 - b + b * _doc_len / _avg_len)
        for t in set(_tok(query)):
            hit = _inverted.get(t)
            if hit is None:
                continue
            ids, tfs = hit
            s[ids] += _idf[t] * tfs * (k1 + 1) / (tfs + norm[ids])
        return s

    HYBRID = True
    SEARCH_MODE = "임베딩+키워드(BM25) 하이브리드"
    print(f"BM25 인덱스 구축 완료 (토큰 {len(_inverted):,}종) → 하이브리드 검색 사용")
except Exception as _e:
    HYBRID = False
    SEARCH_MODE = "임베딩"
    print(f"BM25 구축 실패, 임베딩 단독 검색으로 진행: {_e}")

app = FastAPI()

