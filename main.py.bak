# ============================================================
VERIFY = True  # False로 바꾸면 검증 레이어 끔 (비교 실험용)

# [1차] 판정만: 다시 쓸 기회를 주지 않고 JSON으로 불일치 여부만 답하게 함
VERIFY_CHECK_SYSTEM = (
