# ============================================================
# v8: 멀티턴(대화 이어가기) — 직전 대화를 기억해 후속 질문 처리
# 오염 방지: 지시어가 있거나, 직전에 봇이 되물었고 짧은 답이 온 경우에만 맥락 사용
# ============================================================
from collections import deque
HISTORY = deque(maxlen=3)  # (질문, 답변) 최근 3개 저장

FOLLOWUP_WORDS = ("그럼", "그거", "그건", "그게", "아까", "방금", "위에서",
                  "이어서", "앞에서", "그 중", "그중", "말한 거", "말했던")

_DOMAIN_WORDS = ("연금", "IRP", "퇴직", "세액", "공제", "수령", "납입", "인출",
                 "상품", "펀드", "ETF", "TDF", "세금", "보험", "디폴트")

def is_followup(question):
    """이번 질문이 직전 대화에 이어지는 후속 질문인지 판정 (오염 방지 위해 보수적으로)"""
    if not HISTORY:
        return False
    if any(w in question for w in FOLLOWUP_WORDS):
        return True
    prev_q, prev_a, prev_askback = HISTORY[-1]
    # 직전 답변이 '되묻기'였고, 사용자가 '대답 형태'(짧고, 물음표·연금 용어 없음)로 응답한 경우
    if (prev_askback and len(question) <= 20 and "?" not in question
            and not any(w in question for w in _DOMAIN_WORDS)):
        return True
    return False


