# v9.17: 수수료·보수는 상품·클래스·표에 따라 값이 여러 개인 것이 정상이다.
#   기준을 밝히지 않고 값 하나만 인용하면 사실상 오답이 되고, 실제로 문서 안에서
#   값이 갈리는 경우(같은 클래스가 요약표와 상세표에 다르게 기재)도 있을 수 있다.
#   → 검색된 문서에 보수 값이 둘 이상 있으면 인용 기준을 코드로 못박는다.
FEE_LABELS = ("총보수·비용", "총보수비용", "합성총보수", "총보수", "보수·비용", "총 보수")
FEE_WORDS = ("수수료", "보수", "비용")
_FEE_NUM = re.compile(r"\d+\.\d+")


_DEC = re.compile(r"\d+\.\d+")


