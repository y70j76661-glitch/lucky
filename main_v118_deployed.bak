def find_must_chunks(question, exclude, limit_total=2):
    """질문이 특정 주제면 필요한 청크를 코퍼스에서 직접 찾아온다."""
    seen = {c["text"] for c in exclude}
    out = []
    for q_any, q_any2, need, lim in MUST_CHUNKS:
        if not any(k in question for k in q_any):
            continue
        if q_any2 and not any(k in question for k in q_any2):
            continue
        got = 0
        for c in chunks:
            if c["text"] in seen or any(c["text"] == o["text"] for o in out):
                continue
            if any(k in c["text"] for k in need):
                out.append(c)
                got += 1
                if got >= lim:
                    break
        if out:
            break
    return out[:limit_total]



def find_fee_rows(sources, exclude, limit=2):
    """v9.20: 보수표는 숫자 나열이라 임베딩 유사도가 낮아 상위에 못 든다.
    (실측: 질문과 같은 문서인데도 17위) → 검색된 문서 안에서 보수표 청크를 직접 찾아 넣는다."""
    seen = {c["text"] for c in exclude}
    cand = []
    for c in chunks:
        if c["source"] not in sources or c["text"] in seen:
            continue
        t = c["text"]
        if "총보수" not in t or len(_DEC.findall(t)) < 6:
            continue
        cand.append(c)
    # 구성항목이 다 있는 상세표(신탁업자 포함)를 먼저, 숫자가 많은 것을 먼저
    cand.sort(key=lambda c: (("신탁업자" in c["text"]), len(_DEC.findall(c["text"]))),
              reverse=True)
    return cand[:limit]


# v9.21: 숫자표를 원문 그대로 주면 항목을 빠뜨린다(실측: 일반사무관리 0.02% 누락으로
#   0.72+0.7+0.03=1.45 ≠ 총보수 1.47). → 세액공제 계산기처럼 코드가 표를 읽어 카드로 만든다.
_FEE_FIRSTDEC = re.compile(r"\d+\.\d+")
_FEE_TOKEN = re.compile(r"\d+(?:\.\d+)?%?|[-–—]")
_FEE_CLSHEAD = re.compile(r"종류\s*([A-Za-z][A-Za-z0-9\-]*)")
_FEE_ITEMS = ["집합투자업자 보수", "판매회사 보수", "신탁업자 보수", "일반사무관리회사 보수"]


def _fnum(t):
    t = str(t).replace("%", "")
    try:
        return float(t)
    except ValueError:
        return None


def build_fee_card(text, source, limit=14):
    """보수표 청크 → 클래스별 구성항목·총보수를 정리한 카드 (없으면 None)"""
    rows = []
    for seg in re.split(r"(?=종류\s*[A-Za-z])", text):
        m = _FEE_CLSHEAD.match(seg.strip())
        if not m:
            continue
        d = _FEE_FIRSTDEC.search(seg)
        if not d:
            continue
        toks = _FEE_TOKEN.findall(seg[d.start():])
        if len(toks) < 9:
            continue
        n = [_fnum(t) for t in toks[:9]]
        if n[4] is None or not (0 < n[4] < 10):
            continue
        if any(v is not None and v > 10 for v in n[:5]):   # 수익률·연도 오인 방지
            continue
        rows.append((m.group(1), n))
        if len(rows) >= limit:
            break
    if not rows:
        return None
    out = [f"[보수 구성표 — 출처: {source}]",
           "※ 문서의 표를 코드가 그대로 옮긴 것이다. 항목을 빠뜨리거나 값을 바꾸지 마라.",
           "※ 클래스(종류)마다 값이 다르므로 반드시 어느 클래스 기준인지 밝혀서 인용하라."]
    for cls, n in rows:
        parts = [f"{_FEE_ITEMS[i]} {n[i]:g}%" if n[i] is not None
                 else f"{_FEE_ITEMS[i]} 없음" for i in range(4)]
        tot = round(sum(v for v in n[:4] if v is not None), 4)
        line = f"- 종류{cls}: " + " / ".join(parts) + f" → 총보수 {n[4]:g}%"
        if n[5] is not None:
            line += f" / 기타비용 {n[5]:g}%"
        if n[6] is not None:
            line += f" / 총보수·비용 {n[6]:g}%"
        line += f"   [구성항목 합계 {tot:g}%]"
        out.append(line)
    return "\n".join(out)


# v9.23: '가장 낮습니다', 'A가 B보다 높습니다' 같은 순위·우열 단정을 프롬프트로 네 번
#   막았으나 계속 재발했다. → 최상급 요구가 감지된 답변에 한해 코드로 잘라낸다.
#   단, '단정할 수 없다'처럼 부정으로 끝나는 문장은 오히려 필요하므로 남긴다.
_RANK_CLAIM = re.compile(
    r"(?:보다\s*(?:더\s*)?(?:낮|높|저렴|비싸|많|적)|"
    r"가장\s*(?:낮|높|저렴|비싸|적|많)|제일\s*(?:낮|높|저렴)|최저|최고)")
_RANK_NEG = re.compile(
    r"없|어렵|아닙|못하|말하기|판단할 수|단정|확인되지|알 수 없|비교할 수|"
    r"위해|찾기|비교해|살펴|알아보|하겠습니다|드리겠습니다")   # 서두·부정문은 유지


def strip_rank_claims(ans, active):
    """순위·우열을 단정한 문장을 제거한다. (표 줄은 건드리지 않음)"""
    if not active:
        return ans, 0
    removed, out = 0, []
    for line in ans.split("\n"):
        if "|" in line or not line.strip():      # 표·빈 줄은 그대로
            out.append(line)
            continue
        sents = re.split(r"(?<![0-9]\.)(?<=[.!?])\s+", line)
        keep = []
        for sent in sents:
            if _RANK_CLAIM.search(sent) and not _RANK_NEG.search(sent):
                removed += 1
                continue
            keep.append(sent)
        out.append(" ".join(keep))
    if not removed:
        return ans, 0
    ans = re.sub(r"\n{3,}", "\n\n", "\n".join(out)).strip()
    # 근거를 남기기 위해 한 문장으로 대체 (이미 같은 취지의 문장이 있으면 넣지 않는다)
    if not re.search(r"순위[^\n]{0,20}(없|확인)", ans):
        ans += ("\n\n제공된 자료에는 상품 간 총보수 순위 비교표가 없고, 값의 기준(클래스·표)도 "
                "서로 달라 어느 상품이 더 낮은지는 단정할 수 없습니다.")
    return ans, removed


# v9.26: 제공 문서에서 확인된 단위 오표기.
#   audit_numbers.py 전수 점검으로 찾았고, 문서 안의 다른 수치로 교차 검증했다.
#     · doc41.docx  "148만 5천만원(=900만원 x 16.5%)" → 900만×16.5% = 1,485,000원
#     · doc26.docx  "26만 4천만원"  → 이 값의 30%가 같은 문단의 '7만 9,200원'과 맞으므로
#                                    26만 4천원(264,000원)이 맞다
#   ※ 우리가 임의로 '보정'하지 않는다. 원문 표기를 밝히고 계산값을 함께 제시한다.
NUMBER_NOTES = [
    {"src": "doc41.docx", "wrong": "148만 5천만원", "right": "148만 5천원",
     "basis": "900만원 × 16.5% = 1,485,000원"},
    {"src": "doc26.docx", "wrong": "26만 4천만원", "right": "26만 4천원",
     "basis": "같은 문단의 '30% 절세액 7만 9,200원'과 맞는 값은 264,000원"},
]
_NOTE_PAT = [(n, re.compile(n["wrong"].replace(" ", r"\s*"))) for n in NUMBER_NOTES]


def build_number_card(context):
    """검색된 문서에 알려진 오표기가 있으면 주의 카드를 만든다"""
    hits = [n for n, pat in _NOTE_PAT if pat.search(context)]
    if not hits:
        return None, []
    lines = ["[문서 표기 주의 — 자료의 숫자와 계산값이 다른 곳]"]
    for n in hits:
        lines.append(f"- {n['src']}에 '{n['wrong']}'으로 적혀 있으나, {n['basis']}이므로 "
                     f"계산상 '{n['right']}'이다.")
    lines.append("※ 답변할 때 계산값을 쓰되, 자료 원문에는 다르게 적혀 있다는 사실을 "
                 "함께 밝혀라. 어느 쪽이 옳은지 단정하지 말고 확인이 필요하다고 안내하라.")
    return "\n".join(lines), hits


# v9.32: 유도성 질문의 잘못된 전제를 그대로 수긍하는 문제를 코드로 잡는다.
#   실측(H4): "총급여 5,500만원이면 13.2%" (→ 이하는 16.5%),
#             "중도해지해도 세금이 부과되지 않습니다" (→ 기타소득세 16.5%)
#   평가지표 첫 항목이 '잘못된 전제를 바로잡는가'라 실점이 크다.
_FALSE_PREMISE = [
    # (잘못된 서술 패턴, 바로잡는 문장)
    # '이하 … 16.5% … 13.2%'처럼 사이에 올바른 세율이 있으면 정상 문장이므로 건드리지 않는다
    (re.compile(r"[^\n]*5,?500\s*만\s*원?[^\n]{0,30}?(?:이하|인\s*경우|까지|정확히)"
                r"(?:(?!16\.5)[^\n]){0,40}?13\.2\s*%[^\n]*"),
     "총급여 5,500만원 이하(종합소득금액 4,500만원 이하)이면 세액공제율은 16.5%이고, "
     "이를 초과하면 13.2%입니다. 총급여가 정확히 5,500만원인 경우는 '이하'에 해당하므로 "
     "16.5%가 적용됩니다."),
    (re.compile(r"[^\n]*5,?500\s*만\s*원?[^\n]{0,30}?초과"
                r"(?:(?!13\.2)[^\n]){0,40}?16\.5\s*%[^\n]*"),
     "총급여 5,500만원을 초과하면 세액공제율은 13.2%입니다."),
    # v9.33: '**중도해지해도 세금**이 없습니다'처럼 마크다운 강조가 끼어들어도 잡히도록
    #        글자 사이에 * _ 공백을 허용한다 (실측 H4에서 이것 때문에 교정이 안 됐다)
    (re.compile(r"[^\n]*중도[\s*_]*해지[^\n]{0,40}?"
                r"(?:세금[\s*_]*이[\s*_]*부과되지[\s*_]*않|"
                r"세금[\s*_]*을?[\s*_]*(?:안[\s*_]*내|내지[\s*_]*않)|"
                r"과세[\s*_]*되지[\s*_]*않|세금[\s*_]*이[\s*_]*없)[^\n]*"),
     "중도해지하면 세액공제를 받은 납입금과 운용수익에 대해 기타소득세 16.5%가 부과됩니다. "
     "다만 세액공제를 받지 않은 납입금은 인출해도 세금이 없습니다."),
]


def fix_false_premise(ans):
    """사용자의 잘못된 전제를 수긍한 문장을 문서 기준 문장으로 교체"""
    cnt = 0
    for pat, right in _FALSE_PREMISE:
        out, n = pat.subn(right, ans)
        if n:
            ans, cnt = out, cnt + n
    return ans, cnt


# v9.33: 질문에 소득이 있는데 유형이 '세제'가 아니면 계산기가 안 돌아 세율을 틀린다.
#   실측(H2): "연봉 6천만원" 질문에 16.5%를 적용했다(5,500만원 초과이므로 13.2%).
#   → 유형과 무관하게, 소득이 보이면 세율 판정을 코드가 먼저 못박는다.
#   '총급여가 정확히 5,500만원'처럼 부사가 끼는 경우까지 잡는다
_INCOME_PAT = re.compile(
    r"(?:연봉|총급여|급여|연소득)[은는이가]?\s*(?:[가-힣]{1,4}\s*)?([\d,]+)\s*(천만|억|만)\s*원")
_TAX_WORDS = ("세액공제", "공제", "절세", "세금", "환급")


def income_rate_card(question):
    """질문의 총급여로 세액공제율을 코드가 판정한 카드 (없으면 None)"""
    if not any(w in question for w in _TAX_WORDS):
        return None
    m = _INCOME_PAT.search(question)
    if not m:
        return None
    try:
        v = float(m.group(1).replace(",", ""))
    except ValueError:
        return None
    unit = m.group(2)
    if unit == "천만":
        v *= 1000          # '6천만원' → 6,000만원
    elif unit == "억":
        v *= 10000
    if not (100 <= v <= 100000):
        return None
    over = v > 5500
    rate = "13.2%" if over else "16.5%"
    band = "초과" if over else "이하"
    return (f"[세액공제율 판정 — 코드 계산]\n"
            f"- 질문에 제시된 총급여(연봉): {int(v):,}만원\n"
            f"- 총급여 5,500만원 {band} → 세액공제율 {rate} (지방소득세 포함)\n"
            f"- 총급여 5,500만원 = 종합소득금액 4,500만원 (같은 경계선의 두 표현이다)\n"
            f"※ 이 판정을 그대로 사용하라. 다른 세율을 적용하거나 구간을 새로 만들지 마라."), rate


# v9.35: 계산기는 '본인이 납입한 금액'만 다뤄야 하는데, 질문에 아래 금액이 섞이면
#   추출이 이를 구분하지 못하고 합산해버린다(실측: 회사 500+본인 300 → 납입액 800만원).
#   그 결과 K5에서 "회사 부담금은 한도를 초과해서 제외"라는 틀린 근거가 나왔다.
#   → 이런 금액이 보이면 계산기를 끄고, 무엇이 대상이고 무엇이 아닌지 판정 카드를 준다.
#   각 항목: (질문 키워드, 프롬프트에 넣을 규칙, 답변에 있어야 할 표현, 없으면 붙일 문장)
_SCOPE_RULES = [
    (("회사가", "회사에서", "사용자부담금", "사용자 부담금", "회사부담금", "회사 부담금",
      "회사가 넣", "회사 납입"),
     "- 회사(사용자)가 낸 부담금은 세액공제 대상이 아니다. 이유는 '한도를 넘어서'가 아니라 "
     "'본인이 납입한 금액이 아니기 때문'이다. 이 점을 반드시 답변에 명시해라.",
     # v9.37: '회사'라는 단어만 있으면 설명한 것으로 봐서 보강이 건너뛰어졌다.
     #        판정은 '실제 설명 문구'로 해야 한다(테스트 판정과 같은 문구를 쓴다).
     ("본인이 낸 금액이 아니", "본인이 납입한 금액이 아니", "본인의 납입금액이 아니"),
     "회사(사용자)가 납입한 부담금은 본인이 낸 금액이 아니므로 세액공제 대상에서 제외됩니다. "
     "한도를 초과해서가 아니라 대상 자체가 아니기 때문입니다."),
    (("퇴직금", "퇴직급여", "명퇴수당", "명예퇴직금", "퇴직위로금"),
     "- 퇴직금(퇴직급여)을 연금계좌로 옮긴 금액은 과세이연 대상이며 세액공제 대상이 아니다. "
     "세액공제는 본인이 추가로 납입한 금액에만 적용된다.",
     ("과세이연", "퇴직소득세", "대상이 아"),
     "퇴직금을 연금계좌로 옮긴 금액은 과세이연 대상이며 세액공제 대상이 아닙니다. "
     "세액공제는 본인이 추가로 납입한 금액에만 적용됩니다."),
    (("ISA", "isa", "만기전환", "만기 전환"),
     "- ISA 만기자금을 연금계좌로 전환한 금액은 '일반 납입 한도(연금저축 600만원 / 합산 "
     "900만원)와 별도로' 전환금액의 10%(최대 300만원)가 세액공제 대상에 더해진다. "
     "한도 안의 남은 자리를 채우는 것이 아니라 한도 밖에 추가되는 것이므로, "
     "'남은 한도만큼 공제된다'는 식으로 설명하면 안 된다.",
     ("별도",),
     "ISA 만기 전환금에 대한 추가 공제(전환금액의 10%, 최대 300만원)는 일반 납입 한도와 "
     "별도로 더해집니다. 한도 안의 남은 자리를 채우는 것이 아닙니다."),
]


def deduction_scope_card(question):
    """세액공제 '대상이 아닌 돈'이 섞였는지 판정하고 규칙 카드를 만든다.
    반환: (카드 문자열, 적용된 규칙 목록)"""
    # v9.87: 사정 문장("회사가 DC형인데요")의 낱말이 카드를 발동시키면
    #   무관한 질문에 세액공제 문단이 붙는다 — 세금·공제·계산 문맥이 있어야 한다.
    if not re.search(r"세액|공제|세금|과세|얼마|계산|환급|돌려받|아끼|절세", question):
        return None
    rules = [r for r in _SCOPE_RULES if any(k in question for k in r[0])]
    if not rules:
        return None
    return ("[세액공제 대상 판정 — 이 질문에는 '공제 대상이 아닌 돈'이 섞여 있다]\n"
            + "\n".join(r[1] for r in rules)
            + "\n- 따라서 금액을 단순히 모두 더해서 계산하지 마라. 먼저 본인이 납입한 "
              "금액만 골라낸 뒤, 연금저축 단독은 600만원 / 연금저축+IRP 합산은 900만원 "
              "한도를 적용해 계산하라.\n"
              "- 제외되는 금액은 '왜 제외되는지' 이유를 정확히 밝혀라."), rules


# ── v9.41: ISA 만기 전환금 — 대상 '총액'을 코드가 계산해 명시한다 ──────────
#   실측 R42: 600·300은 말하면서 총액 900만원을 빠뜨리는 일이 반복됐다.
#   "틀리지는 않았지만 덜 자세한" 답도 결함이다. 총액은 조건 없이 코드가 만든다.
_AMT_MAN = re.compile(r"(\d[\d,]*)\s*만\s*원")
_ISA_KEYS = ("ISA", "isa", "만기전환", "만기 전환")


def _man(v):
    return f"{int(v):,}" if abs(v - int(v)) < 1e-9 else f"{v:,.1f}"


def isa_summary_line(question):
    """ISA 전환금이 섞인 질문에서 '세액공제 대상 납입액 총액'을 계산해 한 문장으로.
    금액을 찾지 못하면 None (없는 숫자를 지어내지 않는다)."""
    if not any(k in question for k in _ISA_KEYS):
        return None
    q = re.sub(r"(?<=\d),(?=\d)", "", question)          # 3,000 → 3000 (쉼표 분리 방지)
    isa_amt, own = None, []
    for c in re.split(r"[.,\n]|그리고|하고요|했고요|했고|하고", q):
        amts = [float(a.replace(",", "")) for a in _AMT_MAN.findall(c)]
        if not amts:
            continue
        if any(k in c for k in ("ISA", "isa", "만기")):
            if isa_amt is None:
                isa_amt = max(amts)
        elif any(k in c for k in ("납입", "넣", "불입", "저축", "냈", "낸", "적립")):
            own.extend(amts)
    if isa_amt is None:
        return None
    limit, label = pension_limit(question)
    own_sum = sum(own)
    own_cnt = min(own_sum, limit)
    extra = min(isa_amt * 0.10, 300)
    if own:
        head = (f"본인이 납입한 {_man(own_sum)}만원 중 {label} 한도 {limit}만원까지인 "
                f"{_man(own_cnt)}만원" if own_sum > limit
                else f"본인이 납입한 {_man(own_sum)}만원({label} 한도 {limit}만원 이내)")
    else:
        head = f"본인 납입분({label} 한도 {limit}만원)"
    return ("정리하면, " + head +
            f"에 더해 ISA 만기자금 {_man(isa_amt)}만원의 10%인 {_man(extra)}만원"
            "(최대 300만원)이 일반 납입 한도와 별도로 추가되어, 세액공제 대상 납입액은 "
            f"총 {_man(own_cnt + extra)}만원입니다. 이 추가분은 한도 안의 남은 자리를 "
            "채우는 것이 아니라 한도 밖에 더해집니다.")


# ── v9.41: 비교표 항목 보강 ────────────────────────────────────────────
#   실측 R14: 표는 만들어지는데 비교 항목이 한둘 빠져 '덜 자세한' 답이 된다.
#   재생성(LLM)에 맡기면 확률적이므로, 빠진 줄은 코드가 '자료 없음'으로 채운다.
#   (없는 정보를 지어내는 것이 아니라, 비교 축을 드러내고 한계를 밝히는 것이다)
# v9.97: 주최 안내 — 투자설명서 데이터는 "상품분류(자산유형)·위험등급·판매
#   클래스·총보수·수익률·시장잔고" 여섯 축으로 구분된다. 비교 축을 이 여섯을
#   앞세워 재구성한다 (각 항목의 첫 키워드는 '라벨형' — 전치 감지에 쓴다).
_CMP_ITEMS = [
    ("상품분류(자산유형)", ("상품분류", "자산유형", "자산 유형", "주식형", "채권형",
                            "혼합형", "재간접")),
    ("위험등급",       ("위험등급", "위험 등급", "위험도", "투자위험", "위험 수준")),
    ("판매 클래스",    ("판매 클래스", "클래스", "종류형", "수수료선취", "수수료미징구")),
    ("수수료·보수",    ("수수료", "보수", "비용")),
    ("수익률",         ("수익률", "운용실적", "성과")),
    ("시장잔고",       ("시장잔고", "설정액", "순자산", "잔고")),
    ("투자 대상·전략", ("투자대상", "투자 대상", "투자전략", "투자 전략",
                        "운용전략", "운용 전략", "주요 투자", "편입")),
    ("투자 기간·만기", ("투자기간", "투자 기간", "만기", "존속", "권장", "듀레이션",
                        "가입기간", "가입 기간")),
    ("세제 혜택",      ("세제", "세액공제", "절세", "과세", "세금")),
    ("유의사항",       ("유의", "주의", "리스크", "손실", "위험 요인")),
]
_CMP_FOOT = ("※ '자료 없음'으로 표시된 항목은 제공된 문서에서 확인되지 않아 "
             "비교할 수 없는 내용입니다.")

# v9.99o: 카테고리/유형 비교표의 칸 오배치 교정 (실측 C13·C14·M17).
#   유형 비교(안정형 vs 공격형, 원리금보장 vs 실적배당 등)에서는 상품분류·판매
#   클래스에 실제 값이 없어, 모델이 옆칸 내용(위험 설명·성향 설명)으로 칸을 채운다.
#   → '상품분류' 칸의 위험등급 값, '판매클래스' 칸의 성향 설명만 '자료 없음'으로
#   바로잡는다. 정상 상품표(상품분류=채권형, 판매클래스=종류A/C-P)는 내용 패턴이
#   맞지 않아 절대 건드리지 않는다(가드: _ASSET, _CLASSVAL).
_MISLBL_RISK = re.compile(r"[1-6]\s*등급|(?:매우|다소)?\s*(?:낮|높|보통)은?\s*위험|"
                          r"초저위험|저위험|중위험|고위험")
_MISLBL_ASSET = re.compile(r"주식형|채권형|혼합형|주식\s*혼합|채권\s*혼합|재간접|예금|"
                           r"정기예금|TDF|리츠|MMF|MMDA|원리금|국공채|회사채|국채|"
                           r"단기|장기|실적배당|증권집합투자|투자신탁|어음|MP")
_MISLBL_PROPEN = re.compile(r"투자자에게\s*적합|투자\s*성향|안정성을?\s*추구|"
                            r"공격적인?\s*투자|추구하는\s*투자자|선호하는\s*투자자|"
                            r"맞춰\s*제공|성향에\s*맞|안정형|안정추구형|성장형|공격형|"
                            r"중심의?\s*클래스|수익을?\s*추구|보호\s*중심|위험을?\s*선호")
_MISLBL_CLASS = re.compile(r"종류\s*[A-Za-z]|Class\s*[A-Za-z]|클래스\s*[A-Za-z]|"
                           r"[A-Za-z]-[A-Za-z0-9]|A-e|C-P|C-F|S-P|다양\s*[(（]")


def fix_cell_mislabel(ans):
    """비교표에서 상품분류·판매클래스 칸의 명백한 오배치만 '자료 없음'으로. → (답변, 건수)"""
    out, n = [], 0
    for ln in ans.splitlines():
        s = ln.strip()
        if s.startswith("|") and s.count("|") >= 3 and "---" not in s:
            cells = [c.strip() for c in s.strip("|").split("|")]
            label = cells[0]
            changed = False
            if re.search(r"상품\s*분류|자산\s*유형", label):
                for i in range(1, len(cells)):
                    if _MISLBL_RISK.search(cells[i]) and not _MISLBL_ASSET.search(cells[i]):
                        cells[i] = "자료 없음"
                        n += 1
                        changed = True
            elif re.search(r"판매\s*클래스", label):
                for i in range(1, len(cells)):
                    if _MISLBL_PROPEN.search(cells[i]) and not _MISLBL_CLASS.search(cells[i]):
                        cells[i] = "자료 없음"
                        n += 1
                        changed = True
            if changed:
                ln = "| " + " | ".join(cells) + " |"
        out.append(ln)
    return "\n".join(out), n


# v9.99p: 추천 답변에서 문서에 없는 개별 종목(ETF 등)을 지어내는 것을 코드로 막는다
#   (실측 R06: '종목 5가지 리스트' 요구에 KODEX·ARIRANG·KBSTAR 등 문서 밖 ETF 창작).
#   ETF 브랜드가 붙은 상품명이 검색된 문서(context)에 없으면 그 항목 줄과 하위
#   불릿을 통째로 제거하고, 제외 고지를 붙인다. 문서에 실재하는 상품은 보존.
_ETF_BRAND = re.compile(r"KODEX|KBSTAR|ARIRANG|HANARO|KOSEF|KINDEX|TIGER|"
                        r"TIMEFOLIO|KoAct|KODAA", re.I)


def strip_unbacked_etf(ans, context):
    """문서에 없는 ETF/종목명 항목을 제거한다. → (답변, 제거 개수)"""
    ctx = re.sub(r"\s", "", context)
    lines = ans.splitlines()
    out, n, i = [], 0, 0
    while i < len(lines):
        ln = lines[i]
        name, looks_product = "", False
        # ① 번호 목록 + 굵은 상품명 (브랜드 무관 — ARKK·피델리티 등 해외/타사도 검사)
        mb = re.match(r"\s*\d+[.)]\s*\*\*(.+?)\*\*", ln)
        if mb:
            name = re.sub(r"[\s*]", "", mb.group(1))
            looks_product = bool(_ETF_BRAND.search(name)
                                 or re.search(r"ETF|펀드|신탁|리츠|[A-Z]{3,}", name))
        else:
            # ② 굵은 표시 없이 한국 ETF 브랜드가 든 목록 항목
            m = _ETF_BRAND.search(ln)
            if m and re.match(r"\s*(?:\d+[.)]|[-*•])", ln):
                nm = re.search(_ETF_BRAND.pattern + r"[\w가-힣&()·\-+ ]{1,30}", ln, re.I)
                name = re.sub(r"[\s*]", "", nm.group(0)) if nm else ""
                looks_product = True
        # 상품명처럼 보이는데 문서(context)에 그 이름이 없으면 창작으로 보고 제거
        if looks_product and name and name not in ctx:
            n += 1
            i += 1
            while i < len(lines) and re.match(r"\s+[-*•]", lines[i]):
                i += 1
            continue
        out.append(ln)
        i += 1
    res = "\n".join(out)
    if n:
        res = _renumber_items(res)
    return res, n


def _renumber_items(text):
    """항목 제거로 번호가 튄 것(1,3,4)을 연속으로 다시 매긴다. 문단이 나오면 리셋."""
    out, cnt = [], 1
    for ln in text.splitlines():
        m = re.match(r"^(\s*)(\d+)([.)])(.*)$", ln)
        if m:
            out.append(f"{m.group(1)}{cnt}{m.group(3)}{m.group(4)}")
            cnt += 1
        else:
            # 서브불릿·빈줄·표가 아닌 '문단'을 만나면 다음 목록을 위해 카운터 리셋
            if ln.strip() and not re.match(r"^\s*[-*•]", ln) and "|" not in ln:
                cnt = 1
            out.append(ln)
    return "\n".join(out)


def ensure_compare_rows(ans):
    """비교표에서 빠진 비교 항목을 '자료 없음' 줄로 채운다. → (답변, 추가 개수)"""
    lines = ans.splitlines()
    idx = [i for i, ln in enumerate(lines) if ln.count("|") >= 2]
    if len(idx) < 3:
        return ans, 0
    start, end = idx[0], idx[-1]
    if end - start + 1 != len(idx):          # 표가 끊겨 있으면 손대지 않는다
        return ans, 0
    header = lines[start]
    ncol = (header.count("|") - 1) if header.strip().startswith("|") else (header.count("|") + 1)
    if ncol < 3 or ncol > 8:
        return ans, 0
    # 전치형(열 = 비교항목)이면 줄을 더하면 안 된다
    # v9.97: 판정은 각 항목의 '라벨형' 키워드(앞 2개)로만 — '주식형/채권형' 같은
    #   내용어는 상품명에도 들어 있어 머리글을 전치형으로 오인시킨다
    if sum(1 for _n, kws in _CMP_ITEMS if any(k in header for k in kws[:2])) >= 2:
        return ans, 0
    # v9.97: 머리글(상품명)은 빼고 본문 행에서만 찾는다 — 상품명 속
    #   '주식형' 같은 단어가 '상품분류 행이 이미 있다'로 오인되는 것 방지
    body = "\n".join(lines[start + 1:end + 1])
    missing = [n for n, kws in _CMP_ITEMS if not any(k in body for k in kws)]
    if not missing:
        return ans, 0
    lines[end + 1:end + 1] = ["| " + n + " |" + " 자료 없음 |" * (ncol - 1) for n in missing]
    return "\n".join(lines), len(missing)


def ensure_noinfo_footnote(ans):
    """v9.59: 표에 '자료 없음' 칸이 있으면 그 뜻을 밝히는 각주를 붙인다.
    v9.41에서는 '코드가 행을 추가했을 때'에만 붙여, 모델이 스스로 자료 없음을
    쓴 경우 각주가 빠졌다(R44). 판정 기준은 '누가 썼는가'가 아니라
    '표에 자료 없음이 있는가'여야 한다."""
    has = any(ln.count("|") >= 2 and "자료 없음" in ln for ln in ans.splitlines())
    if not has or _CMP_FOOT in ans:
        return ans, 0
    return ans.rstrip() + "\n\n" + _CMP_FOOT, 1



# ── v9.43: 위험등급 — 근거는 '모델이 만든 표'가 아니라 투자설명서 원문이다 ──────
#   v9.42는 답변의 표에서 등급을 읽었다. 그런데 표는 모델이 만든 물건이라, 문서의
#   '위험등급 변경[5등급→4등급]' 이력에서 과거 등급을 끌어와 현재 등급 자리에 넣는
#   일이 실행마다 다른 열에서 벌어졌다. 표를 믿은 코드는 틀린 결론을 확신 있게 냈다.
#   → 등급은 원문의 '투자위험등급 N등급[라벨]' 표기에서만 읽는다. 이력은 배제한다.
# 등급 표기는 운용사마다 다르다. 우선순위대로 읽되, '분류기준 표'와 '변경 이력'은 배제한다.
_GRADE_PATS = [
    # ① 투자위험등급 5등급[낮은 위험] / 투자 위험 등급 5등급 (낮은 위험)
    re.compile(r"투자\s*위험\s*등급\s*([1-6])\s*등급\s*[\[(]\s*([가-힣\s]{2,10}위험)\s*[\])]"),
    # ② 투자 위험 등급 6등급   (라벨 없음)
    re.compile(r"투자\s*위험\s*등급\s*([1-6])\s*등급()"),
    # ③ …감안하여 6등급으로 분류하였습니다
    re.compile(r"감안\s*하\s*여\s*([1-6])\s*등급\s*으?로\s*분류()"),
    # ④ 6등급 중 6등급(매우 낮은 위험)에 해당
    re.compile(r"6\s*등급\s*중\s*([1-6])\s*등급\s*\(?\s*([가-힣\s]{2,10}위험)?"),
    # ⑤ 6개의 투자위험등급 중 위험도가 낮은 5등급으로 분류됩니다
    re.compile(r"투자위험등급\s*중[^.]{0,30}?([1-6])\s*등급()"),
]
# 이 단어가 앞쪽 창에 있으면 그 숫자는 '현재 등급'이 아니다 (분류기준 표 / 변경 이력)
_GRADE_TRAP = ("변경전", "변경후", "변경사유", "변경 사유", "분류기준", "분류 기준",
               "분류체계", "개편", "산정기준", "의미 유의사항")
# v9.46: 답변에 붙는 표식. 코드가 소유하고 테스트는 이 값을 읽어간다.
RISK_CARD_MARK = "[위험등급 정리"
# v9.74: '원문에서 확인한 등급 정리'와 '원문과 대조하지 못했다는 경고'는
#   전혀 다른 사실이다. 같은 표식을 쓰면 한쪽을 막는 규칙이 다른 쪽까지 막는다.
RISK_WARN_MARK = "[위험등급 원문 대조"
_LABEL_BY_GRADE = {1: "매우 높은 위험", 2: "높은 위험", 3: "다소 높은 위험",
                   4: "보통 위험", 5: "낮은 위험", 6: "매우 낮은 위험"}
# 변동성은 척도가 문서마다 다르다 → 값과 '척도 이름'을 함께 들고 다닌다
_VOL_PATS = [
    (re.compile(r"변동성\s*\(?\s*97\.5%\s*VaR\s*\)?\s*은?\s*([\d.]+)\s*%"),
     "3년 97.5% VaR"),
    (re.compile(r"최대손실예상액\s*\(\s*VaR\s*\)\s*이\s*([\d.]+)\s*%"),
     "3년 일간수익률 최대손실예상액(VaR)"),
    (re.compile(r"수익률\s*변동성이\s*([\d.]+)\s*%"), "수익률 변동성"),
]


def _read_name(text):
    """상품(펀드) 이름을 읽는다. 표기 형식이 운용사마다 달라 여러 단서를 쓴다."""
    cands = []
    for mark in _NAME_MARKS:
        m = mark.search(text)
        if not m:
            continue
        seg = text[max(0, m.start() - 80):m.start()]
        seg = _NAME_CUT.split(seg)[-1]
        seg = _NAME_TAIL.sub("", seg).strip(" .:·-")
        seg = re.sub(r"\s{2,}", " ", seg)
        if 4 <= len(seg) <= 60 and ("투자신탁" in seg or "펀드" in seg or "증권" in seg):
            cands.append(seg)
    m = _FUND_NAME.search(text)
    if m:
        nm = re.sub(r"\s{2,}", " ", m.group(1).strip(" .:·-"))
        if 4 <= len(nm) <= 60:
            cands.append(nm)
    m2 = re.search(r"([가-힣A-Za-z0-9]+증권자?투자신탁[^\s]{0,20})", text)
    if m2:
        cands.append(m2.group(1))
    return cands[0] if cands else None


def _read_grade(text):
    """문서 전체에서 '현재 위험등급'을 읽는다. → (등급, 라벨) 또는 (None, None)"""
    for pat in _GRADE_PATS:
        for m in pat.finditer(text):
            win = text[max(0, m.start() - 70):m.start()]
            if any(w in win for w in _GRADE_TRAP):
                continue
            if "→" in text[m.start():m.end() + 20]:
                continue
            g = int(m.group(1))
            lab = (m.group(2) or "").strip()
            lab = re.sub(r"\s+", " ", lab)
            if not lab and "매우 낮은 위험" in text and "매우 높은 위험" in text:
                lab = _LABEL_BY_GRADE[g]      # 문서가 6단계 척도를 싣고 있을 때만
            return g, (lab or None)
    return None, None


def _read_vol(text):
    """변동성을 읽되 '어느 척도인지'를 함께 반환한다. → (값, 척도) 또는 (None, None)"""
    for pat, kind in _VOL_PATS:
        m = pat.search(text)
        if m:
            try:
                return float(m.group(1)), kind
            except ValueError:
                pass
    return None, None


# v9.47: 이름은 '펀드코드'·'<요약정보>' 표기 바로 앞에 온다. 그 지점에서 되짚는다.
#   ('집합투자기구 명칭' 뒤 형식이 운용사마다 달라 ':' 만 잡히던 문제)
_NAME_MARKS = [re.compile(r"[\[(]\s*펀드\s*코드"),
               re.compile(r"<\s*요약정보\s*>"),
               re.compile(r"투자\s*위험\s*등급")]
_NAME_CUT = re.compile(r"\n|\d{4}\.\s?\d{1,2}\.\s?\d{1,2}\.?|-\s*\d+\s*-"
                       r"|\(\s*작성기준일[^)]*\)|작성기준일\s*[:：]")
_NAME_TAIL = re.compile(r"[\s(\[]*\d{4,6}[)\]]?\s*$")
_FUND_NAME = re.compile(r"집합투자기구\s*명칭\s*[:：]?\s*([^\n]{3,58}?)\s*"
                        r"(?:\d+\s*[.)]\s*)?집합투자업자")
_CTX_HEAD = re.compile(r"\[문서\d+\]\s*\(출처:\s*([^)]+)\)")


def _cells(line):
    """마크다운 표의 한 줄을 칸 목록으로 (강조 기호 제거)"""
    c = [x.strip() for x in line.strip().strip("|").split("|")]
    return [re.sub(r"[*_`]", "", x).strip() for x in c]


# ── v9.63: OCR 품질 ─────────────────────────────────────────────────
#   스캔 PDF에서 뽑힌 청크는 문장이 끊기고 글자가 깨져 있다. 그런 근거를 그대로
#   주면 모델이 조각을 이어 붙여 없는 사실을 만든다(실측: 예약주문 시간 → 미수 방지).
#   정상 한국어 문장에서는 거의 나오지 않는 신호만 센다.
# v9.83: ∙는 '총보수∙비용' 등 정상 표기에 흔하다 — 목록에서 뺀다
_ODD_CHAR = re.compile(r"[『』〔〕｢｣＠＃＄％＆￥◇◆■□▲▼¨′″]")
_JAMO = re.compile(r"[ㄱ-ㅎㅏ-ㅣ]")
_NUMRUN = re.compile(r"(?:(?<=\s)|^)\d{3,}(?:\s+\d{3,}){2,}")
_ASCII_JUNK = re.compile(r"[a-zA-Z]\d{4,}|\d{4,}[a-zA-Z]")
_OK1 = set("연년월일시분초총약각및등내외전후중상하대소만원수개건차명색점"
           "그이저것수때곳말일법식형기수액율률비용상한액표주식채권형"
           "제첫두별낸못더")   # v9.77: 법조문의 '제 N조', '첫/두 번째' 등
_LONE1 = re.compile(r"(?<!\S)([가-힣])(?!\S)")
GARBLE_WARN = 0.30          # 이 점수 이상이면 '깨진 근거'로 본다 (생성 주의 카드용)
# v9.66: 기한 블록은 문장이 사용자에게 그대로 나가므로 더 엄격하게 본다.
#   실측 #5는 0.25였는데 "11103@56「08.01.1", "ㅁ0-5일까지는"이 그대로 노출됐다.
GARBLE_STRICT = 0.15


def garble_score(t):
    """0(깨끗)~1(심하게 깨짐)."""
    # v9.89: 줄 머리의 목록 기호(■ □ ● 등)는 정상 문서 표기다. 떼고 잰다.
    t = re.sub(r"(?m)^\s*[■□◆◇●○▶▷▪·•*-]+\s*", "", t)
    n = max(len(t), 1)
    w = max(len(t.split()), 1)
    lone_bad = sum(1 for c in _LONE1.findall(t) if c not in _OK1)
    s = 0.0
    s += min(len(_ODD_CHAR.findall(t)) / n * 60, 0.30)
    s += min(len(_JAMO.findall(t)) / n * 80, 0.25)
    # v9.75: 한 글자 단어('낸','별','두','수')는 정상 한국어에 흔하다. 한두 개로는
    #   깨졌다고 볼 수 없다 — 깨진 원문은 홑글자가 무더기로 나온다. 3개째부터 센다.
    s += min(max(lone_bad - 2, 0) / w * 3.0, 0.25)
    s += min(len(_NUMRUN.findall(t)) * 0.12, 0.24)
    s += min(len(_ASCII_JUNK.findall(t)) * 0.04, 0.12)
    return round(min(s, 1.0), 3)


OCR_CARD = (
    "[원문 인식 주의 — 아래 참고 문서 중 일부는 스캔 문서에서 자동 추출되어 "
    "문장이 끊기거나 글자가 깨져 있다]\n"
    "- 끊긴 조각을 이어 붙여 인과관계를 만들지 마라. 예: 어떤 시간대가 적혀 있다고 해서 "
    "'그 시간에 하면 ~가 된다'고 결론짓지 마라.\n"
    "- 깨진 부분에서 의미를 추측하지 마라. 다만 **온전히 읽히는 문장이 하나라도 있으면 "
    "그 내용은 반드시 답변에 활용해라.** 글자가 깨진 곳이 섞여 있다는 이유로 답변을 "
    "포기하지 마라 — 읽히는 만큼은 답하고, 확인되지 않는 부분만 따로 밝혀라."
)



def _src_text(source):
    """v9.44: 그 문서(출처)의 모든 청크를 이어붙인다 — 검색 결과에 없어도 찾기 위해."""
    return "\n".join(c["text"] for c in chunks if c["source"] == source)


# v9.52: 상품을 '구분'하는 데 쓸모없는 부분 — 운용사명·법적 형태·괄호
_GENERIC = re.compile(
    r"미래에셋|삼성|한국투자|한국|하나|신한|KB|국민|우리|키움|NH|농협|교보|흥국|IBK|"
    r"DB|메리츠|유진|이스트스프링|맥쿼리|타임폴리오|브이아이|다올|에셋플러스|"
    r"자산운용(?:주식회사)?|주식회사|㈜|"
    r"증권자?투자신탁|자투자신탁|투자신탁|모투자신탁|증권투자|"
    r"제?\d+호|\([^)]*\)|\[[^\]]*\]|전환형|재간접형?|혼합자산|"
    r"[·\s\-]")


def _key_name(name):
    """구분에 쓸모있는 부분만 남긴다 (미래에셋솔로몬단기국공채증권자투자신탁1호(채권)
    → 솔로몬단기국공채)"""
    k = _GENERIC.sub("", name)
    return k if len(k) >= 3 else name


def _fund_labels(names):
    """상품명들에서 서로 구분되는 짧은 이름을 만든다.
    (미래에셋솔로몬장기국공채증권자투자신탁1호(채권) → 장기국공채)"""
    if not names:
        return {}
    pre = names[0]
    for n in names[1:]:
        while pre and not n.startswith(pre):
            pre = pre[:-1]
    out = {}
    for n in names:
        rest = n[len(pre):] if pre and len(pre) < len(n) else n
        lab = re.split(r"증권\s*자?투자신탁|자투자신탁|투자신탁|증권투자", rest)[0]
        lab = re.sub(r"\s*자$", "", lab).strip(" ·-")
        out[n] = lab if len(lab) >= 2 else n
    return out


def extract_risk_profile(sources):
    """v9.44: 출처 목록을 받아, 각 문서의 '전체 청크'에서
    (상품명, 현재 위험등급, 라벨, 3년 변동성)을 읽는다.
    등급은 '투자위험등급 N등급[라벨]' 표기에서만 읽고 변경 이력은 배제한다."""
    prof = {}
    for src in sources:
        text = _src_text(src)
        if not text:
            continue
        name = _read_name(text)
        if not name or name in prof:
            continue
        grade, label = _read_grade(text)
        if grade is None:
            continue
        vol, vkind = _read_vol(text)
        prof[name] = {"grade": grade, "label": label, "src": src,
                      "vol": vol, "vkind": vkind}
    labs = _fund_labels(list(prof.keys()))
    for n, r in prof.items():
        r["short"] = labs.get(n, n)
    return prof


def _risk_lines(prof):
    items = sorted(prof.items(), key=lambda kv: (-kv[1]["grade"], kv[1]["short"]))
    grades = " / ".join(
        f"{r['short']} {r['grade']}등급" + (f"[{r['label']}]" if r["label"] else "")
        for _n, r in items)
    kinds = {r["vkind"] for _n, r in items if r["vol"] is not None}
    if len(kinds) == 1:      # v9.45: 척도가 섞이면 비교하지 않는다
        vols = [(r["short"], f"{r['vol']:.2f}") for _n, r in items if r["vol"] is not None]
        vkind = kinds.pop()
    else:
        vols, vkind = [], None
    return grades, sorted(vols, key=lambda x: float(x[1])), vkind


def risk_truth_card(prof):
    """생성 전에 프롬프트로 못박는 카드 — 등급을 지어내거나 이력을 끌어오지 못하게."""
    if len(prof) < 2:
        return None
    grades, vols, vkind = _risk_lines(prof)
    same = len({r["grade"] for r in prof.values()}) == 1
    card = ["[위험등급 — 투자설명서 원문 기준. 이 값을 그대로 쓰고 다른 값을 만들지 마라]",
            "- 현재 위험등급: " + grades,
            "- 문서에 있는 '위험등급 변경[A→B]'은 과거 이력이다. 그 안의 숫자를 "
            "현재 등급으로 쓰지 마라."]
    if same:
        card.append("- 세 상품의 위험등급은 서로 같다. '등급이 낮은 상품'이라는 식으로 "
                    "등급으로 우열을 가리지 마라.")
    if len(vols) >= 2:
        card.append(f"- 문서에 적힌 변동성 지표({vkind}): "
                    + " / ".join(f"{n} {v}%" for n, v in vols)
                    + f" → 등급이 같아도 변동성은 다르며, 표기상 가장 낮은 것은 '{vols[0][0]}'이다.")
    return "\n".join(card)


# ── v9.72: 표의 열 이름 ↔ 문서의 상품명 잇기 ────────────────────────
#   모델이 만든 표 헤더는 문서의 정식 명칭과 다르다(띄어쓰기·축약·법적형태 생략).
#   실측 R44: 표 '미래에셋 코어밸류 연금저축증권전환형'
#             문서 '미래에셋코어밸류연금저축증권전환형자투자신탁1호(주식)'
#   → 양쪽을 같은 규칙(_GENERIC 제거 = 운용사·법적형태·괄호·공백 삭제)으로
#     정규화한 뒤 포함 관계를 본다. 후보가 둘 이상이면 찍지 않고 포기한다.
# v9.85: 열 이름 정규화는 '미래에셋'만 지운다. 타사 브랜드(삼성·한국 등)는
#   그 열이 다른 회사 상품이라는 결정적 정보라 지우면 안 된다.
#   (실측: '삼성 한국형TDF2045' → _GENERIC이 삼성·한국까지 지워 '형TDF2045'가 되고
#    문서 상품 'TDF2045'와 부분 일치해버렸다)
_GENERIC_H = re.compile(
    r"미래에셋|자산운용(?:주식회사)?|주식회사|㈜|"
    r"증권자?투자신탁|자투자신탁|투자신탁|모투자신탁|증권투자|"
    r"제?\d+호|\([^)]*\)|\[[^\]]*\]|전환형|재간접형?|혼합자산|"
    r"[·\s\-]")


# v9.85: 코퍼스는 미래에셋 상품뿐이다. 열 이름에 타사 브랜드가 보이면
#   그 열은 우리 문서로 검증할 수 없는 상품이다 — 어떤 연결도 하지 않는다.
#   (bare '우리·하나·DB'는 일반 단어와 겹쳐서 뺐다)
_OTHER_BRAND = re.compile(
    r"삼성|신한|한화|KB|국민은행|우리은행|우리자산|하나은행|하나UBS|키움|"
    r"NH|농협|교보|흥국|IBK|메리츠|유진|한국투자|한국형|피델리티|슈로더|"
    r"맥쿼리|이스트스프링|타임폴리오|에셋플러스|다올|브이아이|미즈호|블랙록|뱅가드")


def _match_col(h, prof):
    """표 열 이름 h가 가리키는 상품 → (상품명, 정보) 또는 (None, None)"""
    if _OTHER_BRAND.search(h or ""):
        return None, None
    hk = _GENERIC_H.sub("", h or "")
    if len(hk) < 3:
        return None, None
    cand = []
    for name, r in prof.items():
        nk = _GENERIC.sub("", name)
        if len(nk) < 3:
            continue
        if nk == hk:
            return name, r
        if nk in hk:
            # v9.85: 열 이름에 상품키에 없는 한글 수식어가 3자 이상 남으면
            #   (예: '한국형TDF2045'에서 'TDF2045'를 빼면 '한국형') 다른 상품이다.
            if len(re.findall(r"[가-힣]", hk.replace(nk, ""))) >= 3:
                continue
            cand.append((name, r))
        elif hk in nk:
            cand.append((name, r))
    if len(cand) == 1:
        return cand[0]
    if cand:
        return None, None          # 어느 쪽인지 모호하면 손대지 않는다
    # 복합어라 부분 문자열로 안 걸릴 때 — 검색과 같은 바이그램 겹침.
    #   단, 같은 계열 상품은 '연금저축증권' 같은 조각을 공유한다. 겹친 개수만
    #   보면 '고배당포커스' 열이 '코어밸류' 상품에 붙는다(실측). 그래서
    #   그 상품 이름의 몇 할이 겹쳤는지(비율)를 함께 본다.
    ht = {g for g in _tok(h) if len(g) == 2}
    best, second, hit = 0.0, 0.0, (None, None)
    for name, r in prof.items():
        g = {x for x in _tok(_key_name(name)) if len(x) == 2}
        if len(g) < 3:
            continue
        ov = len(g & ht)
        sc = ov / len(g) if ov >= 3 else 0.0
        if sc > best:
            best, second, hit = sc, best, (name, r)
        elif sc > second:
            second = sc
    if best >= 0.6 and best > second:
        # v9.85: 바이그램 경로도 같은 검사 — 열 이름에 상품키에 없는 한글
        #   수식어가 3자 이상 남으면(예: '한국형') 다른 상품이다.
        _hn = _GENERIC.sub("", hit[0] or "")
        if _hn and _hn in hk \
                and len(re.findall(r"[가-힣]", hk.replace(_hn, ""))) >= 3:
            return None, None
        return hit
    return None, None


# ── v9.77: 표 행 정렬 ────────────────────────────────────────────────
#   실측 5건: 생성 중 줄바꿈이 사라져 여러 행이 한 줄에 붙고 마지막 '|'가 떨어졌다.
#   "| 주요 투자 비중 | 주식 70% | 채권 95% | 비교지수 | 어려움 | KOBI 120 x 100"
#   표가 깨지면 화면 전체가 깨져 보인다 — 머리글 칸수를 기준으로 코드가 다시 편다.
def fix_table_rows(ans):
    """머리글 칸수(H) 기준: 칸이 넘치면 H개씩 잘라 여러 행으로, 모자라면
    '자료 없음'으로 채운다. → (답변, 고친 행수)"""
    lines = ans.splitlines()
    idx = [i for i, ln in enumerate(lines) if ln.count("|") >= 2]
    if len(idx) < 2:
        return ans, 0
    head_i = idx[0]
    H = len(_cells(lines[head_i]))
    if H < 2:
        return ans, 0
    n, out = 0, []

    def _row(cs):
        return "| " + " | ".join(cs) + " |"

    for i, ln in enumerate(lines):
        if ln.count("|") < 2:
            out.append(ln)
            continue
        # v9.86: 글자 사이에 낀 |는 구분선이 아니라 내용이다 ("주식|채권").
        #   공백 있는 구분선(" | ")이 있는 줄에서만 적용 — 전부 붙여 쓴
        #   표("|구분|A|")까지 건드리면 표를 부순다.
        if " | " in ln and not re.fullmatch(r"[\s|:\-–—]+", ln):
            _ln2 = re.sub(r"(?<=[^\s|])\|(?=[^\s|])", "/", ln)
            if _ln2 != ln:
                n += 1
                ln = _ln2
        # v9.79: 모든 표 줄을 규격으로 다시 쓴다. 칸 수가 맞아도 끝 '|'가 빠진
        #   행이 있었다(실측 R27·R45) — 조건부로 고치면 반드시 새는 곳이 생긴다.
        if re.fullmatch(r"[\s|:\-–—]+", ln):        # 구분선
            if len(_cells(ln)) != H:
                n += 1
            out.append(_row(["---"] * H))
            continue
        cells = _cells(ln)
        # v9.93: 빈 칸은 '자료 없음'으로 채운다 (실측 R45y — '주요 투자 비중'
        #   행이 '| | | |'로 나갔다). 행 보강은 빠진 '행'만 채워서 기존 행의
        #   빈 '칸'은 그대로 새고 있었다. 머리글 행은 건드리지 않는다.
        if i != head_i:
            _filled = [c if c else _NOINFO_CELL for c in cells]
            if _filled != cells:
                n += 1
                cells = _filled
        if i == head_i or len(cells) == H:
            out.append(_row(cells))
            continue
        n += 1
        if len(cells) > H:                           # 붙은 행 → H개씩 편다
            for j in range(0, len(cells), H):
                chunk = cells[j:j + H]
                chunk += [_NOINFO_CELL] * (H - len(chunk))
                out.append(_row(chunk))
        else:                                        # 모자란 행 → 자료 없음으로
            cells += [_NOINFO_CELL] * (H - len(cells))
            out.append(_row(cells))
    return "\n".join(out), n


# ── v9.93: 수수료 우열 주장 검산 ─────────────────────────────────────
#   실측 R45y: 표에는 단기 0.47% / 중장기 0.46% / 장기 0.45%인데 요약이
#   "단기가 약간 더 저렴합니다"라고 썼다 — 답변이 제 표와 모순된다.
#   표가 답변 안에 있으므로 코드가 검산할 수 있다(조건은 코드가 계산한 값):
#   주장이 가리키는 상품이 표의 최저가 상품이 아니면 그 문장을 지운다.
#   맞는 주장(진짜 최저가 상품을 지목)은 그대로 둔다 — R27류 '싼 게 뭐야'
#   질문의 정답까지 지우면 안 된다.
_FEE_CLAIM = re.compile(r"(?:더|가장|제일)\s*(?:저렴|싸)")


def fee_claim_check(ans):
    """비교표 수수료 행의 숫자와 어긋나는 우열 주장을 지운다. → (답변, 건수)"""
    lines = ans.splitlines()
    tbl = [ln for ln in lines
           if ln.count("|") >= 2 and not re.fullmatch(r"[\s|:\-–—]+", ln)]
    if len(tbl) < 2:
        return ans, 0
    header = _cells(tbl[0])
    fee_ln = next((ln for ln in tbl[1:]
                   if _cells(ln) and re.search(r"수수료|보수", _cells(ln)[0])), None)
    if fee_ln is None or len(header) < 3:
        return ans, 0
    cells = _cells(fee_ln)
    vals = []
    for c in cells[1:]:
        m = re.search(r"(\d+(?:\.\d+)?)\s*%", c)
        vals.append(float(m.group(1)) if m else None)
    known = [(j, v) for j, v in enumerate(vals) if v is not None]
    if len(known) < 2:
        return ans, 0
    mn = min(v for _, v in known)
    min_cols = {j for j, v in known if abs(v - mn) < 1e-9}
    # 열별 '고유 단어'(다른 열 이름에는 없는 단어)로 주장이 가리키는 열을 판별.
    # 긴 단어부터 대조한다 — '중장기' 안의 '장기'가 먼저 잡히는 오인 방지.
    col_words = []
    for j in range(1, len(header)):
        col_words.append(set(re.findall(r"[가-힣A-Za-z0-9]{2,}", header[j])))
    tokens = []                                     # (단어, 열번호)
    for j, w in enumerate(col_words):
        others = set().union(*(col_words[:j] + col_words[j + 1:]))
        tokens += [(t, j) for t in (w - others)]
    tokens.sort(key=lambda x: -len(x[0]))
    if not tokens:
        return ans, 0
    n, out = 0, []
    for ln in lines:
        if ln.count("|") >= 2:
            out.append(ln)
            continue
        keep = []
        for sent in re.split(r"(?<=[.!?])\s+", ln):
            if _FEE_CLAIM.search(sent) and re.search(r"수수료|보수|저렴|싸", ln):
                claimed = next((j for t, j in tokens if t in sent), None)
                if claimed is not None and claimed not in min_cols:
                    n += 1
                    continue                        # 표와 모순 — 거짓 주장 삭제
            keep.append(sent)
        rest = " ".join(k for k in keep if k.strip()).strip()
        if len(keep) < len(re.split(r"(?<=[.!?])\s+", ln)) and \
                re.fullmatch(r"(?:\d+\.|[-*•])?\s*(?:[*_`]*수수료[^:]{0,10}[*_`]*\s*:?)?",
                             rest):
            continue                                # 라벨만 남은 줄은 통째로 제거
        out.append(" ".join(keep) if keep else "")
    if not n:
        return ans, 0
    return re.sub(r"\n{3,}", "\n\n", "\n".join(out)), n


# ── v9.74: 연금수령 요건 ────────────────────────────────────────────
#   문서(doc39) 기준 요건은 셋이다: 가입기간 5년 이상 / 만 55세 이후 인출 /
#   연간 연금수령한도 이내. 프롬프트로만 못박았더니 회차마다 '55세'가 빠졌다
#   (실측 R25, 1/2회 실패). 문서에 확정적으로 적힌 것은 코드가 붙인다.
#   조건은 '질문'에만 건다 — 답변에 걸면 그 조건 자체가 확률적이 된다(v9.56).
PENSION_REQ_MARK = "[연금수령 요건"
# v9.99d: '연금저축…받', '부어야/채워야 받' 등도 연금수령 요건 질문이다
#   (K27 실측: "10년은 부어야 받는다던데"에 카드가 안 붙어 오답을 창작했다)
_REQ_TOPIC = re.compile(r"연금\s*으?로\s*받|연금\s*수령|연금\s*개시|수령\s*요건|"
                        r"연금\s*으?로\s*전환|연금\s*으?로\s*나눠|"
                        r"연금저축[^.?!\n]{0,40}받|부어야\s*받|채워야\s*받|"
                        r"부어도\s*[^.?!\n]{0,10}받")
_REQ_ASK = re.compile(r"\d\s*년|요건|조건|언제|가능|받을\s*수\s*있|받겠|받는다던|"
                      r"부어야|부어도|채워야|되나|될까|자격|몇\s*년")
# v11.7: 기한 카드는 '기한을 실제로 묻는' 질문에만 붙인다(무관 질문에 붙던 오탐 차단).
_DEADLINE_INTENT = re.compile(r"기한|언제|이내|며칠|몇\s*일|몇\s*개월|데드라인|시점|"
                              r"(?:기간|기일)\s*(?:은|이|내|안|까지)?")


def pension_req_card(question):
    """연금수령 요건을 묻는 질문이면 문서 기준 요건 세 가지를 코드가 붙인다."""
    if not (_REQ_TOPIC.search(question) and _REQ_ASK.search(question)):
        return None
    # v11.7: 세액공제·공제금액 질문 오탐 방지 — 수령/인출/나이 의도가 명확할 때만 부착.
    if re.search(r"세액공제|공제액|공제\s*금액|돌려받|환급", question) \
            and not re.search(r"수령|개시|인출|55세|가입\s*기간|언제부터|몇\s*살", question):
        return None
    return (PENSION_REQ_MARK + " — 문서 기준] 연금으로 수령하려면 "
            "① 연금계좌 가입기간 5년 이상, ② 만 55세 이후 인출, "
            "③ 연간 연금수령한도 이내 인출 — 세 가지를 모두 충족해야 합니다. "
            "여기서 '5년'은 가입기간을 뜻하며, 5년에 걸쳐 나눠 받는다는 의미가 아닙니다. "
            "다만 계좌에 퇴직급여(퇴직금)가 들어 있는 경우에는 "
            "가입기간 5년 요건이 적용되지 않습니다.")


# v9.99e: 문서에 확정된 사실 3종을 질문 조건으로 카드 주입 (2차 사냥 실측).
_WD_TOPIC = re.compile(r"중도\s*인출|미리\s*(?:빼|찾|인출)|55세\s*전|"
                       r"(?:돈|자금)\s*급|급하게\s*돈|잠깐\s*빌|안\s*깨고|"
                       r"(?:못|안)\s*(?:빼|찾|인출)")
_WD_ASK = re.compile(r"IRP|연금|퇴직|빼|인출|찾|빌|가능|되나|없")


# v9.99g: '원금 보장'을 묻는데 대상이 원리금보장상품이 아닌 것(디폴트옵션
#   안정형·실적배당·펀드·ETF·TDF·MP)이면 '보장되지 않는다'가 사실이다.
#   (실측 P16: '디폴트옵션 안정형은 예금이니까 원금 보장되죠?'에 '네'로 오답)
_GUAR_ASK = re.compile(r"원금\s*(?:이|은)?\s*보장|원금\s*보전|손실\s*(?:이)?\s*없|"
                       r"손해\s*(?:는|안|없)|원금\s*안전|무손실")
_NONGUAR = re.compile(r"디폴트\s*옵션|안정형|실적\s*배당|펀드|ETF|TDF|리츠|주식형|"
                      r"채권형|혼합형|MP|포트폴리오")
_GUAR_OK = re.compile(r"정기\s*예금|저축은행\s*예금|원리금\s*보장|GIC|발행어음|"
                      r"이율\s*보증")


def guarantee_card(question):
    """원금 보장을 묻는데 대상이 비보장상품이면 '보장되지 않는다'를 못박는다."""
    if not (_GUAR_ASK.search(question) and _NONGUAR.search(question)):
        return None
    if _GUAR_OK.search(question) and not _NONGUAR.search(question):
        return None
    return ("[원금 보장 여부 — 문서 기준]\n"
            "디폴트옵션 안정형, 실적배당형 상품(펀드·ETF·TDF 등)은 예금과 펀드 "
            "등으로 구성되거나 투자성과에 따라 손익이 갈리므로 '원금이 보장되지 "
            "않는다'. 원금과 이자가 보장되는 것은 정기예금·저축은행예금·GIC 등 "
            "원리금보장상품에 한한다. 실적배당상품은 예금자보호법 대상도 아니다. "
            "질문이 '원금 보장되죠?'라고 단정하더라도 '보장된다'고 답하지 말고, "
            "위 사실대로 바로잡아 답하라.")


# v9.99i: '원금 보장되면서 수익 높은 상품' 같은 양립 불가 조합을 추천 요청하면
#   특정 상품을 단정 추천하지 말고 트레이드오프를 먼저 밝히게 한다 (실측 R07).
_SAFE_W = re.compile(r"원금\s*보장|원금\s*보전|손해\s*(?:절대\s*)?안|"
                     r"손실\s*(?:이\s*)?없|무손실|안전")
_HIYIELD_W = re.compile(r"수익\s*(?:률\s*)?(?:높|많|좋)|이자\s*(?:많|높)|"
                        r"높은\s*(?:금리|수익|이자)|대박|불려|불리게|많이\s*주")


def tradeoff_card(question):
    """원금보장+고수익을 동시에 요구하는 추천 요청이면 양립 불가를 못박는다."""
    if not (_SAFE_W.search(question) and _HIYIELD_W.search(question)):
        return None
    return ("[원금보장과 고수익은 양립하지 않음 — 문서 기준]\n"
            "원금과 이자가 보장되는 상품은 정기예금·저축은행예금·GIC 등 "
            "원리금보장형에 한하며, 안전한 대신 수익률이 낮다. 높은 수익을 "
            "기대하는 실적배당형(펀드·ETF·TDF 등)은 투자성과에 따라 원금 손실이 "
            "날 수 있고 원금이 보장되지 않는다. 따라서 '원금이 보장되면서 수익도 "
            "높은' 단일 상품은 존재하지 않는다. 특정 상품을 '원금 보장되면서 수익 "
            "높다'고 단정 추천하지 말고, 이 트레이드오프를 먼저 분명히 밝힌 뒤 "
            "안전과 수익 중 무엇을 우선할지 되물어 조건별로 안내하라.")


def midwithdraw_card(question):
    """IRP·퇴직연금 중도인출 사유를 묻는 질문이면 문서 확정 사유를 붙인다."""
    if not (_WD_TOPIC.search(question) and _WD_ASK.search(question)):
        return None
    return ("[중도인출 허용 사유 — 문서 기준(근로자퇴직급여보장법 시행령 제14조)]\n"
            "IRP·퇴직연금은 원칙적으로 만 55세 이전 중도인출이 제한되나, 아래 "
            "법정 사유에 해당하면 허용된다: ① 무주택자의 주택 구입 ② 무주택자의 "
            "전세금·임차보증금(근로기간 중 1회 한) ③ 본인·부양가족의 6개월 이상 "
            "요양(본인 연간 임금총액의 12.5%를 초과해 의료비를 부담하는 경우) "
            "④ 5년 이내 파산선고 또는 개인회생절차 개시 ⑤ 천재지변 등. "
            "위 사유를 구체적으로 안내하라. '특정 사유'라고만 뭉뚱그리지 마라.\n"
            "※ 자금이 급하지만 인출 사유에 해당하지 않으면, 계좌를 해지·인출하지 "
            "않고 보유 펀드를 담보로 증권담보융자(대출)를 받는 방법도 있다.")


_CMP_TAX = re.compile(r"종합과세|분리과세|1,?200|1,?500|무조건\s*(?:저율|유리|5\.5|3\.3)|"
                      r"연금\s*받으면\s*무조건")


def pension_tax_card(question):
    """연금소득 종합과세 기준(1,500만원)을 묻거나 오해한 질문이면 확정 사실을 붙인다."""
    if not (_CMP_TAX.search(question) and re.search(r"연금", question)):
        return None
    return ("[연금소득 종합과세 기준 — 문서 기준]\n"
            "사적연금(연금저축·IRP의 세액공제 받은 재원·운용수익)의 연간 수령액이 "
            "1,500만원을 초과하면(2024.1.1 이후 연금수령분부터), 소득자가 유·불리에 "
            "따라 '종합과세' 또는 '16.5% 분리과세'를 선택한다. 1,500만원 이하면 "
            "연금소득세(나이별 3.3~5.5%)로 저율 분리과세된다. 과거 기준인 "
            "1,200만원이 아니라 1,500만원이다. 공적연금·퇴직소득 재원·부득이한 사유 "
            "인출분은 이 1,500만원 계산에서 제외된다. "
            "'무조건 저율과세라 무조건 유리'가 아니라 위 기준으로 갈린다고 답하라.")


_BOND_Q = re.compile(r"채권|회사채|국공채|특수채|지방채|국채")
_BOND_ASK = re.compile(r"몇\s*시|언제|밤|지금.*살|살\s*수|매수|시간|가능")


def bond_time_card(question):
    """장외채권 매수 가능 시간을 묻는 질문이면 확정 사실을 붙인다."""
    if not (_BOND_Q.search(question) and _BOND_ASK.search(question)):
        return None
    return ("[퇴직연금 장외채권 매수 — 문서 기준]\n"
            "채권 매수 가능 시간은 영업일 10:00~15:00이며, 15:00 이후에는 매수·취소가 "
            "불가하다. 모바일(M-STOCK)로 매수·취소는 되지만 매도는 불가하며 매도는 "
            "영업점 방문 또는 유선으로 처리한다. 밤·주말 등 영업시간 외에는 매수할 수 "
            "없다.")


_BOND_LIMIT_ASK = re.compile(r"한도|위험|비율|얼마(?:까지)?|제한|안전")


def bond_limit_card(question):
    """퇴직연금 채권 투자 위험·한도를 묻는 질문이면 확정 사실을 붙인다."""
    if not (_BOND_Q.search(question) and _BOND_LIMIT_ASK.search(question)):
        return None
    return ("[퇴직연금 채권 투자 위험·한도 — 문서 기준]\n"
            "국채 외의 채권(지방채·특수채·회사채)은 퇴직연금 감독규정상 '위험자산'에 "
            "해당한다. 위험자산은 적립금의 70%까지만 편입할 수 있고(위험자산 한도), "
            "동시에 계열회사 등이 발행한 채권처럼 서로 계열 관계인 채권들의 합계가 "
            "적립금의 40%를 넘을 수 없다(집중투자 한도·계열 매수한도). 두 한도를 "
            "모두 충족해야 하며, 초과 시 매수신청이 취소될 수 있다.")


# v9.99n: 연금저축·IRP 중도해지 세금에서 '부득이한 사유 시 저율(3.3~5.5%)'을
#   확정한다(실측 M03 — '안 떼는 경우도 있어요?'에 세율이 낮아진다는 핵심이 빠지고
#   '세금은 여전히 발생'으로 애매하게 답함). M11은 맞게 답해 확률적 누락이었다.
_CANCEL_Q = re.compile(r"중도\s*해지|중도해지|해지하면|해지\s*시|깨(?:면|고|는|버리)")


def pension_cancel_card(question):
    """연금저축·IRP 중도해지 세금을 묻는 질문이면 부득이 사유 저율을 못박는다."""
    if not (re.search(r"연금저축|연금\s*계좌|IRP|퇴직연금", question)
            and _CANCEL_Q.search(question)):
        return None
    return ("[연금저축·IRP 중도해지(연금외수령) 세금 — 문서 기준]\n"
            "세액공제를 받은 납입금과 운용수익을 중도해지하면 기타소득세 16.5%"
            "(지방소득세 포함)가 부과된다. 다만 '부득이한 사유'(천재지변, 저축자의 "
            "사망·해외이주, 파산·개인회생 선고, 3개월 이상의 요양 의료비, 연금계좌 "
            "취급자의 영업정지 등)에 해당하면 16.5%가 아니라 저율의 연금소득세"
            "(나이별 3.3~5.5%)로 분리과세된다. '부득이한 사유여도 세금은 여전히 "
            "발생한다'가 아니라 '세율이 16.5%에서 3.3~5.5%로 낮아진다'는 점을 분명히 "
            "안내하라. 세액공제를 받지 않은 납입 원금(과세제외금액)은 과세되지 않는다.")


def calc_disambig_card(question):
    """v10.9b: calc100 실측 오답/혼동 5건 — 질문 조건으로 정답 사실을 못박는 카드.
       문서에 값이 있으나 (a)유사 개념 숫자와 헷갈리거나 (b)검색이 값 청크를
       못 집는 경우의 최종 방어. 조건은 질문에만 건다(답변에 걸지 않는다)."""
    # ① 집중투자한도(≠위험자산 한도) — 실측 G02·G03·G04: 70%로 오답
    if re.search(r"집중\s*투자\s*한도|집중투자", question):
        return ("[집중투자한도 — 문서 기준]\n"
                "집중투자한도는 2023.07.03에 폐지되었다. 폐지 전 한도는 "
                "DB 10%, DC/IRP 30%였다(한 종목·계열 등에 집중 투자할 수 있는 "
                "비율 한도). 이는 '위험자산 투자한도(적립금의 70%)'와는 전혀 다른 "
                "별개의 한도다. 집중투자한도를 묻는데 70%라고 답하지 마라 — "
                "70%는 위험자산 한도이고, 집중투자한도는 DB 10%·DC/IRP 30%(폐지 전)다.")
    # ② 과학기술인공제회 개인부담금율 — 실측 G08: '확인할 수 없음'
    if re.search(r"부담금", question) and re.search(r"과학기술|과기공|공제회", question):
        return ("[과학기술인공제회 개인부담금 — 문서 기준]\n"
                "과학기술인연금의 개인부담금은 연간 임금총액의 4.5% 이상"
                "(출연연 임직원에 한함)이다. 소속기관은 연간임금총액의 1/12을 "
                "법정부담금으로 납부한다. 개인부담금율은 4.5%다.")
    # ③ 임원퇴직소득 한도초과분 근로소득 누진세율 — 실측 C10: 16.5~38.5로 오답
    if re.search(r"임원", question) and re.search(r"누진|근로소득|초과|세율|몇\s*%", question):
        return ("[임원퇴직소득 한도초과분 과세 — 문서 기준]\n"
                "임원퇴직소득 한도를 초과한 금액은 퇴직소득이 아니라 근로소득으로 "
                "과세되며, 지급 연도의 다른 근로소득·종합과세 대상 소득과 합산해 "
                "6.6%~49.5%(지방소득세 포함)로 누진과세된다. 16.5%~38.5%가 아니라 "
                "6.6%~49.5%다.")
    # ④ (구)개인연금저축(2000년 이전) 연금외수령 세율 — 실측 D04: 16.5로 오답
    if re.search(r"개인연금", question) and re.search(r"2000|연금\s*외\s*수령|연금외수령", question):
        return ("[(구)개인연금저축 연금외수령 세율 — 문서 기준]\n"
                "2000.12.31 이전 개설한 (구)개인연금저축을 연금 외로 수령하면 "
                "이자소득세 15.4%(지방소득세 포함)가 과세된다. 이는 세액공제 방식의 "
                "신(新) 연금저축계좌를 연금외수령할 때 붙는 기타소득세 16.5%와 다르다. "
                "(구)개인연금은 기타소득세 16.5%가 아니라 이자소득세 15.4%다.")
    # ⑥ (구)개인연금 소득공제 — 실측 E06 flaky(신 연금저축 세액공제와 혼동)
    if re.search(r"개인연금", question) and re.search(r"소득공제", question):
        return ("[(구)개인연금저축 소득공제 — 문서 기준]\n"
                "2000.12.31 이전 개설한 (구)개인연금저축은 세액공제가 아니라 "
                "소득공제 방식이다. 납입액의 40%를 소득공제하며, 소득공제 한도는 "
                "연 72만원이다. 따라서 한도를 다 채우려면 연 180만원을 납입하면 "
                "된다(180만원 × 40% = 72만원). 이는 세액공제 방식의 신(新) "
                "연금저축(세액공제 한도 연 600만원)과 다르다. '개인연금 소득공제'를 "
                "물으면 세액공제 600/900만원이 아니라 소득공제 40%·한도 72만원·"
                "납입 180만원으로 답하라.")
    # ⑧ 연금수령 요건(55세 + 가입기간 5년) — 실측 R25 flaky('5년만 부으면' 전제 교정)
    if re.search(r"5\s*년", question) and re.search(r"연금", question) \
            and re.search(r"받|수령|개시|가능|되나|되는", question):
        return ("[연금수령 요건 — 문서 기준]\n"
                "연금계좌에서 연금으로 수령하려면 두 가지를 모두 충족해야 한다: "
                "① 만 55세 이상, ② 가입일로부터 5년 이상 경과(가입기간 5년). "
                "여기서 '5년'은 '가입기간'이지 납입기간이나 수령기간이 아니다. "
                "따라서 '5년만 부으면 받을 수 있다'는 전제는 부정확하며, 만 55세 "
                "요건도 반드시 함께 충족해야 한다고 바로잡아 안내하라. "
                "(단, 이연퇴직소득이 있는 경우에는 가입기간과 무관하게 연령요건만 "
                "충족하면 수령이 가능하다.)")
    # ⑦ 해외주식 직접투자 손익통산 vs 국내상장 해외ETF — 실측 H05 flaky
    if re.search(r"해외\s*(?:주식|증시)", question) \
            and re.search(r"손익\s*통산|이익.{0,15}손실|손실.{0,15}이익", question):
        return ("[해외주식 직접투자 손익통산 — 문서 기준]\n"
                "해외 증시에 상장된 주식을 직접 투자하면 매매손익은 '양도소득'으로 "
                "과세되며, 같은 과세기간의 이익과 손실을 통산한다. 예: 500만원 이익과 "
                "100만원 손실이면 통산 과세소득은 400만원이다(양도소득 기본공제 250만원 "
                "적용 전 금액). 반면 국내 상장 해외 ETF는 매매차익을 '배당소득'(15.4%)으로 "
                "보아 손익통산이 되지 않는다. 이 둘을 혼동하지 마라.")
    # ⑤ ISA 추가공제 포함 1,200만원 세액공제 최대 절세액 — 실측 A09 flaky(148.5만 오답)
    if re.search(r"1[,.]?200\s*만|1200\s*만", question) \
            and re.search(r"세액공제|절세|공제액", question):
        return ("[ISA 추가공제 포함 세액공제 최대 절세액 — 문서 기준]\n"
                "연금계좌 세액공제 한도 900만원에 ISA 만기자금 추가공제 300만원을 "
                "더하면 세액공제 대상은 최대 1,200만원이 된다. 총급여 5,500만원 이하"
                "(공제율 16.5%)면 최대 절세액은 198만원(=1,200만원 × 16.5%)이다. "
                "1,200만원을 기준으로 물었으면 900만원 기준의 148만 5천원이 아니라 "
                "198만원으로 계산하라.")
    return None


def enforce_risk_row(ans, prof):
    """비교표의 위험등급 칸을 원문 값으로 다시 쓴다.
    → (답변, 교정 칸수, 칸을 맞춘 상품명 집합, 대조 못 한 등급 칸수)"""
    if not prof:
        return ans, 0, set(), 0
    lines = ans.splitlines()
    idx = [i for i, ln in enumerate(lines) if ln.count("|") >= 2]
    if len(idx) < 2:
        return ans, 0, set(), 0
    header = _cells(lines[idx[0]])
    row_i = None
    for i in idx[1:]:
        c = _cells(lines[i])
        if c and any(k in c[0] for k in ("위험등급", "위험 등급", "위험도")):
            row_i = i
            break
    if row_i is None:
        return ans, 0, set(), 0
    cur = _cells(lines[row_i])
    if len(cur) != len(header):
        return ans, 0, set(), 0
    fixed, n, matched, unver = [cur[0]], 0, set(), 0
    for h, val in zip(header[1:], cur[1:]):
        hit_name, hit = _match_col(h, prof)
        if not hit:
            # v9.72: 등급을 말하고 있는데 원문에서 그 상품을 못 찾은 칸은 세어 둔다.
            #   침묵하면 대조된 값처럼 보인다.
            if re.search(r"[1-6]\s*등급", val):
                unver += 1
            fixed.append(val)
            continue
        matched.add(hit_name)
        want = f"{hit['grade']}등급" + (f"[{hit['label']}]" if hit["label"] else "")
        if val.strip() != want:
            n += 1
        fixed.append(want)
    if n:
        lines[row_i] = "| " + " | ".join(fixed) + " |"
    return "\n".join(lines), n, matched, unver


def _claimed_grades(ans):
    """v9.72: 비교표의 위험등급 행이 등급을 몇 개나 '주장'하고 있는가.
    카드를 붙일지 말지는 여기서 정한다 — 표가 등급을 말하면 그 등급의 출처를
    밝히는 것은 조건이 아니라 의무다."""
    for ln in ans.splitlines():
        if ln.count("|") >= 2 and ("위험등급" in ln or "위험 등급" in ln
                                   or "위험도" in ln):
            return len(re.findall(r"[1-6]\s*등급", ln))
    return 0


def fix_risk_claims(ans, prof, matched=None, text_scope="", unverified=0):
    """원문 등급과 어긋나는 문장을 지우고, 원문 기준 정리를 붙인다.
    → (답변, 삭제수, 추적문구)"""
    # v9.49: 답변이 다루지 않는 상품의 등급을 덧붙이면 오히려 근거를 흐린다.
    #   (실측 H3: TDF2045를 물었는데 검색에 걸린 다른 상품의 등급이 붙었다)
    # v9.61: 위험등급 정리는 '상품을 비교한 답변'에 붙는 것이다.
    #   표가 없으면 그 답변은 상품을 비교하지 않았다는 뜻이므로 붙이지 않는다.
    claimed = _claimed_grades(ans)
    if claimed < 2 and sum(1 for ln in ans.splitlines() if ln.count("|") >= 2) < 3:
        return ans, 0, ""
    matched = matched or set()
    # v9.78: 어느 상품의 카드를 붙일지는 추측하지 않는다. 표의 열과 실제로
    #   이어진 상품(matched)만 쓴다 — 바이그램 추측은 TDF2045 질문에 이웃 TDF
    #   상품을 끌어와 '답변이 다루지 않는 상품의 등급'을 붙였다(실측 R50 재발).
    prof = {n: r for n, r in prof.items() if n in matched}
    # v9.72: 표는 등급을 2개 이상 말하는데 원문에서 확인한 상품이 2개가 안 된다.
    #   그대로 두면 확인하지 못한 등급이 대조된 값처럼 보인다 — 밝히고 끝낸다.
    if len(prof) < 2:
        if claimed < 2:
            return ans, 0, ""
        card = RISK_WARN_MARK + " 불가]"
        if len(prof) == 1:
            _n, _r = next(iter(prof.items()))
            card += (f" '{_r['short']}'의 현재 위험등급은 {_r['grade']}등급"
                     + (f"[{_r['label']}]" if _r["label"] else "") + "입니다.")
            card += (" 표에 적힌 나머지 등급은 해당 상품의 투자설명서를 찾지 못해"
                     " 원문과 대조하지 못했습니다.")
        else:
            card += (" 표에 적힌 위험등급은 투자설명서 원문과 대조하지 못했습니다"
                     " (해당 상품의 투자설명서를 찾지 못했습니다).")
        card += " 가입 전 각 상품의 투자설명서에서 위험등급을 직접 확인하시기 바랍니다."
        if RISK_WARN_MARK not in ans and RISK_CARD_MARK not in ans:
            ans = ans.rstrip() + "\n\n" + card
        return ans, 0, f" 위험등급 대조 불가 고지(확인 {len(prof)}개/표 {claimed}개)"
    good = {r["grade"] for r in prof.values()}
    good_labels = {r["label"] for r in prof.values() if r["label"]}
    same = len(good) == 1
    dropped, out = 0, []
    for line in ans.splitlines():
        if line.count("|") >= 2:
            out.append(line)
            continue
        keep = []
        for sent in re.split(r"(?<![0-9]\.)(?<=[.!?])\s+", line):
            flat = re.sub(r"[*_`'\"]", "", sent)
            nums = {int(x) for x in re.findall(r"([1-6])\s*등급", flat)}
            bad = bool(nums - good)
            if not bad and same and any(w in flat for w in
                                        ("등급이 낮은", "등급이 더 낮", "위험등급이 낮",
                                         "등급이 높은", "등급 차이", "등급이 다르")):
                bad = True
            # v9.47: 등급이 서로 다른데 '모두 같다'고 묶는 문장 (실측: 5·6등급인데
            #        "두 펀드 모두 매우 낮은 위험")
            if not bad and not same and any(w in flat for w in
                                            ("모두", "둘 다", "양쪽", "전부", "동일")) \
                    and any(lb in flat for lb in _LABEL_BY_GRADE.values()):
                bad = True
            if not bad:
                for lb in ("매우 높은 위험", "높은 위험", "다소 높은 위험", "보통 위험",
                           "낮은 위험", "매우 낮은 위험"):
                    if lb in flat and good_labels and lb not in good_labels:
                        bad = True
                        break
            if bad:
                dropped += 1
                continue
            keep.append(sent)
        out.append(" ".join(k for k in keep if k.strip()))
    ans = re.sub(r"\n{3,}", "\n\n", "\n".join(out))

    grades, vols, vkind = _risk_lines(prof)
    card = (RISK_CARD_MARK + " — 투자설명서 원문 기준] 현재 위험등급은 "
            + grades + "입니다.")
    if same:
        card += " 비교한 상품의 위험등급은 모두 같으므로 등급만으로는 우열을 가릴 수 없습니다."
    else:
        _best = max(r["grade"] for r in prof.values())
        _saf = [r for r in prof.values() if r["grade"] == _best]
        card += (" 등급 숫자가 클수록 위험이 낮은 표기이므로, 표기된 등급만 놓고 보면 "
                 + "·".join(f"'{r['short']}'" for r in _saf)
                 + f"({_best}등급"
                 + (f"[{_saf[0]['label']}]" if _saf[0]["label"] else "") + ")의 위험이 가장 낮습니다.")
    if len(vols) >= 2:
        card += (f" 문서에 적힌 변동성 지표({vkind})는 "
                 + " / ".join(f"{n} {v}%" for n, v in vols)
                 + f"으로, 표기상 가장 낮은 것은 '{vols[0][0]}'입니다.")
    card += " (문서의 '위험등급 변경' 이력에 적힌 과거 등급은 현재 등급이 아닙니다.)"
    # v9.72: 표에 등급이 적혔는데 그 상품을 원문에서 못 찾은 열이 있으면 밝힌다.
    if unverified:
        card += (f" 다만 표의 {unverified}개 항목은 해당 상품의 투자설명서를 찾지 못해"
                 " 원문과 대조하지 못했으니 가입 전 직접 확인하시기 바랍니다.")
    if RISK_CARD_MARK not in ans:
        ans = ans.rstrip() + "\n\n" + card
    return ans, dropped, f" 위험등급 정리(원문 {len(prof)}개 상품)"


# ── v9.48: 문서에 없는 것을 '추측'으로 채우지 않는다 ──────────────────────
#   실측: 비교표 칸에 "별도 명시되지 않으나 비교적 짧을 것으로 예상됨",
#         "명시되지 않았으나 일반적으로 동일하게 적용될 가능성 있음" 이 들어갔다.
#   '자료에 없다'고 스스로 말하면서 그 자리를 추측으로 메우는 것은 근거 기반 위반이다.
#   → 두 신호가 한 칸(또는 한 문장)에 같이 있으면 '자료 없음'으로 되돌린다.
_NOSTATE = re.compile(r"(?:명시|기재|제시|언급|확인|제공|설명|나와)\s*되?\s*(?:지|가|이)?\s*"
                      r"(?:않|아니|못하)[가-힣]*\s*(?:으나|지만|나|고)")
_GUESS = ("예상", "추정", "가능성", "보입니다", "보임", "것으로 판단", "일 것", "듯",
          "일반적으로", "통상")
# v9.59: 표 칸에서는 이 표현만 있어도 근거 없는 추측이다 (신호어 불필요)
_GUESS_STRICT = ("예상", "추정", "가능성", "보입니다", "보임", "것으로 판단", "일 것",
                 "일반적으로", "통상", "듯")
_NOINFO_CELL = "자료 없음"


def strip_speculation(ans):
    """'자료에 없다'고 말하면서 추측으로 메운 칸·문장을 정리한다. → (답변, 건수)"""
    n = 0
    out = []
    for line in ans.splitlines():
        if line.count("|") >= 2:                      # 표: 해당 칸만 '자료 없음'으로
            cells = line.split("|")
            for i, c in enumerate(cells):
                # v9.92: '자료 있음'은 정보가 0인 칸이다 (실측 R45x — 수수료 칸에
                #   숫자 대신 '자료 있음'). 값을 확인해 적지 못했으므로 '자료 없음'
                #   으로 되돌린다 — 말미 각주가 그 뜻을 설명한다.
                if c.strip() in ("자료 있음", "자료있음", "있음"):
                    cells[i] = f" {_NOINFO_CELL} "
                    n += 1
                    continue
                # v9.59: 표 칸에는 문서에서 읽은 사실만 들어가야 한다.
                #   신호어('명시되지 않았으나') 없이 추측어만 있어도 근거가 없다.
                if _NOSTATE.search(c) or any(g in c for g in _GUESS_STRICT):
                    if _NOSTATE.search(c) and not any(g in c for g in _GUESS):
                        continue          # 단순한 '자료 없음' 서술은 그대로 둔다
                    cells[i] = f" {_NOINFO_CELL} "
                    n += 1
            out.append("|".join(cells))
            continue
        keep = []
        for sent in re.split(r"(?<![0-9]\.)(?<=[.!?])\s+", line):
            if _NOSTATE.search(sent) and any(g in sent for g in _GUESS):
                n += 1
                continue
            keep.append(sent)
        out.append(" ".join(k for k in keep if k.strip()))
    if not n:
        return ans, 0
    return re.sub(r"\n{3,}", "\n\n", "\n".join(out)), n


# ── v9.64: 지어낸 '이유' 제거 ────────────────────────────────────────
#   실측: 문서에는 "변경 불가하며 오류메시지가 나옵니다"뿐인데 답변은
#   "…아닌 것으로 간주되기 때문입니다"라고 이유를 붙였다. 사실은 맞아서
#   근거 검증을 통과한다. 모델이 스스로 추론했음을 드러내는 동사만 좁게 잡는다.
_INFER_REASON = re.compile(
    r"[^.!?\n]*(?:간주|판단|해석|추정|이해|여겨)\s*(?:되|하)[가-힣]*\s*"
    r"(?:때문|이유)[^.!?\n]*[.!?]?")
# v9.65: '이는 곧 ~를 시사합니다' — 문서에 없는 결론을 끌어내는 표현.
#   실측: 문서는 '융자잔고가 있는 계좌는 이관 불가'라고만 했는데
#   거기서 '담보대출이 불가하다'를 도출했다.
_INFER_CONCL = re.compile(r"[^.!?\n]*(?:시사|유추|추론)[가-힣]*[^.!?\n]*[.!?]?")


def strip_invented_reason(ans):
    """'~로 간주되기 때문입니다' 처럼 모델이 추론해 붙인 이유를 지운다."""
    out, n = [], 0
    for line in ans.splitlines():
        if line.count("|") >= 2:          # 표는 건드리지 않는다
            out.append(line)
            continue
        new, c = _INFER_REASON.subn("", line)
        new, c2 = _INFER_CONCL.subn("", new)
        c += c2
        if c:
            n += c
            new = re.sub(r"\s*,\s*(?=[.!?]|$)", "", new)
            new = re.sub(r"\s{2,}", " ", new).strip()
            # 문장이 통째로 사라졌으면 그 줄은 버린다
            if not re.search(r"[가-힣]", new):
                continue
        out.append(new)
    if not n:
        return ans, 0
    return re.sub(r"\n{3,}", "\n\n", "\n".join(out)), n



# ── v9.42: 일부만 확인된 항목을 '모든 상품이 ~'로 일반화하면 주의를 붙인다 ──────
#   실측: 장기의 보수가 '자료 없음'인데 "모든 유형에서 C-P가 가장 낮다"고 단정했다.
_ALL_WORDS = ("모든", "전부", "모두", "공통적으로", "일괄")


def warn_partial_generalization(ans):
    lines = ans.splitlines()
    idx = [i for i, ln in enumerate(lines) if ln.count("|") >= 2]
    if len(idx) < 3:
        return ans, 0
    partial = []
    for i in idx[1:]:
        c = _cells(lines[i])
        if len(c) >= 3 and any("자료 없음" in x for x in c[1:]) \
                and not all("자료 없음" in x for x in c[1:]):
            partial.append(c[0])
    if not partial:
        return ans, 0
    # v9.43: 표 라벨('수수료(보수)')과 본문 표현('수수료 범위')이 달라 놓치던 문제
    body = [ln for ln in lines if ln.count("|") < 2]
    hit = []
    for lab in partial:
        keys = [k for k in re.split(r"[()·\s/]+", lab) if len(k) >= 2]
        if any(any(k in ln for k in keys) and any(w in ln for w in _ALL_WORDS)
               for ln in body):
            hit.append(lab)
    if not hit:
        return ans, 0
    note = ("※ " + "·".join(f"'{h}'" for h in hit)
            + " 항목은 일부 상품의 값이 자료에서 확인되지 않아, 세 상품 전체에 대한 "
              "일반화가 아니라 확인된 상품에 한한 설명입니다.")
    if note in ans:
        return ans, 0
    return ans.rstrip() + "\n\n" + note, len(hit)



def detect_fee_values(context):
    """참고 문서에서 '보수'로 표기된 값들을 모은다 (0~10% 범위만)"""
    found = []
    for lab in FEE_LABELS:
        for m in re.finditer(re.escape(lab), context):
            for v in _FEE_NUM.findall(context[m.end():m.end() + 60]):
                if 0 < float(v) < 10 and v not in found:
                    found.append(v)
    return sorted(found, key=float)


FEE_NOTE = (
    "[수수료·보수를 인용할 때의 규칙]\n"
    "참고 문서에 보수 관련 값이 여러 개 나타난다: {vals}\n"
    "(구성항목별 보수와 클래스별 총보수가 섞여 있을 수 있으니 그대로 옮겨 적지 마라.)\n"
    "- 총보수는 상품마다, 클래스(종류A / A-e / C 등)마다, 표(요약표 / 보수·비용 상세표)마다 "
    "다르다. 값을 쓸 때는 반드시 '어느 상품의 어느 클래스, 어느 표 기준'인지 함께 밝혀라.\n"
    "- 어느 기준인지 문서에서 확인되지 않으면 값을 단정하지 말고 '자료에서 기준을 확인할 수 "
    "없다'고 밝혀라.\n"
    "- 같은 상품·같은 클래스인데 값이 서로 다르게 적혀 있으면 한쪽만 고르지 말고 두 값과 "
    "각각의 출처를 모두 제시하고 차이가 있다는 사실을 알려라.\n"
    "- 문서에 없는 값(구성항목을 더해서 맞춘 값 등)을 만들어내지 마라.\n"
    "- '증권거래비용'과 '합성총보수(총보수)'는 서로 다른 항목이다. 증권거래비용을 "
    "물으면 합성총보수 값이 아니라 그 상품의 '증권거래비용' 값을 답하고, 두 항목을 "
    "혼동하지 마라(예: 어떤 ETF의 합성총보수 0.08%와 증권거래비용 0.0611%는 다른 값이다).\n"
    "- 값의 기준이 갈리면 '어느 상품이 가장 저렴하다'는 순위 결론을 단정하지 마라."
)


# v9.18: '이미 공제받은 세액을 다시 납부해야 합니다'처럼 세금을 두 번 매기는 표현이
#   간헐적으로 재발한다(회귀 R29). 문서 근거(doc20/doc39)에는 기타소득세 16.5% 하나뿐이고
#   세액공제 추징·환수 절차가 없으므로, 해당 문장을 문서 표현으로 바꿔 넣는다.
_DOUBLE_TAX = re.compile(
    r"[^\n]*세액\s*공제[^\n]{0,40}?(?:다시\s*납부|반환|환수|추징)[^\n]*")
_DOUBLE_TAX_FIX = ("중도 해지 시에는 세액공제를 받은 납입금과 운용수익에 대해 "
                   "기타소득세 16.5%가 부과됩니다.")


def fix_double_tax(ans):
    """세액공제 반환 + 기타소득세를 이중으로 물리는 문장을 제거한다.
    제거 후 기타소득세 설명이 남아 있지 않으면 문서 기준 문장을 대신 넣는다."""
    if "기타소득세" not in ans:
        return ans, ""
    out, cnt = [], 0
    for line in ans.split("\n"):
        if _DOUBLE_TAX.search(line) and "받지 않은" not in line:
            # 목록 항목이면 항목 전체를 덜어낸다 (앞뒤 문장이 함께 어긋나 있으므로)
            if re.match(r"\s*(?:\d+[.)]|[-*•])", line):
                cnt += 1
                continue
            sents = re.split(r"(?<![0-9]\.)(?<=[.!?])\s+", line)
            keep = [x for x in sents
                    if not (_DOUBLE_TAX.search(x) and "받지 않은" not in x)]
            cnt += len(sents) - len(keep)
            if keep:
                out.append(" ".join(keep))
            continue
        out.append(line)
    if not cnt:
        return ans, ""
    ans = re.sub(r"\n{3,}", "\n\n", "\n".join(out)).strip()
    # 남은 본문에 기타소득세 설명이 사라졌으면 문서 기준 문장으로 채운다
    if not (re.search(r"기타소득세[^\n]{0,20}16\.5", ans)
            or re.search(r"16\.5[^\n]{0,20}기타소득세", ans)):
        ans = _DOUBLE_TAX_FIX + "\n\n" + ans
    # 목록 번호가 어긋나면 다시 매긴다
    n = [0]

    def _renum(m):
        n[0] += 1
        return f"{n[0]}."
    if re.search(r"^\s*\d+\.", ans, flags=re.M):
        ans = re.sub(r"^(\s*)\d+\.", lambda m: m.group(1) + _renum(m), ans, flags=re.M)
    return ans, f" (이중과세 표현 교정 {cnt}건)"


def calc_tax_credit_bands(paid, limit=900, limit_label="연금저축+IRP 합산"):
    """소득을 모를 때: 두 구간을 모두 계산해 준다 (한쪽 세율만 찍는 오답 방지)"""
    LIMIT = limit
    base = min(paid, LIMIT)
    lines = [
        "[세액공제 계산기 결과 — 소득 구간 미상]",
        f"- 연간 납입액: {int(paid):,}만원 → 공제 대상 금액: {int(base):,}만원 "
        f"({limit_label} 세액공제 한도 {int(LIMIT):,}만원 적용)",
        f"- 총급여 5,500만원 이하(종합소득금액 4,500만원 이하): "
        f"{int(base):,}만원 \u00d7 16.5% = 약 {base * 0.165:,.1f}만원",
        f"- 총급여 5,500만원 초과: "
        f"{int(base):,}만원 \u00d7 13.2% = 약 {base * 0.132:,.1f}만원",
        "- 위 두 값은 '소득 구간에 따라 달라지는 두 경우'다. 더하지 말고, 소득을 "
        "모르는 상태에서 한쪽 값만 골라 확정하지도 마라. 두 경우를 모두 제시하라.",
        "- 한도와 공제율은 사람마다 개별 적용된다. 여러 사람의 소득을 하나로 묶지 마라.",
    ]
    if paid > LIMIT:
        lines.append(f"- 참고: 한도(900만원)를 초과한 {int(paid - LIMIT):,}만원은 세액공제 대상이 아님")
    return "\n".join(lines), {"paid": paid, "base": base, "limit": LIMIT}


# v9.14: '자료에 없다'고 밝힌 뒤 일반 상식을 덧붙이는 문제 (오류사냥 [7] 재발)
#   프롬프트로 한 번 막았다가 재발했으므로 코드로 잘라낸다.
# v9.24: 실측 — "명확히 지정할 수 없습니다"가 목록에 없어 필터가 통째로 꺼졌다.
#   '~할 수 없다 / ~어렵다' 계열을 폭넓게 잡는다.
_NOINFO = re.compile(r"(확인할 수 없|확인되지 않|확인이 어렵|포함되어 있지 않|자료에 없|"
                     r"자료에는 없|찾을 수 없|나와 있지 않|나와있지 않|명시되어 있지 않|"
                     r"제시되어 있지 않|제시되지 않|매기지 않|"
                     r"(?:지정|특정|선정|단정|answer|골라|선택)할 수 없|"
                     r"알려드릴 수 없|확답을 드릴 수 없|말씀드리기 어렵|"
                     r"비교하기 어렵|제공하기 어렵|판단하기 어렵|파악할 수 없|"
                     r"드릴 수 없|알 수 없)")
_OUTSIDE = re.compile(r"^\s*(?:일반적으로|통상|보통|참고로|다만,?\s*일반적|알려진 바|"
                      r"일반적인 경우|시중에서는)")
_HASNUM = re.compile(r"\d+\s*(?:%|퍼센트|만\s*원|원)")


# v9.15: '그러나 일반적으로 …' 처럼 문장 중간에 붙는 일반론도 잡기 위해 문장 단위로 검사
_GENERAL = re.compile(r"(?:^|[.!?]\s*|그러나\s*|하지만\s*|다만,?\s*|또한,?\s*)"
                      r"(?:일반적으로|일반적인 경우|통상적으로|통상|보통|시중에서는|"
                      r"알려진 바에 따르면|알려져 있)")


# v9.16: 문장에 들어 있는 수치가 참고 문서에 실제로 있으면 그 문장은 '근거 있음'이다.
#   (v9.15 필터가 연금소득세 3.3~5.5% 문장까지 지워버린 사고를 막는다)
_PCT = re.compile(r"(\d+(?:\.\d+)?)\s*%")
_WON = re.compile(r"([\d,]+)\s*만\s*원")


def _grounded(sent, context):
    """문장 속 수치가 참고 문서에서 확인되면 True"""
    if not context:
        return False
    for v in _PCT.findall(sent):
        if re.search(r"(?<![\d.])" + re.escape(v) + r"\s*%", context):
            return True
    for v in _WON.findall(sent):
        v2 = v.replace(",", "")
        if re.search(r"(?<![\d,])" + re.escape(v) + r"\s*만\s*원", context) or \
                re.search(r"(?<![\d,])" + re.escape(v2) + r"\s*만\s*원", context):
            return True
    return False


def strip_outside_knowledge(ans, context=""):
    """'자료에 없다'고 답한 뒤 붙은 문서 밖 설명을 삭제 (문장 단위).
    단, 문서에서 확인되는 수치가 든 문장은 근거가 있으므로 남긴다."""
    # v9.15: '자료에 없다'는 고백이 답변 어디에든 있으면 그 답변 전체에 필터를 건다.
    #   (뒷문단에서 고백하고 앞문단에서 일반론을 펴는 형태가 실제로 나왔다)
    if not _NOINFO.search(ans):
        return ans, ""
    out_lines, removed = [], 0
    for line in ans.split("\n"):
        if not line.strip():
            out_lines.append(line)
            continue
        # 문장 단위로 문서 밖 일반론을 걸러낸다
        sents = re.split(r"(?<![0-9]\.)(?<=[.!?])\s+", line)
        keep = []
        just_dropped = False
        for sent in sents:
            drop = bool(_GENERAL.search(sent)) and (
                bool(_HASNUM.search(sent)) or "경향" in sent or "가능성" in sent
                or "일반적으로" in sent)
            # v9.24: 말머리 없이 '~하는 경향이 있습니다'로 단정하는 일반론도 제거
            if not drop and ("경향이 있" in sent or "경향이 큽" in sent
                             or "일반적으로" in sent):
                drop = True
            # v9.16: 삭제된 문장을 이어받는 부연 문장('이는 … 4.5%입니다')도 함께 정리
            if not drop and just_dropped and _HASNUM.search(sent) and \
                    re.match(r"\s*(?:이는|이것은|이 경우|또한|그리고|따라서|즉|여기서)", sent):
                drop = True
            # 문서 출처가 명시됐거나, 수치가 문서에서 확인되면 근거가 있으므로 남긴다
            if drop and "출처" not in sent and not _grounded(sent, context):
                removed += 1
                just_dropped = True
                continue
            just_dropped = False
            keep.append(sent)
        if keep:
            out_lines.append(" ".join(keep))
        elif not sents:
            out_lines.append(line)
    if not removed:
        return ans, ""
    ans = "\n".join(ln for ln in out_lines
                    if not re.fullmatch(r"\s*(?:\d+[.)]|[-*•])\s*", ln))
    ans = re.sub(r"\n{3,}", "\n\n", ans).strip()
    # 목록 번호가 비면 다시 매긴다
    cnt = [0]

    def _renum(m):
        cnt[0] += 1
        return f"{m.group(1)}{cnt[0]}."
    if re.search(r"^\s*\d+\.", ans, flags=re.M):
        ans = re.sub(r"^(\s*)\d+\.", _renum, ans, flags=re.M)
    return ans, f" (문서 밖 설명 {removed}건 삭제)"


# v9.14: 16.5%와 13.2%를 한 식에서 더하던 오류 (오류사냥 [5])
_MIXED = re.compile(
    r"[^\n]*?16\.5\s*%[^\n]{0,40}\+[^\n]{0,40}13\.2\s*%[^\n]*"
    r"|[^\n]*?13\.2\s*%[^\n]{0,40}\+[^\n]{0,40}16\.5\s*%[^\n]*")


def fix_mixed_rate(ans, paid=None):
    """한 사람에게 두 공제율을 동시 적용한 계산식을 구간별 안내로 교체.
    그 식이 만들어낸 '틀린 합계 금액'이 본문에 남아 있으면 그 문장도 제거한다."""
    base = min(paid, 900) if paid else 900
    fix = (f"세액공제율은 소득에 따라 둘 중 하나만 적용됩니다. "
           f"총급여 5,500만원 이하면 {int(base):,}만원 \u00d7 16.5% = 약 {base * 0.165:,.1f}만원, "
           f"5,500만원을 초과하면 {int(base):,}만원 \u00d7 13.2% = 약 {base * 0.132:,.1f}만원입니다.")
    wrong_totals = []

    def _sub(m):
        # 잘못된 식의 마지막 '= N만원' 값 = 틀린 합계
        vals = re.findall(r"=\s*\**\s*([\d,]+\.?\d*)\s*만", m.group(0))
        if vals:
            wrong_totals.append(vals[-1].replace(",", ""))
        return fix

    ans2, n = _MIXED.subn(_sub, ans)
    if not n:
        return ans, ""
    for w in set(wrong_totals):
        good = {f"{base * 0.165:,.1f}", f"{base * 0.132:,.1f}"}
        if w in {g.replace(",", "") for g in good}:
            continue                       # 우연히 맞는 값이면 건드리지 않음
        pat = re.compile(r"(?<![\d.])" + re.escape(w) + r"\s*만\s*원?")
        keep = [ln for ln in ans2.split("\n") if not pat.search(ln)]
        ans2 = "\n".join(keep)
    ans2 = re.sub(r"\n{3,}", "\n\n", ans2).strip()
    return ans2, f" (공제율 혼용 교정 {n}건)"


def post_with_retry(url, payload, timeout=45, tries=3):
    """API 호출 공통 함수: 실패하면 쉬었다 재시도.
    v7.5: 속도 제한(429)은 더 길게 기다리며 재시도 (연속 질문 심사 대비)
    v9.27: 5회x60초는 최악의 경우 수 분이 걸려 무응답 위험이 커서 3회x45초로 줄였다."""
    # v9.65: 429로 최종 실패하면 그 질문은 답변 자체가 없다(실측: 심사에서 0점).
    #   429일 때만 시도를 늘린다. 다른 오류까지 늘리면 무응답 시간이 길어진다.
    last_err = None
    i, n429, limit = 0, 0, tries
    while i < limit:
        wait = 1.5 * (i + 1)
        try:
            r = requests.post(url, headers=HEADERS, json=payload, timeout=timeout)
            if r.status_code == 200:
                return r
            last_err = Exception(f"HTTP {r.status_code}")
            if r.status_code == 429:          # 속도 제한
                n429 += 1
                wait = (4.0, 8.0, 14.0, 14.0)[min(n429 - 1, 3)]
                limit = max(limit, 4)          # 최대 4회까지 끈질기게
        except Exception as e:
            last_err = e
        time.sleep(wait)
        i += 1
    raise last_err


def chat(system, user_msg, max_tokens=500, temperature=0.15):
    """HCX-005 호출 공통 함수 (재시도 포함)"""
    body = {
        "messages": [
            {"role": "system", "content": system},
            {"role": "user", "content": user_msg},
        ],
        "maxTokens": max_tokens,
        "temperature": temperature,
    }
    res = post_with_retry(CHAT_URL, body, timeout=60)
    return res.json().get("result", {}).get("message", {}).get("content", "")


def classify(question):
    """질문을 5개 유형 중 하나로 분류. 실패하면 '일반'(폴백)."""
    try:
        text = chat(CLASSIFY_SYSTEM, question, max_tokens=10, temperature=0.1)
        for label in LABELS:
            if label in text:
                return label
    except Exception:
        pass
    return "일반"


def extract_json(system, question):
    """LLM으로 질문에서 정보를 JSON 형태로 추출. 실패하면 빈 dict."""
    try:
        text = chat(system, question, max_tokens=100, temperature=0.1)
        m = re.search(r"\{.*\}", text, re.S)
        if m:
            return json.loads(m.group())
    except Exception:
        pass
    return {}


def to_num(v):
    """추출값을 숫자로 안전 변환 (실패 시 None)"""
    try:
        n = float(v)
        return n if n > 0 else None
    except (TypeError, ValueError):
        return None


def filter_by_relevance(docs, scores, min_keep=REL_MIN_KEEP):
    """v9.38: 관련도가 낮은 문서를 근거에서 제외한다.
    반환: (남긴 문서, 남긴 점수, 제외한 점수 목록)"""
    if len(docs) <= min_keep:
        return docs, scores, []
    top = max(scores)
    thr = max(top * REL_RATIO, REL_FLOOR)
    keep = [i for i, sc in enumerate(scores) if sc >= thr]
    if len(keep) < min_keep:                      # 너무 많이 잘리면 상위부터 다시 채운다
        order = sorted(range(len(scores)), key=lambda i: -scores[i])
        keep = sorted(order[:min_keep])
    drop = [i for i in range(len(docs)) if i not in keep]
    return ([docs[i] for i in keep], [scores[i] for i in keep],
            [round(scores[i], 3) for i in drop])


# ── v9.67: 용어 확장 ────────────────────────────────────────────────
#   상담 질문은 고객의 말로 오고, 문서는 업무 용어로 쓰여 있다. 둘이 다르면
#   키워드 검색이 끊긴다. 확인된 짝만 좁게 넣는다(추측으로 넓히면 엉뚱한 문서가 온다).
QUERY_SYNONYMS = [
    (("예수금", "예탁금", "투자하지 않은 현금", "안 굴리는 현금", "남은 현금"),
     ["현금성자산", "대기성자금", "대기자금"]),
    (("보험사", "은행에 있는", "타사에 있는", "가져올", "가져오", "옮겨올"),
     ["계약이전", "실물이전", "타사 이관", "수관"]),
    (("옮기", "이체하", "넘기"), ["이전", "이관", "실물이전"]),
    # v9.71: '주식→지분증권' 확장은 뺐다. doc34는 '계좌를 다른 금융사로 옮길 때'의
    #   실물이전 이야기라, 일반 주식계좌→연금계좌 질문에는 맞지 않는 근거를 끌어왔다.
    (("자동 매수", "자동매수", "정기 매수", "매달 사"), ["자동매수", "적립식", "옵트인"]),
    (("합쳐서", "통합해서", "한꺼번에"), ["합산", "일괄"]),
    (("문자", "알림", "카톡"), ["알림톡", "SMS", "안내 발송"]),
    (("담보대출", "대출"), ["증권담보융자", "융자"]),
    (("수수료 싼", "저렴한"), ["보수", "총보수", "수수료율"]),
    (("깨면", "깨는", "중간에 빼"), ["중도해지", "중도인출"]),
    # v9.95: 표적 사냥 잔존 2건 — 고객 표현과 문서 표현의 어긋남
    (("구개인연금", "구 개인연금", "옛날 개인연금"), ["개인연금저축"]),
    # v9.96 확장어: '계열·매수한도·위험자산'으로는 doc7이 안 떴다(V2 실측) —
    #   doc7에 몰려 있는 희귀 표현으로 교체해 BM25 견인력을 높인다.
    (("회사채", "특수채", "지방채"), ["계열회사", "매수한도", "감독규정", "위험자산"]),
    # v9.99z: 'ETF 종목 추천'류 질문에 ETF 상품목록 청크를 안정적으로 끌어온다
    #   (실측: 검색이 ETF 목록을 못 집어와 모델이 이름을 지어냄 → 창작 방어가 다 지움).
    #   ETF 목록 청크에 몰려 있는 표현으로 BM25 견인력을 높인다.
    (("ETF", "이티에프", "상장지수", "적립식으로"),
     ["TIGER", "설정액", "합성총보수", "상장지수펀드"]),
]


def expand_query(question):
    """질문에 고객 표현이 있으면 문서 표현을 덧붙인다. → (확장된 검색어, 붙인 말)"""
    added = []
    for keys, docs in QUERY_SYNONYMS:
        if any(k in question for k in keys):
            for d in docs:
                if d not in question and d not in added:
                    added.append(d)
    if not added:
        return question, []
    return question + " " + " ".join(added), added


def faq_match_line(q_search, context):
    """질문이 근거 문서의 FAQ 질문(QN. …)과 사실상 같으면 그 원문 줄을 돌려준다.
    v9.94: 실측 — 정답 청크를 주고도 '확인할 수 없습니다'로 답한 4건(N0005·
    N0022·N0133·N0151)은 모두 문서에 같은 질문이 그대로 있었다. 판정은
    바이그램 겹침(≥0.6)으로 코드가 한다 — 조건은 질문과 근거에만 건다."""
    qn = re.sub(r"[\s?.!,]", "", q_search)
    if len(qn) < 8:
        return None
    qb = {qn[i:i + 2] for i in range(len(qn) - 1)}
    best, best_ov = None, 0.0
    for ln in context.splitlines():
        m = re.search(r"Q\s*\d+(?:-\d+)?\.\s*(.+)", ln)
        if not m:
            continue
        cand = re.sub(r"[\s?.!,]", "", m.group(1))[:80]
        if len(cand) < 6:
            continue
        cb = {cand[i:i + 2] for i in range(len(cand) - 1)}
        ov = len(qb & cb) / max(1, min(len(qb), len(cb)))
        if ov > best_ov:
            best_ov, best = ov, m.group(0).strip()[:120]
    return best if best_ov >= 0.6 else None


def search(question, top_k=5):
    """하이브리드 검색: 임베딩(의미) + BM25(키워드) 순위 결합(RRF).
    반환: (문서 목록, 각 문서의 임베딩 유사도, 임계값 판정용 최고 임베딩 유사도)"""
    res = post_with_retry(EMB_URL, {"text": question}, timeout=30)
    q = np.array(res.json()["result"]["embedding"])
    q = q / np.linalg.norm(q)
    emb_scores = matrix @ q
    top_score = float(emb_scores.max())  # 무관 판정은 기존처럼 임베딩 기준 유지

    if HYBRID:
        # v9.67: 키워드 검색에만 용어를 확장한다. 임베딩(의미)은 원 질문 그대로.
        kw_query, _added = expand_query(question)
        kw_scores = bm25_scores(kw_query)
        # 점수 정규화 결합: 임베딩(의미) 0.6 + 키워드(정확 용어) 0.4
        def _norm(x):
            span = x.max() - x.min()
            return (x - x.min()) / span if span > 0 else np.zeros_like(x)
        fused = 0.6 * _norm(emb_scores) + 0.4 * _norm(kw_scores)
        base = fused
    else:
        base = emb_scores

    # v9.94: 한 문서가 자리를 독식하지 않게 — 같은 문서는 최대 3청크까지만.
    #   (실측 N0010·N0012: doc46·doc54가 4~5자리를 차지해 정답 문서가 밀렸다.
    #    한 문서에 답이 다 있는 경우에도 3청크면 충분하다 — MP구독 실측 5/5 정답)
    cand = np.argsort(-base)[:top_k * 4]
    order, _per = [], {}
    for i in cand:
        s = chunks[idx_list[i]]["source"]
        if _per.get(s, 0) >= 3:
            continue
        _per[s] = _per.get(s, 0) + 1
        order.append(i)
        if len(order) == top_k:
            break

    docs = [chunks[idx_list[i]] for i in order]
    doc_scores = [float(emb_scores[i]) for i in order]
    return docs, doc_scores, top_score, (_added if HYBRID else [])


def _final_cleanup(ans):
    """v11.6: 최종 마크다운 정리 — 여러 카드/후처리 단계가 겹쳐 생기는 표면 결함만
    안전하게 교정한다. 내용(수치·의미)은 건드리지 않는다(Primary Source 보존).
      A) 볼드-퍼센트 글리치: **N**% → **N%**, N**% → N%, N**( → N(
      B) 후처리 흉터: '참고 문서 아래 참고 문서'→'참고 문서', '자료 원문아래 참고 문서'→'자료 원문'
      C) 깨진 번호목록('N.'만 있는 줄) 다음 줄과 병합
      D) 연속 중복 줄 제거(공백·목록마커 무시, exact만 — semantic dedupe 안 함)
      E) 줄 내 홀수 '**' 정리 + bare-amount orphan 조각 제거(직전 줄이 '만 원'으로 끝날 때만)
      F) 선두 빈 줄 제거 + 과다 빈 줄 축소
    """
    if not ans:
        return ans
    # A) 볼드-퍼센트 글리치
    ans = re.sub(r"\*\*\s*(\d+(?:[.,]\d+)?)\s*\*\*\s*%", r"**\1%**", ans)
    ans = re.sub(r"(\d(?:[.,]\d+)?)\s*\*\*\s*%", r"\1%", ans)
    ans = re.sub(r"(\d(?:[.,]\d+)?)\s*\*\*\s*(?=[(（])", r"\1", ans)
    # B) 후처리 흉터
    ans = re.sub(r"참고\s*문서\s*아래\s*참고\s*문서", "참고 문서", ans)
    ans = re.sub(r"자료\s*원문\s*아래\s*참고\s*문서", "자료 원문", ans)
    ans = re.sub(r"제공된\s*자료\s*아래\s*참고\s*문서", "아래 참고 문서", ans)
    lines = ans.split("\n")
    # C) 깨진 번호목록 병합
    merged = []
    i = 0
    while i < len(lines):
        cur = lines[i]
        if re.fullmatch(r"\s*\d+[.)]\s*", cur) and i + 1 < len(lines) and lines[i + 1].strip():
            merged.append(cur.rstrip() + " " + lines[i + 1].lstrip())
            i += 2
            continue
        merged.append(cur)
        i += 1
    lines = merged
    # D) 연속 중복 줄 제거(목록마커·공백 무시)
    def _key(ln):
        k = re.sub(r"^\s*(?:\d+[.)]|[-*•])\s*", "", ln)
        return re.sub(r"\s+", "", k)
    dedup = []
    prev = None
    for ln in lines:
        k = _key(ln)
        if k and k == prev:
            continue
        dedup.append(ln)
        prev = k if k else prev
    lines = dedup
    # E) 홀수 '**' 정리 + bare-amount orphan 제거
    fixed = []
    for ln in lines:
        if ln.count("**") % 2 == 1:
            idx = ln.rfind("**")
            ln = ln[:idx] + ln[idx + 2:]
        if re.fullmatch(r"\s*\d[\d,.]*\s*만?\s*원\s*입니다\.?\s*", ln):
            prevne = next((x for x in reversed(fixed) if x.strip()), "")
            if re.search(r"만\s*원", prevne):
                continue
        fixed.append(ln)
    ans = "\n".join(fixed)
    # F) 선두 빈 줄 제거 + 과다 빈 줄 축소
    ans = re.sub(r"^\s*\n+", "", ans)
    ans = re.sub(r"\n{3,}", "\n\n", ans)
    return ans.strip()


@app.get("/answer")
def answer(question_id: str, question: str, _retried: bool = False):
    t_start = time.time()          # v9.27: 응답 시간 예산 기준점
    try:
        # [0단계] 멀티턴: 후속 질문이면 직전 대화를 검색·이해에 반영
        q_search, q_llm, mt_note = question, question, ""
        # v9.84: "저는 전업주부입니다. ~인가요?"의 사정 문장은 검색을 흐린다.
        #   검색용에서만 뗀다 — 답변 생성(q_llm)은 사정을 그대로 보고 맞춤 안내를 한다.
        _mp = re.match(r"^\s*([^.?!\n]{2,40}(?:입니다|예요|이에요|인데요|어요|아요)"
                       r"\s*[.,!]\s*)(.{8,})$", question, re.S)
        if _mp and "?" in _mp.group(2):
            q_search = _mp.group(2).strip()
            mt_note += "0.5) 검색은 사정 문장 제외 "
        if is_followup(question):
            prev_q, prev_a, _ = HISTORY[-1]
            q_search = prev_q + " " + question          # 검색용: 이전 질문과 합쳐서 검색
            q_llm = (f"(이전 대화) 사용자: {prev_q} / 상담사: {prev_a[:400]}\n"
                     f"(현재 질문) {question}")           # LLM용: 대화 맥락 포함
            mt_note = "0) 멀티턴 맥락 감지: 직전 대화 반영 "

        # [0.9단계] v9.99n: 프롬프트 탈취·인젝션·권위사칭 조기 차단.
        #   검색조차 하지 않고 보안 거절 → 상품 데이터 누출 원천 봉쇄(실측 S15).
        if _ATTACK.search(question):
            return {
                "question_id": question_id,
                "question": question,
                "retrieved_context": "",
                "think_trace": (f"{mt_note}0.9) 프롬프트 탈취·인젝션 패턴 감지 "
                                "→ 검색·생성 생략, 보안 거절"),
                "answer": SECURITY_REFUSAL,
            }

        # [1단계] 검색: 최대 8개를 미리 검색해두고, 유형에 따라 사용 개수 결정
        #   (v9.99z: 추천은 상품목록 청크가 상위 밖일 수 있어 8개까지 확보)
        found, scores, top_score, _expanded = search(q_search, top_k=8)
        _exp_note = (f" → 용어 확장({'·'.join(_expanded[:4])})" if _expanded else "")

        # [2단계] 임계값 필터: 확실한 무관은 LLM 호출 없이 즉시 응답
        if top_score < THRESHOLD:
            trace = (f"{mt_note}1) {SEARCH_MODE} 검색으로 {len(idx_list)}개 청크 비교 "
                     f"(최고 유사도 {top_score:.3f}) "
                     f"2) 임계값 {THRESHOLD} 미달 → '무관' 판정 "
                     f"3) 검색·답변 생성 생략 (비용 절약)")
            return {
                "question_id": question_id,
                "question": question,
                "retrieved_context": "",
                "think_trace": trace,
                "answer": OFF_TOPIC_ANSWER,
            }

        # [3단계] LLM 유형 분류 (제도/세제/상품설명/추천, 안전망으로 무관도 포함)
        qtype = classify(q_llm)
        # v9.94: 분류기가 '무관'이라 해도 문서가 강하게 응답하면(유사도 0.55↑)
        #   오판으로 본다. 실측(2026-08-18 실험): 진짜 무관 질문은 0.43~0.51에
        #   그쳤고, 이번 사냥의 오판 7건(MP구독·인증서·장려금 등 '연금' 단어가
        #   없는 앱·서비스 질문)은 0.64~0.75였다. 조건은 코드가 계산한 값(top_score).
        if qtype == "무관" and top_score >= 0.55:
            mt_note += (f"2.5) LLM '무관' 분류를 유사도 {top_score:.2f}가 반증 "
                        f"→ '제도'로 진행 ")
            qtype = "제도"
        if qtype == "무관":  # 유사도는 높지만 LLM이 무관으로 판단한 경우 (2차 방어)
            trace = (f"{mt_note}1) {SEARCH_MODE} 검색으로 {len(idx_list)}개 청크 비교 "
                     f"(최고 유사도 {top_score:.3f}) "
                     f"2) 임계값 통과했으나 LLM 분류 결과 '무관' → 답변 생성 생략")
            return {
                "question_id": question_id,
                "question": question,
                "retrieved_context": "",
                "think_trace": trace,
                "answer": OFF_TOPIC_ANSWER,
            }

        # [4단계] 유형별 전략: 검색 개수 + 전용 프롬프트 + 유형별 '행동'
        config = TYPE_CONFIG[qtype]
        system = config["system"]
        k = config["top_k"]
        action_note = ""  # trace에 남길 행동 기록
        was_askback = False  # 이번 답변이 되묻기였는지 (멀티턴 후속 판정용)
        ask_line = None      # v9.31: 코드가 보장할 질문 문장 (앞/뒤 위치 포함)
        is_conflict = False  # 성향 표현이 모순인지 (검색 보강 전략 분기용)

        # [4-0] 복합 질문 감지 (v7.8): 여러 요구사항이 담긴 질문은
        # 문서를 더 검색하고 "빠짐없이 답하라" 지시를 추가 (평가지표 '요구사항 충족' 대응)
        MULTI_HINTS = ("그리고", "또한", " 및 ", "각각", "도 알려", "도 궁금",
                       "뭐고", "얼마고", "어떻게 되고", "이랑 ", "랑 ")
        is_multi = (question.count("?") >= 2 or
                    (len(question) >= 30 and any(h in question for h in MULTI_HINTS)))
        if is_multi:
            k = max(k, 5)
            system = system + (
                "\n- 이 질문에는 여러 요구사항이 담겨 있어. 요구사항을 각각 항목으로 "
                "나눠서 하나도 빠짐없이 답해. 일부만 답하고 끝내지 마."
            )
            action_note += " + 복합 질문 감지(문서 5개, 누락 금지)"

        used = found[:k]
        context = "\n\n".join(f"[문서{i+1}] (출처: {c['source']})\n{c['text']}"
                              for i, c in enumerate(used))

        # [4-c] 상품설명 → 비교 질문이면 비교 테이블 모드 (문서 5개 + 표 생성 지시)
        if qtype == "상품설명" and any(kw in q_llm for kw in COMPARE_KEYWORDS):
            system = COMPARE_SYSTEM
            k = 5
            used = found[:k]
            context = "\n\n".join(f"[문서{i+1}] (출처: {c['source']})\n{c['text']}"
                                  for i, c in enumerate(used))
            action_note += " → 비교 질문 감지: 비교 테이블 모드"

        # [4-b-0] v9.38: 근거 필터 — 관련도가 낮은 문서는 근거에서 뺀다.
        #   평가지표 '근거 완전성(대상이 다른 근거 배제)'에 대응하며,
        #   무엇을 왜 뺐는지 trace에 남겨 판단 근거를 드러낸다.
        used_scores = scores[:len(used)]
        _n_before = len(used)
        _thr = max(max(used_scores) * REL_RATIO, REL_FLOOR) if used_scores else 0
        used, used_scores, dropped = filter_by_relevance(used, used_scores)
        if dropped:
            context = "\n\n".join(f"[문서{i+1}] (출처: {c['source']})\n{c['text']}"
                                   for i, c in enumerate(used))
            action_note += (f" → 근거 필터(기준 {_thr:.3f}): {_n_before}개 중 {len(used)}개 사용"
                            f", 관련도 낮은 {len(dropped)}개 제외({', '.join(str(x) for x in dropped)})")
        else:
            # v9.39: 제외가 없어도 '검사했다'는 사실을 남긴다 — 근거 완전성의 증거
            action_note += (f" → 근거 필터(기준 {_thr:.3f}): {_n_before}개 모두 "
                            f"관련도 충족")

        # [4-a-000] v9.70: 검색이 놓치는 필수 근거를 코드가 직접 찾아 넣는다
        _must = find_must_chunks(question, used)
        if _must:
            used = used + _must
            context = "\n\n".join(f"[문서{i+1}] (출처: {c['source']})\n{c['text']}"
                                   for i, c in enumerate(used))
            action_note += (" → 필수 근거 보강("
                            + ", ".join(c["source"] for c in _must) + ")")

        # [4-a-00] v9.20: 수수료 질문이면 보수표 청크를 검색 결과에 강제로 보강한다
        if any(w in question for w in FEE_WORDS):
            srcs = []
            for c in used:
                if c["source"] not in srcs:
                    srcs.append(c["source"])
            extra = find_fee_rows(srcs, used, limit=2)
            if extra:
                used = used + extra
                context = "\n\n".join(f"[문서{i+1}] (출처: {c['source']})\n{c['text']}"
                                       for i, c in enumerate(used))
                # v9.21: 숫자표를 그대로 두면 항목이 누락된다 → 코드가 정리한 카드를 위에 붙인다
                cards = []
                for c in extra:
                    card = build_fee_card(c["text"], c["source"])
                    if card and card not in cards:
                        cards.append(card)
                if cards:
                    context = "\n\n".join(cards) + "\n\n" + context
                action_note += (f" → 보수표 청크 보강({len(extra)}개"
                                f"{', 구성표 카드 ' + str(len(cards)) + '개' if cards else ''})")

        # [4-a-05] v9.63: 근거에 깨진 청크가 섞이면 '이어 붙이지 마라'를 못박는다
        _garb = [(c["source"], garble_score(c["text"])) for c in used]
        _bad_g = [x for x in _garb if x[1] >= GARBLE_WARN]
        if _bad_g:
            context = OCR_CARD + "\n\n" + context
            action_note += (" → 원문 인식 주의 카드("
                            + ", ".join(f"{s2} {g2}" for s2, g2 in _bad_g[:3]) + ")")

        # [4-a-04] v9.44: 위험등급을 그 문서의 전체 청크에서 읽어 카드로 못박는다 (이력 배제)
        _rsrc = []
        for _c in used:
            if _c["source"] not in _rsrc:
                _rsrc.append(_c["source"])
        risk_prof = extract_risk_profile(_rsrc)
        if len(risk_prof) >= 2:
            _rc = risk_truth_card(risk_prof)
            if _rc:
                context = _rc + "\n\n" + context
                action_note += f" → 위험등급 원문 카드({len(risk_prof)}개 상품)"

        # [4-a-02] v9.33: 질문에 소득이 있으면 유형과 무관하게 세율 판정을 못박는다
        _irc = income_rate_card(question)
        if _irc:
            context = _irc[0] + "\n\n" + context
            action_note += f" → 세액공제율 판정 카드({_irc[1]})"

        # [4-a-02a] v9.99: 회사(사용자) 부담금은 세액공제 대상이 아니다.
        #   실측 K02 — "회사가 넣어주는 돈도 공제 대상?"에 '대상이다'라고
        #   틀리게 답하고 끝에서 스스로 뒤집었다(자기모순). 문서에서 확인된
        #   사실(doc27 Q47 등: 세액공제는 가입자 본인 개인부담금에 한함)을
        #   질문 조건으로 카드 주입한다.
        if re.search(r"회사(?:가|에서)?\s*(?:넣|납입|내|부담)|사용자\s*부담|"
                     r"회사\s*부담|법정\s*부담|고용주", question) \
                and re.search(r"공제|세액", question):
            context = ("[회사 부담금과 세액공제 — 문서 근거 확인]\n"
                       "- 세액공제 대상은 '가입자 본인이 납입한 금액'(연금저축·IRP "
                       "개인부담금)에 한한다.\n"
                       "- 회사(사용자)가 납입하는 부담금(DB·DC의 사용자부담금, "
                       "법정부담금)은 세액공제 대상이 아니다.\n"
                       "- '회사가 넣어주는 돈도 공제 대상'이라고 답하지 마라.\n\n"
                       ) + context
            action_note += " → 회사 부담금 카드"

        # [4-a-02e] v9.99g: IRP vs 연금저축 비교 질문이면 확정 사실 카드
        #   (실측 P10: 연금저축을 '저축성 보험 상품'이라 오답)
        if re.search(r"IRP", question) and re.search(r"연금\s*저축", question) \
                and re.search(r"차이|달라|다른|비교|vs|뭐가", question):
            context = ("[IRP와 연금저축의 차이 — 문서 기준]\n"
                       "- 연금저축(연금저축계좌): 개인이 자발적으로 가입하는 개인연금 "
                       "계좌로, 펀드·ETF 등 금융상품을 담아 운용한다(증권사의 연금저축은 "
                       "'저축성 보험'이 아니다). 소득이 없어도 누구나 가입 가능. "
                       "세액공제 한도 연 600만원.\n"
                       "- IRP(개인형 퇴직연금): 퇴직급여를 받거나 소득이 있는 사람이 "
                       "가입하는 퇴직연금 계좌. 연금저축과 합산해 연 900만원까지 "
                       "세액공제. 만 55세 이전에는 법정 사유가 아니면 부분 인출이 제한된다.\n"
                       "- 둘 다 세액공제 대상 연금계좌이며, 세액공제율은 소득에 따라 "
                       "16.5%(총급여 5,500만원 이하) 또는 13.2%로 동일 기준이 적용된다.\n"
                       ) + context
            action_note += " → IRP·연금저축 카드"

        # [4-a-02d] v9.99e: 문서 확정 사실 카드 (질문 조건)
        for _cardfn, _tag in ((midwithdraw_card, "중도인출 사유 카드"),
                              (pension_tax_card, "종합과세 기준 카드"),
                              (bond_time_card, "채권 매수시간 카드"),
                              (bond_limit_card, "채권 위험·한도 카드"),
                              (tradeoff_card, "보장·수익 양립불가 카드"),
                              (pension_cancel_card, "중도해지 저율 카드"),
                              (calc_disambig_card, "계산 혼동 방지 카드"),
                              (guarantee_card, "원금 보장 카드")):
            _cd = _cardfn(question)
            if _cd:
                context = _cd + "\n\n" + context
                action_note += f" → {_tag}"

        # [4-a-02c] v9.99: doc27은 '과학기술인공제회(과기공)' 전용 FAQ다.
        #   실측 K17·K18 — "회사 옮기는데 퇴직연금?" 같은 일반 질문에 과기공
        #   전용 절차(부담금 납부 유예, 공제회 이관, 발전장려금)를 일반 답변으로
        #   끌어왔다. 질문에 과기공 맥락이 없으면 주의 카드를 붙인다.
        if any(c.get("source") == "doc27.pdf" for c in used) \
                and not re.search(r"과학기술|공제회|과기공|출연연|SEMA", question):
            context = ("[근거 사용 주의]\n"
                       "- 아래 문서 중 일부는 '과학기술인공제회(과기공)' 가입자 "
                       "전용 안내다. 부담금 납부 유예, 공제회 이관, 발전장려금 등 "
                       "과기공 고유 절차를 일반 퇴직연금·연금저축 질문의 답으로 "
                       "제시하지 마라.\n"
                       "- 세제·한도처럼 일반적으로 통용되는 사실만 인용하라.\n\n"
                       ) + context
            action_note += " → 과기공 문서 주의 카드"

        # [4-a-02b] v9.96: 한도 '변천 시점' 질문 — 문서 근거로 확인된 시점을 카드로.
        #   실측 T01: doc27에 '2023.1.1 이후 납입분부터 적용'이 있는데도 시점이 든
        #   청크를 못 가져와 통째로 거절했다. 수치·시점은 문서에서 확인된 값이다
        #   (doc27 Q51, doc23 — BASE_RULES 변천 지침과 동일).
        if re.search(r"언제부터|언제 바뀌|바뀐 게|바뀌었|변경됐|변경되|늘어났|인상", question) \
                and re.search(r"600|900|400|한도|세액공제", question):
            context = ("[세액공제 한도 변천 — 문서 근거 확인]\n"
                       "- 2023년 1월 1일 납입분부터: 연금저축 600만원, "
                       "연금저축+IRP 합산 900만원 한도가 적용된다\n"
                       "- 그 이전의 연금저축 세액공제 한도는 400만원이었다\n"
                       "- 질문이 '언제부터'를 물으면 위 시점을 명확히 답하라\n\n") + context
            action_note += " → 한도 변천 카드"

        # [4-a-01] v9.26: 알려진 단위 오표기가 검색 문서에 있으면 주의 카드를 붙인다
        num_card, num_hits = build_number_card(context)
        if num_card:
            context = num_card + "\n\n" + context
            action_note += f" → 표기 주의 카드({len(num_hits)}건)"

        # [4-a-00] v9.94: 질문이 문서 FAQ의 질문과 사실상 같으면 코드가 못박는다
        #   (정답 청크를 주고도 '확인할 수 없다'로 회피하는 것을 차단)
        # v9.95: 카드가 '근거로 뽑힌 3개'만 보면, FAQ 일치 청크가 4~5위라
        #   잘려나간 경우(실측 [8][16] — 질문이 문서 Q와 글자까지 같은데 거절)
        #   카드가 못 붙는다. 검색된 5개 전체에서 일치를 찾고, 그 청크가
        #   근거에 없으면 강제로 편입한다.
        _fm = faq_match_line(q_search, context)
        if not _fm:
            for _fc in found:
                _t = faq_match_line(q_search, _fc["text"])
                if _t:
                    used.append(_fc)
                    context = (context + "\n\n[추가 근거] (출처: "
                               + _fc["source"] + ")\n" + _fc["text"])
                    action_note += " → FAQ 일치 청크 편입"
                    _fm = _t
                    break
        if _fm:
            context = ("[근거 문서에 같은 질문이 있다]\n"
                       f"- 문서 원문: {_fm}\n"
                       "- 근거 문서에서 위 질문 항목의 바로 아래에 적힌 답을 그대로 "
                       "근거로 삼아 답하라.\n"
                       "- 이 질문에 대해 '자료에서 확인할 수 없다'거나 '명시되어 있지 "
                       "않다'고 답하는 것은 금지다 — 문서가 이 질문을 직접 다루고 있다.\n\n"
                       ) + context
            action_note += " → FAQ 일치 카드"

        # [4-a-0] v9.17: 수수료·보수를 묻는 질문이면 인용 기준을 코드로 못박는다
        if any(w in question for w in FEE_WORDS):
            fee_vals = detect_fee_values(context)
            if len(fee_vals) >= 2:
                context = FEE_NOTE.format(vals=", ".join(fee_vals[:12])) + "\n\n" + context
                action_note += f" → 수수료 인용 규칙 주입(값 {len(fee_vals)}종)"

        # [4-a-03] v9.35: 공제 대상이 아닌 돈이 섞이면 계산기를 끄고 판정 카드를 준다
        _sc = deduction_scope_card(question)
        scope_card, scope_rules = (_sc if _sc else (None, []))
        if scope_card:
            context = scope_card + "\n\n" + context
            action_note += " → 공제 대상 판정 카드(계산기 생략)"

        # [4-a] 세제 → 계산기 실행: 질문에 연봉·납입액이 있으면 파이썬으로 직접 계산
        calc_vals = None
        band_vals = None      # v9.55: 소득 미상 구간 계산 결과 (없으면 None)
        paid_only = None
        sup_flag = False    # v9.23: 최상급·순위 요구 여부
        forced_pairs = []   # v9.18: 반드시 답변에 들어가야 할 (기한, 근거 문장)
        # v9.15: 세액공제 '한도'를 묻는 질문이면 한도 구조를 코드로 못박는다
        if qtype == "세제" and any(k in question for k in LIMIT_Q) \
                and any(k in question for k in LIMIT_Q2):
            context = LIMIT_CARD + "\n\n" + context
            action_note += " → 한도 구조 카드 주입"
        if qtype == "세제" and not scope_card:   # v9.35: 금액이 섞였으면 계산기 미실행
            info = extract_json(TAX_EXTRACT_SYSTEM, q_llm)
            salary = to_num(info.get("총급여"))
            paid = to_num(info.get("납입액"))
            if salary and paid:
                _lim, _lab = pension_limit(question)     # v9.32: 상품별 한도
                calc_result, calc_vals = calc_pension_tax_credit(salary, paid, _lim, _lab)
                context = calc_result + "\n\n" + context
                action_note += (f" → 계산기 실행 (총급여 {int(salary):,}만원, "
                               f"납입액 {int(paid):,}만원, {_lab} 한도 {_lim}만원)")
            elif paid:
                # v9.14: 소득을 모르면 한쪽 세율만 찍거나 두 세율을 더하는 오답이 난다
                #        → 구간별로 미리 계산해 넣어 준다
                _lim, _lab = pension_limit(question)     # v9.32: 상품별 한도
                band_result, band_vals = calc_tax_credit_bands(paid, _lim, _lab)
                context = band_result + "\n\n" + context
                paid_only = paid
                action_note += f" → 구간별 계산기 (소득 미상, 납입액 {int(paid):,}만원)"

        # [4-b] 추천 → 되묻기: 나이·투자성향 정보가 없으면 답변 대신 질문
        if qtype == "추천":
            info = extract_json(RECO_EXTRACT_SYSTEM, q_llm)
            age = info.get("나이대")
            risk = info.get("투자성향")
            if not age and not risk:
                system = ASK_BACK_SYSTEM
                was_askback = True
                ask_line = ("head", ASK_BOTH_LINE)   # v9.31: 답변 맨 앞에 질문
                action_note += " → 사용자 정보 없음: 되묻기 모드"
            else:
                system = system + (
                    f"\n- 사용자 정보: 나이대={age or '모름'}, 투자성향={risk or '모름'}. "
                    "이 정보에 맞는 선택 기준을 중심으로 답변해."
                )
                action_note += f" → 맞춤 모드 (나이대={age or '?'}, 투자성향={risk or '?'})"

                # v9.4: 나이는 있지만 성향을 모르는 경우 — 성향을 가정하지 말고 되물어라
                if not risk:
                    system += (
                        "\n- 사용자의 투자성향 정보가 없다. 성향에 따라 적합한 상품이 크게 "
                        "달라지므로 '안정적인 투자를 원하신다면'처럼 성향을 임의로 가정한 뒤 "
                        "단정적으로 추천하지 말고, 성향별로 선택지를 나눠 제시해.\n"
                        "- 그리고 답변의 **맨 마지막 문장**은 반드시 투자성향을 확인하는 "
                        "질문으로 끝내라. 물음표로 끝나는 한 문장이어야 한다. "
                        "예: '혹시 투자 성향이 원금 보전을 중시하는 안정형에 가까우신가요, "
                        "아니면 손실 위험을 감수하더라도 수익을 추구하는 공격형에 가까우신가요?' "
                        "이 확인 질문을 빠뜨리지 마라."
                    )
                    action_note += " + 성향 미상: 확인 요청 지시"
                    ask_line = ("tail", ASK_RISK_LINE)   # v9.31: 답변 맨 뒤에 질문

                # [4-b-1.5] 성향 모순 감지 (v8.6): 추출 결과가 아니라 '질문 원문'에서
                # 직접 감지 — LLM 추출이 흔들려도 코드가 확정적으로 발동
                _q = q_llm
                if (any(k in _q for k in ["안정", "보수적", "원금 보장", "원금보장"])
                        and any(k in _q for k in ["공격", "고수익"])):
                    is_conflict = True
                    system += (
                        "\n- 주의: 사용자의 성향 표현이 서로 모순돼 (안정 지향과 공격 지향이 "
                        "함께 있음). 답변 첫머리에서, 사용자가 말한 자산 배분이 실제로는 어떤 "
                        "투자 성향(예: 주식 비중이 높으면 성장·적극형)에 해당하는지 명확히 "
                        "짚어준 다음에 상품을 안내해. 모순을 못 본 척 넘어가지 마.\n"
                        "- 상품을 고를 때는 성향 라벨이 아니라 사용자가 말한 '실제 비중'을 "
                        "기준으로 삼아. 예를 들어 주식 70%를 원한다고 했으면 주식 비중이 높은 "
                        "상품(주식형·성장형·주식 비중이 큰 자산배분형)을 1순위로 제시하고, "
                        "채권 비중이 훨씬 큰 상품(예: 채권 90%)을 먼저 권하지 마.\n"
                        "- 사용자가 원하는 비중에 맞는 상품이 참고 문서에 없다면, 억지로 "
                        "채권 위주 상품을 권하는 대신 '자료에서 해당 비중의 상품은 확인되지 "
                        "않는다'고 밝히고, 주식형과 채권형을 원하는 비율로 나눠 담는 방법을 안내해."
                    )
                    action_note += " + 성향 모순 감지(비중 우선 지시 주입)"

            # [4-b-2] 상품 검색 보강: 투자설명서 청크를 추가로 검색해서
            # 문서에 실제 등장하는 상품을 예시로 들 수 있게 함
            # v7.3: 성향에 맞는 상품 설명서가 검색되도록 보강 검색어를 성향별로 조정
            try:
                extra_kw = " 연금 펀드 상품 투자설명서 수수료 위험등급"
                risk_str = str(risk or "")
                if is_conflict:
                    # v8.7: 모순 성향이면 주식형 + 자산배분(혼합)형을 함께 확보해
                    # 원하는 비중대로 조합할 재료를 준다
                    extra_kw += (" 주로 주식에 투자하는 주식형 성장 투자신탁(주식) "
                                 "자산배분 혼합형 주식 비중")
                    extra_n = 4
                elif any(k in risk_str for k in ["공격", "고수익", "성장", "주식"]):
                    # 문서가 실제로 쓰는 표현으로 검색 (BM25 정확 매칭 유도)
                    extra_kw += " 주로 주식에 투자하는 주식형 성장 투자신탁(주식)"
                    extra_n = 3
                elif any(k in risk_str for k in ["안정", "보수", "원금", "안전"]):
                    extra_kw += " 채권에 주로 투자하는 채권형 안정형 원리금보장"
                    extra_n = 3
                else:
                    extra_n = 3
                extra_found, _, _, _ = search(q_search + extra_kw, top_k=extra_n)
                seen = {c["text"] for c in used}
                added = [c for c in extra_found if c["text"] not in seen]
                if added:
                    used = used + added
                    context = "\n\n".join(f"[문서{i+1}] (출처: {c['source']})\n{c['text']}"
                                          for i, c in enumerate(used))
                    action_note += f" + 상품 검색 보강({len(added)}개 문서 추가)"
            except Exception:
                pass  # 보강 실패해도 기본 검색 결과로 진행

            # [4-b-3] v10.1: 'ETF 종목 추천'이면 ETF 상품목록 청크를 메인 질문과
            #   독립적으로 한 번 더 확보한다(실측: 메인 검색이 ETF 목록을 놓쳐 0개가
            #   되는 run 방지 — 문서엔 상품이 있는데 검색 순위에서 밀렸다).
            if re.search(r"ETF|이티에프|상장지수", question):
                try:
                    etf_found, _, _, _ = search(
                        "TIGER ETF 설정액 합성총보수 위험등급 상장지수 종목 수익률", top_k=4)
                    _seene = {c["text"] for c in used}
                    _adde = [c for c in etf_found if c["text"] not in _seene]
                    if _adde:
                        used = used + _adde
                        context = "\n\n".join(
                            f"[문서{i+1}] (출처: {c['source']})\n{c['text']}"
                            for i, c in enumerate(used))
                        action_note += f" + ETF 목록 보강({len(_adde)}개)"
                except Exception:
                    pass
                # [4-b-4] v10.2: 문맥에서 실제 ETF 상품명을 뽑아 '이 목록 안에서만
                #   추천하라' 카드로 주입한다(실측: 문맥에 상품이 있는데도 모델이 이름을
                #   지어내 창작 방어에 다 지워지는 run 방지 — 생성 충실도 강제).
                try:
                    # 미래에셋 ETF 브랜드(TIGER)만 카드에 담는다 — 경쟁사 브랜드 제외
                    _names = re.findall(r"TIGER\s?[가-힣A-Za-z0-9()&·\-+]+", context)
                    _uniq = []
                    for _nm in _names:
                        _nm = _nm.strip()
                        # 통계 꼬리가 붙었으면 잘라낸다(설정액/보수/위험/숫자 앞에서 끊기)
                        _nm = re.split(r"\s*(?:설정액|총보수|합성총보수|보수|위험|수익|"
                                       r"종류|클래스|\d)", _nm)[0].strip()
                        if len(_nm) >= 6 and _nm not in _uniq:
                            _uniq.append(_nm)
                    if len(_uniq) >= 2:
                        _etf_card = (
                            "[문서에서 확인된 ETF 상품 — 추천은 반드시 이 목록에서만 하라]\n"
                            + " / ".join(_uniq[:14]) + "\n"
                            "위 목록에 없는 ETF 이름을 새로 만들지 마라. 사용자의 성향에 "
                            "맞는 상품을 이 목록에서 골라, 각 상품의 특징·추천 이유·유의사항과 "
                            "함께 제시하라. 목록의 상품명은 여기 적힌 그대로(정확히) 써라.")
                        context = _etf_card + "\n\n" + context
                        action_note += f" + ETF 상품카드({len(_uniq)}종)"
                except Exception:
                    pass

        # [4-f] v9.3: 복합 질문은 요구사항 단위로 쪼개 각각 추가 검색한다.
        # (유형이 하나로 분류되면 다른 영역 요구사항의 문서가 검색되지 않는 문제 대응.
        #  예: '대리가입? 동시가입? 추천해줘' → '추천'으로 분류되어 제도 문서 누락)
        multi_parts = []
        if is_multi:
            try:
                parts = [p.strip() for p in re.split(r"[?？.!\n]", question)
                         if len(p.strip()) >= 8]
                multi_parts = parts[:5]
                seen_txt = {c["text"] for c in used}
                added_multi = 0
                for p in parts[:3]:
                    if added_multi >= 4:
                        break
                    sub, _, _, _ = search(p, top_k=2)
                    for c in sub:
                        if c["text"] not in seen_txt and added_multi < 4:
                            used.append(c)
                            seen_txt.add(c["text"])
                            added_multi += 1
                if added_multi:
                    context = "\n\n".join(f"[문서{i+1}] (출처: {c['source']})\n{c['text']}"
                                          for i, c in enumerate(used))
                    action_note += f" + 요구사항별 분할 검색({added_multi}개 문서 추가)"
            except Exception:
                pass  # 분할 검색 실패해도 기본 검색 결과로 진행

        user_msg = f"참고 문서:\n{context}\n\n질문: {q_llm}"

        # [4-d] v9.2: 놓치면 안 되는 '기한' 정보를 문서에서 정규식으로 추출해
        # 프롬프트 최상단에 못박는다 (프롬프트 규칙만으로는 누락되는 문제 대응)
        # v9.13: 숫자만 넘기면 LLM이 엉뚱한 절차에 갖다 붙인다(실제 오류: '세액공제 신청
        #   60일 이내'). → 기한이 들어 있는 '문장'을 통째로 넘겨 무엇의 기한인지 알려준다.
        dpat = re.compile(r"\d+\s*(?:영업일|일|개월|년)\s*(?:이내|내에|안에|까지)")
        # v9.49: '2022년 12월 31일까지'의 '31일까지'를 기한으로 잡던 버그.
        #   기한 표현 앞에 '월' 또는 '년'이 오면 그것은 날짜의 꼬리다.
        _DATE_TAIL = re.compile(r"(?:\d+\s*월|\d{4}\s*년)\s*$")
        # 이미 적용이 끝난 조항은 '기한'이 아니다 (실측: 50세 이상 특례, 2022.12.31 종료)
        _EXPIRED = re.compile(r"(\d{4})\s*년[^.]{0,20}?까지\s*적용")

        def _real_deadlines(sent):
            out = []
            for m in dpat.finditer(sent):
                if _DATE_TAIL.search(sent[max(0, m.start() - 12):m.start()]):
                    continue
                out.append(re.sub(r"\s+", " ", m.group(0)))
            return out
        # v9.53: PDF 쪽번호·머리글이 문장 앞에 붙어 그대로 노출됐다
        _JUNK = re.compile(r"[-–—]?\s*\d+\s*/\s*\d+\s*(?:Mirae\s+Asset\s+Securities)?\s*"
                           r"|^\s*[-–—]\s*\d+\s*[-–—]\s*")

        def _clean_sent(t):
            t = _JUNK.sub(" ", t)
            return re.sub(r"\s{2,}", " ", t).strip(" -–—·")

        deadline_sents, deadlines = [], []
        for sent in re.split(r"(?<=[.!?])\s+|\n+", context):
            sent = re.sub(r"\s+", " ", sent).strip()
            if not sent:
                continue
            _ex = _EXPIRED.search(sent)
            if _ex and int(_ex.group(1)) < 2026:      # 이미 끝난 조항
                continue
            _hits = _real_deadlines(sent)
            if not _hits:
                continue
            if len(sent) > 220:            # 너무 긴 문장은 기한 주변만 발췌
                m = dpat.search(sent)
                sent = "…" + sent[max(0, m.start() - 90):m.end() + 90] + "…"
                _hits = _real_deadlines(sent) or _hits
            sent = _clean_sent(sent)
            # v9.66: 깨진 문장을 기한으로 보여주면 그대로 사용자에게 나간다
            if sent and garble_score(sent) >= GARBLE_STRICT:
                continue
            # v9.66: 숫자표가 통째로 딸려 오면 구 기준 세율 등이 섞인다
            if sent and len(re.findall(r"\d+\.\d+\s*%", sent)) >= 2:
                continue
            # v9.68: '|'나 '#'가 든 것은 표·머리글 조각이다. 문장으로 읽히지 않는다.
            if sent and ("|" in sent or "#" in sent):
                continue
            if sent and sent not in deadline_sents:
                deadline_sents.append(sent)
                deadlines.extend(_hits)
        if deadline_sents:
            seen = []
            for h in deadlines:
                if h not in seen:
                    seen.append(h)
            # v9.15: 질문과 '같은 절차'를 다루는 기한 문장은 누락되면 안 되므로 강제로 격상한다.
            #   (v9.13에서 완화했더니 R13의 60일이 간헐적으로 빠짐)
            #   판정: 질문에서 뽑은 어절 앞 3글자가 그 문장에 2개 이상 나타나면 '관련 있음'
            #   v9.19: '앞 3글자 일치'는 한국어 복합어에서 실패한다
            #     (질문 '연금계좌' vs 문서 '연금저축계좌' → 연금계 ≠ 연금저)
            #     검색에 쓰는 바이그램 토크나이저로 바꿔 겹치는 2글자 조각 수로 판정한다
            q_grams = {g for g in _tok(question) if len(g) == 2}
            # v9.54: 기한은 '무엇을 언제까지 하느냐'다. 질문이 그 행위를 다루지
            #   않으면(예: 가입 자격 문의) 어떤 기한도 관련이 없다.
            #   겹침 숫자만으로는 못 가른다 — R13('넣으면')과 A43('가입할 수 있어요')이
            #   똑같이 겹침 2였다.
            _ACTS = ("넣", "납입", "입금", "이전", "이체", "옮기", "옮겨", "전환", "만기",
                     "인출", "해지", "수령", "지급받", "이월", "예치", "적립", "출금")
            _has_act = any(a in question for a in _ACTS)
            related, rel_score = [], {}
            if _has_act:
                for t in deadline_sents[:4]:
                    hit = len(q_grams & {g for g in _tok(t) if len(g) == 2})
                    if hit >= 2:
                        related.append(t)
                        rel_score[t] = hit
            head = ("[문서에 명시된 기한 — 아래 문장을 읽고 '무엇의 기한인지' 확인하라]\n"
                    + "\n".join(f"· {t}" for t in deadline_sents[:4])
                    + "\n※ 각 기한은 그 문장에 적힌 절차에만 적용된다. 질문한 절차와 "
                      "직접 관련된 기한만 답변에 쓰고, 관련 없으면 아예 언급하지 마라. "
                      "문서에 없는 기한(예: '세액공제 신청 기한')을 만들어내면 안 된다.\n")
            rel_h = []
            if related:
                for t in related:
                    for h in _real_deadlines(t):
                        if h not in rel_h:
                            rel_h.append(h)
                if not rel_h:
                    related = []
                head += ("★ 이 중 다음 기한은 질문한 절차와 직접 관련된다: "
                         + ", ".join(rel_h[:3])
                         + ". 답변에서 반드시 이 기한을 명시하라. 빠뜨리면 오답이다.\n")
                action_note += (f" + 기한 강제({', '.join(rel_h[:2])}, "
                                f"겹침 {max(rel_score.values())})")
                # v9.18: 프롬프트로 강제해도 간헐적으로 빠져서(R13) 코드로 보강한다
                for t in related:
                    for h in _real_deadlines(t):
                        num = re.sub(r"\s+", "", re.match(r"\d+\s*(?:영업일|일|개월|년)", h).group(0))
                        if all(num != n for n, _ in forced_pairs):
                            forced_pairs.append((num, t))
            else:
                action_note += (f" + 기한 문맥 제공({', '.join(seen[:3])}"
                                f"{'' if _has_act else ', 행위 없음→강제 안 함'})")
            user_msg = head + "\n" + user_msg

        # [4-e] v9.8: (제거) 문서의 세율을 무작정 상단에 노출하던 방식은
        # 질문과 무관한 세율(예: 금융소득 15.4%)을 부각시켜 오답을 유도했다.
        # 대신 세제 프롬프트의 세목별 규칙으로 대체한다.

        # [4-h] v9.4: 복합 질문은 쪼갠 요구사항을 그대로 나열해 답변 누락을 막는다
        # ("빠짐없이 답해"라는 추상 지시만으로는 항목이 통째로 사라지는 문제 대응)
        if len(multi_parts) >= 2:
            user_msg = ("[반드시 각각 답해야 할 요구사항]\n"
                        + "\n".join(f"{i + 1}. {p}" for i, p in enumerate(multi_parts))
                        + "\n위 항목을 하나도 빠뜨리지 말고, 각 항목마다 소제목을 달아 답하라. "
                          "자료에서 확인되지 않는 항목도 '확인되지 않는다'고 반드시 언급하라.\n\n"
                        + user_msg)
            action_note += f" + 요구사항 {len(multi_parts)}개 명시"

        # [4-g] v9.3: '가장 저렴한 / 수익률 최고' 같은 최상급·순위 요구 대응
        # 순위 데이터가 문서에 없다고만 하고 상품 예시를 통째로 비우는 문제 방지
        if qtype in ("추천", "상품설명") and any(
                k in question for k in ("가장", "최고", "최저", "제일", "1위", "베스트", "톱")):
            user_msg = ("[주의] 사용자가 '가장 ~한 상품'처럼 순위·최상급을 요구했다. "
                        "'A가 B보다 낮다/저렴하다' 같은 비교 결론도 내지 마라. 순위가 없다고 "
                        "밝혔으면 그 뒤에 우열을 말하면 앞말과 모순된다. "
                        "참고 문서에 상품 간 순위나 수익률 비교 데이터가 없다면 '자료에서 순위는 "
                        "확인되지 않는다'고 분명히 밝혀라. 다만 그것을 이유로 상품 예시를 비우지 말고, "
                        "문서에서 확인되는 상품 중 사용자의 조건(저비용·안정성 등)에 부합하는 것을 "
                        "근거와 함께 반드시 예시로 제시하라.\n\n") + user_msg
            action_note += " + 최상급 요구 감지"
            sup_flag = True
        # 표·목록형 답변은 길어지므로 토큰 여유를 더 줌 (문장 잘림 방지)
        if qtype == "추천":
            out_tokens = 1200         # v9.99p4: 종목 여러 개를 각 항목별로 끝까지
                                      #   서술하면 800으로는 마지막 항목이 잘린다(실측 R06)
        elif system is COMPARE_SYSTEM or system is ASK_BACK_SYSTEM:
            out_tokens = 900          # v9.29: 되묻기도 경우별 안내를 담아야 하므로 여유
        elif qtype == "세제" or is_multi:
            out_tokens = 800
        else:
            out_tokens = 600
        # v8.8: 심사는 질문당 1회뿐이므로 답변 일관성을 높이기 위해 0.3 → 0.15
        ans = chat(system, user_msg, max_tokens=out_tokens, temperature=0.15)
        if not ans:
            ans = "답변 생성에 실패했습니다."

        # [4.9단계] v9.13: 비교 테이블인데 표가 너무 짧으면(항목 1~2개) 한 번만 다시 생성
        retry_note = ""
        if system is COMPARE_SYSTEM and ans != "답변 생성에 실패했습니다.":
            rows = [ln for ln in ans.splitlines()
                    if ln.count("|") >= 2 and not re.fullmatch(r"[\s|:\-]+", ln)]
            widths = [ln.count("|") for ln in rows]
            ragged = bool(widths) and (max(widths) - min(widths) >= 1)
            # v9.28: 익명 라벨('상품 A')은 [8단계]가 코드로 떼어내므로 재생성 대상에서 뺐다.
            #   (v9.20~v9.27에는 이것 때문에 LLM을 한 번 더 불러 +9초가 들었다)
            over_budget = (time.time() - t_start) > BUDGET_RETABLE
            if over_budget and (len(rows) < 5 or ragged):
                retry_note = f" → 표 보정 생략(경과 {time.time()-t_start:.0f}초, 예산 초과)"
            elif len(rows) < 5 or ragged:   # 줄 수 부족 or 열 개수가 어긋남
                strict = user_msg + (
                    "\n\n[다시 작성] 앞선 표는 비교 항목이 너무 적다. "
                    "① 투자 대상·전략 ② 위험등급 ③ 수수료(보수) ④ 투자 기간·만기 "
                    "⑤ 세제 혜택 ⑥ 유의사항 중 최소 5개 항목을 각각 한 줄씩 넣어 "
                    "표를 다시 만들어라. 자료가 없는 칸은 '자료 없음'으로 적되 줄은 반드시 유지하라. "
                    "모든 줄의 칸 개수를 헤더와 똑같이 맞추고, 각 상품의 정보를 반드시 "
                    "그 상품의 열에만 넣어라. 칸이 밀리면 안 된다. "
                    "열 이름은 문서에 적힌 실제 상품명·클래스명을 쓰고, '상품 A' 같은 임의 이름은 "
                    "쓰지 마라. 상품명을 확인할 수 없으면 표 대신 그 사실을 밝혀라.")
                # v9.61: 첫 생성이 표를 0줄로 내는 일이 잦다. 예산 안에서 최대 2회 시도한다.
                best, best_rows = ans, len(rows)
                tries = 0
                for _try in range(2):
                    if (time.time() - t_start) > BUDGET_RETABLE:
                        break
                    tries += 1
                    ans2 = chat(system, strict, max_tokens=900, temperature=0.15)
                    if not ans2:
                        continue
                    rows2 = [ln for ln in ans2.splitlines()
                             if ln.count("|") >= 2 and not re.fullmatch(r"[\s|:\-]+", ln)]
                    w2 = [ln.count("|") for ln in rows2]
                    ok = len(rows2) >= 5 and (not w2 or max(w2) - min(w2) < 1)
                    if len(rows2) > best_rows:
                        best, best_rows = ans2, len(rows2)
                    if ok:
                        break
                ans = best
                retry_note = (f" → 표 보정({len(rows)}줄"
                              f"{'/열 어긋남' if ragged else ''}): "
                              f"재시도 {tries}회 → {best_rows}줄")
            action_note += retry_note

        # [5단계] 근거 검증 레이어: 답변을 문서와 대조해 근거 없는 내용 제거/수정
        verify_note = ""
        if VERIFY and ans != "답변 생성에 실패했습니다.":
            allow_fix = (time.time() - t_start) < BUDGET_REFIX
            checked, changed, reason = verify_answer(context, ans, allow_fix)
            if changed:
                verify_note = f" 6) 근거 검증: 불일치 발견({reason}) → 답변 수정됨"
            else:
                verify_note = " 6) 근거 검증: 이상 없음"
            ans = checked

        # [6.2단계] v9.13: 계산기 결과와 답변의 계산식을 코드로 대조·교정
        calc_note = ""
        if calc_vals:
            ans, calc_note = enforce_calc(ans, calc_vals)
        # v11.6: 소득 미상(band_vals) 합산 맥락 — enforce_calc가 안 도는 경우, LLM이 남긴
        #   잘못된 '한도 X만원 적용' 결론을 계산된 공제대상으로 재작성(값 기반, 하드코딩 아님).
        #   순서: (LLM 답변) → 여기서 결론 교정 → 이후 소득미상 카드(base 기준) 부착 → 최종정리.
        if band_vals and not calc_vals and band_vals.get("limit") == 900:
            ans, _recn = reconcile_sum_limit(ans, band_vals["paid"],
                                             band_vals["base"], band_vals["limit"])
            if _recn:
                calc_note += f" 합산한도 결론 교정 {_recn}건"

        # [6.25단계] v9.14: 두 공제율을 더한 계산식 교정 / '자료에 없다' 뒤 외부지식 삭제
        ans, mix_note = fix_mixed_rate(ans, calc_vals["paid"] if calc_vals else paid_only)
        ans, out_note = strip_outside_knowledge(ans, context)
        calc_note = calc_note + mix_note + out_note

        # [6.27단계] v9.18: 세금 이중 차감 표현 교정
        ans, dbl_note = fix_double_tax(ans)
        calc_note = calc_note + dbl_note

        # [6.28단계] v9.99b: 회사 부담금 세액공제 오답 최종 교정.
        #   카드(질문 조건)를 붙여도 모델이 doc27의 오해 문장에 이끌려
        #   "회사 부담금도 공제 대상"이라고 답하면(K02 실측) 코드가 바로잡는다.
        #   반드시 성립해야 하는 사실이므로 답변 문장을 직접 교정한다.
        if re.search(r"회사(?:가|에서)?\s*(?:넣|납입|내|부담)|사용자\s*부담|"
                     r"회사\s*부담|법정\s*부담|고용주", question) \
                and re.search(r"공제|세액", question):
            # 회사/사용자 부담금이 '공제 대상이다/포함된다'는 취지의 문장 제거.
            #   한 문장 안에 (회사/사용자/법정 + 넣/납입/부담)과 (공제 대상/
            #   세액공제/공제 + 긍정 서술)이 함께 있으면 오답으로 본다.
            #   '아니/제외/않' 부정어가 있으면 올바른 문장이므로 보호.
            _fixed_lines = []
            _touched = False
            for _ln in ans.splitlines():
                _kept = []
                for _s in re.split(r"(?<=[.!?])\s+", _ln):
                    _emp = re.search(r"(?:회사|사용자|법정)[^.!?\n]{0,20}"
                                     r"(?:넣|납입|내|부담)", _s)
                    _ded = re.search(r"(?:공제\s*대상|세액공제|공제)[^.!?\n]{0,20}"
                                     r"(?:입니다|됩니다|포함|가능|해당)", _s)
                    _neg = re.search(r"아니|제외|해당(?:하지|되지)\s*않|"
                                     r"포함되지\s*않|대상이\s*아", _s)
                    if _emp and _ded and not _neg:
                        _touched = True
                        continue
                    _kept.append(_s)
                _fixed_lines.append(" ".join(k for k in _kept if k.strip()))
            ans = "\n".join(_fixed_lines)
            # 이미 '회사/사용자 부담금은 제외/대상 아님'이라는 올바른 문장이
            # 답에 있으면 정정문을 덧붙이지 않는다(중복 방지). 오답을 지웠거나
            # 올바른 문장이 아예 없을 때만 정정문을 붙인다.
            _has_correct = re.search(
                r"(?:회사|사용자|법정)[^.!?\n]{0,20}부담[^.!?\n]{0,30}"
                r"(?:대상이?\s*아|제외|해당(?:하지|되지)\s*않)", ans)
            _corr = ("\n\n※ 세액공제는 가입자 본인이 납입한 금액(연금저축·IRP "
                     "개인부담금)에만 적용되며, 회사(사용자)가 납입하는 부담금은 "
                     "세액공제 대상이 아닙니다.")
            if not _has_correct:
                ans = ans.rstrip() + _corr
                _touched = True
            if _touched:
                calc_note += " 회사 부담금 오답 교정"

        # [6.29단계] v9.99c: 연금계좌 일시금·연금외수령·중도해지에 15.4%(금융
        #   소득세)를 붙인 오류 교정(K19 실측: "일시금 수령하면 15.4% 부과").
        #   정답은 기타소득세 16.5%. 이자·배당·예금·펀드 맥락의 15.4%는 정당
        #   하므로 그 신호가 있으면 건드리지 않는다.
        _k19 = []
        for _ln in ans.splitlines():
            _parts19 = re.split(r"(?<=[.!?])\s+", _ln)
            _new = []
            for _s in _parts19:
                if "15.4" in _s \
                        and re.search(r"일시금|연금외\s*수령|중도\s*해지|중도해지", _s) \
                        and not re.search(r"이자|배당|예금|펀드|금융소득", _s):
                    _s = _s.replace("15.4%", "16.5%").replace("15.4 %", "16.5%")
                    _s = _s.replace("금융소득세", "기타소득세")
                    calc_note += " 세율 15.4→16.5 교정"
                _new.append(_s)
            _k19.append(" ".join(_new))
        ans = "\n".join(_k19)

        # [6.295단계] v9.99g: 비보장상품에 '원금이 보장됩니다' 긍정 단정 교정.
        #   질문이 디폴트옵션/실적배당/펀드 등의 원금보장을 물을 때만 작동한다
        #   (정기예금 원리금보장 설명은 건드리지 않음).
        if _GUAR_ASK.search(question) and _NONGUAR.search(question) \
                and not (_GUAR_OK.search(question) and not _NONGUAR.search(question)):
            _gl, _gtouch = [], False
            for _ln in ans.splitlines():
                _kk = []
                for _s in re.split(r"(?<=[.!?])\s+", _ln):
                    _pos = re.search(r"원금\s*(?:이|은)?\s*보장(?:이)?\s*"
                                     r"(?:됩니다|되는|된다|돼|있습니다|가능)", _s) \
                        or re.search(r"손실\s*(?:이)?\s*없(?:습니다|는|다|어)", _s)
                    _neg = re.search(r"않|아니|안\s*(?:돼|되|됩)|불가|제외|"
                                     r"손실.{0,6}(?:있|발생|가능)|보장되지", _s)
                    if _pos and not _neg:
                        _gtouch = True
                        continue
                    _kk.append(_s)
                _gl.append(" ".join(k for k in _kk if k.strip()))
            ans = "\n".join(_gl)
            _gnote = ("\n\n※ 디폴트옵션 안정형·실적배당형 상품(펀드·ETF 등)은 "
                      "원금이 보장되지 않습니다. 원리금이 보장되는 것은 정기예금·"
                      "저축은행예금·GIC 등 원리금보장상품에 한합니다.")
            if "원금이 보장되지 않습니다" not in ans:
                ans = ans.rstrip() + _gnote
                _gtouch = True
            if _gtouch:
                calc_note += " 원금보장 단정 교정"

        # [6.296단계] v9.99i: '원금 보장 + 고수익'을 동시에 요구한 질문인데
        #   답변이 트레이드오프(상충/양립불가)를 먼저 밝히지 않으면 서두에 못박는다.
        #   (실측 R07: 카드는 붙었으나 생성이 '동시에 추구 가능'으로 마무리)
        #   R10·R11처럼 이미 상충을 인정한 답변은 건드리지 않는다 → 부작용 0.
        if _SAFE_W.search(question) and _HIYIELD_W.search(question):
            _ACK = re.compile(r"동시에.{0,12}(?:없|않|어렵|불가)|상충|"
                              r"양립.{0,6}(?:않|없|어렵|불가)|트레이드\s*오프|"
                              r"둘\s*다.{0,10}(?:없|어렵|불가)")
            if not _ACK.search(ans):
                ans = ("원금이 보장되면서 수익도 높은 단일 상품은 존재하지 않습니다. "
                       "원리금보장형(정기예금·저축은행예금·GIC 등)은 안전한 대신 "
                       "수익률이 낮고, 실적배당형(펀드·ETF·TDF 등)은 수익 기대가 큰 "
                       "대신 원금 손실 위험이 있습니다. 안전과 수익 중 무엇을 "
                       "우선하실지에 따라 아래를 참고해 주세요.\n\n") + ans.lstrip()
                calc_note += " 보장·수익 상충 서두 삽입"

        # v9.99g: '제공된 자료에서 확인할 수 있습니다'는 어색한 서두다(실측 P24)
        ans = re.sub(r"^\s*제공된\s*자료에서\s*확인할\s*수\s*있습니다[.!]?\s*",
                     "", ans)
        # v9.99g: 인용이 지워진 자리에 남은 '및 의', '및  내용을' 빈 조사 흉터
        ans = re.sub(r"자세한\s*사항은\s*및\s*의\s*내용을\s*참고[^.!?\n]*[.!?]",
                     "자세한 사항은 아래 참고 문서를 확인하시기 바랍니다.", ans)
        ans = re.sub(r"(?<![가-힣])및\s+의\s+", "", ans)
        # v9.99n: '비교표를 다시 작성' 재시도 흔적 제거(실측 M17)
        ans = re.sub(r"비교표를\s*다시\s*작성", "비교표를 작성", ans)

        # [6.3단계] v9.13: 표 안에 새어 나온 HTML 태그 제거 (<br/> 노출 문제)
        ans = re.sub(r"<\s*br\s*/?\s*>", " / ", ans, flags=re.I)
        ans = re.sub(r"</?\s*(?:b|i|u|strong|em|span|div|p)\s*/?>", "", ans, flags=re.I)

        # [6.5단계] v9.1: 답변 속 '[문서N]' 내부 순번을 실제 파일명으로 치환
        # (프롬프트 지시만으로는 지켜지지 않아 코드로 확정 처리)
        # v9.76: 인용 표식은 지운다. 파일명은 답변 말미 [참고 문서]가 책임진다.
        def _to_source(m):
            return ""
        # '[문서2](doc27.pdf)' 처럼 뒤에 괄호가 붙은 형태를 먼저 통째로 치환
        ans = re.sub(r"\[\s*문서\s*(\d+)\s*\]\s*\([^)]*\)", _to_source, ans)
        # v9.76: '[문서1, 문서2]' '[문서 1·3]' 처럼 여러 개를 묶은 형태 (실측 P0013)
        ans = re.sub(r"\[\s*문서\s*\d+(?:\s*[,·/및~-]+\s*(?:문서\s*)?\d+)+\s*\]",
                     "", ans)
        # '[문서2]' 단독 형태
        # v9.90: 뒤에 조사가 붙어 있으면 그냥 지울 때 고아가 남는다
        #   ("또한 [문서2]에서도" → "또한 에서도" — P0697 실측).
        #   조사가 따라오면 '아래 참고 문서'로 바꾸고, 아니면 지운다.
        ans = re.sub(r"\[\s*문서\s*\d+\s*\]"
                     r"(?=\s*(?:에서도|에서는|에서|에도|에는|에|의|를|은|는|이|가|와|과))",
                     "아래 참고 문서", ans)
        ans = re.sub(r"\[\s*문서\s*(\d+)\s*\]", _to_source, ans)
        # v9.62: 대괄호 없는 '문서1에 따르면' / '문서 2에서는' 도 같은 문제다.
        #   (실측: "다만 문서1에 따르면 알림톡…" 이 그대로 나갔다)
        def _to_source_bare(m):
            idx = int(m.group(1)) - 1
            if 0 <= idx < len(used):
                return f"제공된 자료(출처: {used[idx]['source']})"
            return "제공된 자료"
        ans = re.sub(r"(?<!\[)문서\s*([1-9])(?=\s*(?:에|의|에서|에는|에도|를|은|는|이|가|와|과|,|\.))",
                     _to_source_bare, ans)
        # v9.76: 본문에 남은 '(출처: doc29.xlsx)'를 지운다. 사용자가 열 수 없는 이름이다.
        #   (모델이 스스로 적은 것도, 코드가 예전에 넣던 것도 여기서 함께 정리된다)
        ans = re.sub(r"[(\[]\s*출처\s*[:：]\s*[^)\]\n]+[)\]]"
                     r"(?=\s*(?:에서|에|를|과|와|의))", "아래 참고 문서", ans)
        ans = re.sub(r"\s*[(\[]\s*출처\s*[:：]\s*[^)\]\n]+[)\]]", "", ans)
        # 이미 고아가 된 '다만, 에 따르면' 류도 회복
        ans = re.sub(r"(?<=[,.\s])(에|에서)\s*따르면", r"아래 참고 문서\1 따르면", ans)
        # v9.81: '출처:' 없이 파일명만 쓴 인용 — "문서 [R2_….pdf]에서" / "(doc27.pdf)"
        _FNAME_IN = re.compile(r"(?:문서\s*)?[\[(]?\s*(?:doc\d+|R\d+_[A-Za-z0-9]+)"
                               r"\.(?:pdf|xlsx|docx|hwp|pptx|txt)\s*[\])]?", re.I)
        _fn_lines = []
        for _l in ans.splitlines():
            if _l.strip().startswith("[참고 문서]"):
                _fn_lines.append(_l)
                continue
            _fn_lines.append(_FNAME_IN.sub("아래 참고 문서", _l))
        ans = "\n".join(_fn_lines)
        # v10.8: 인용·파일명 제거 뒤 괄호 안에 구두점·공백만 남는 흉터 정리(전 유형).
        #   실측 doc41 답변 '…확인됩니다(,).' — 인용이 빠지고 괄호 안에 쉼표만 남음.
        ans = re.sub(r"[(\[]\s*[,，、;；:·]?\s*[)\]]", "", ans)
        ans = re.sub(r"[ \t]{2,}", " ", ans)
        ans = re.sub(r"\s+([.,!?)])", r"\1", ans)
        ans = re.sub(r"(?m)^[ \t]*[.,]\s*", "", ans)
        # v9.62: 내부 파일명을 '거기서 확인하세요'라고 안내하면 안 된다.
        #   사용자는 doc9.pdf를 열 수 없다. 출처는 말미 [참고 문서]로만 밝힌다.
        ans = re.sub(r"\(?출처:\s*[^)\n]+\)?\s*(?:에서|에|를)\s*(?:직접\s*)?"
                     r"(?:확인|참고|참조)(?:하실 수 있습니다|하시기 바랍니다|하세요|해 주세요)",
                     "아래 참고 문서에서 확인하실 수 있습니다", ans)

        # v9.99n(수정): 인용→'아래 참고 문서' 치환이 모두 끝난 뒤 흉터를 정리한다.
        #   (앞에서 정리하면 흉터가 그 뒤에 생겨 소용없다 — 실측 R02·R09·R31)
        #   '제공된 자료아래 참고 문서'/'여러 문서들아래 참고 문서' → 자연스럽게.
        ans = re.sub(r"제공된\s*자료\s*아래\s*참고\s*문서", "아래 참고 문서", ans)
        ans = re.sub(r"여러\s*문서들?\s*아래\s*참고\s*문서", "여러 참고 문서", ans)
        #   '아래 참고 문서'가 잇달아 반복되면 하나로 합친다.
        ans = re.sub(r"(?:아래\s*참고\s*문서\s*[,·]?\s*){2,}", "아래 참고 문서 ", ans)
        ans = re.sub(r"참고\s*문서\s*등\s*\)", "참고 문서 등", ans)
        #   '제공된 자료아래 참고 문서에서 제공된' 처럼 '제공된'이 겹치면 정리
        ans = re.sub(r"아래\s*참고\s*문서에서\s*제공된\s+", "아래 참고 문서의 ", ans)
        # v11.3: 존재하지 않는 법령명 '퇴직소득보장법' 지어냄(실측 C12) → 근거 없는
        #   특정 법 인용을 '관련 세법'으로 완화(잘못된 법 인용은 근거기반 감점).
        ans = re.sub(r"퇴직소득보장법", "관련 세법", ans)

        # [6.8단계] v9.18: 질문과 직접 관련된 기한이 답변에서 빠졌으면 문서 문장으로 보강
        # v9.66: 답변이 '자료에 없다'로 끝났는데 기한만 붙이면 모순이다
        #   (실측 #9: 주식 현물이전 질문에 ISA 60일 기한이 붙었다)
        # v9.68: 길이가 아니라 '첫 문장이 자료 없음인가'로 본다.
        #   (실측 #5: "확인할 수 없습니다" 뒤에 설명이 붙어 120자를 넘겼다)
        _head = re.split(r"(?<=[.!?])\s+", ans.strip(), 1)[0]
        _no_answer = bool(_NOINFO.search(_head))
        # v11.7: 질문이 '기한'을 실제로 묻지 않으면 기한 카드를 붙이지 않는다(무관 차단).
        miss = [] if (_no_answer or not _DEADLINE_INTENT.search(question)) else \
            [(n, t) for n, t in forced_pairs if n not in ans.replace(" ", "")]
        if miss:
            lines = []
            for n, t in miss[:1]:   # v9.19: 노이즈를 줄이려 한 문장만 덧붙인다
                t = t.strip().lstrip("…").rstrip("…")
                lines.append(f"- {t}")
            ans = ans.rstrip() + "\n\n※ 참고 문서에 명시된 기한입니다. 놓치면 혜택을 받을 수 없습니다.\n" \
                  + "\n".join(lines)
            calc_note += f" (기한 코드 보강 {len(miss)}건)"

        # [6.9단계] v9.74: 연금수령 요건은 문서에 확정된 사실이다 → 코드가 붙인다
        _req = pension_req_card(question)
        if _req:
            # v9.99d: '10년(등) 부어야/납입해야/채워야 받는다'는 잘못된 납입기간
            #   요건 서술 제거(K27 실측). 문서 요건은 '가입기간 5년'뿐이며 '10년'은
            #   수령한도 적용 연차이지 납입 요건이 아니다. 5년·가입기간 문장은 보호.
            _rl = []
            for _ln in ans.splitlines():
                _kk = []
                for _s in re.split(r"(?<=[.!?])\s+", _ln):
                    _wrongreq = re.search(
                        r"(\d+)\s*년[^.!?\n]{0,25}"
                        r"(?:납입|부어야|부으셔야|채워야|더\s*넣|더\s*납입)", _s) \
                        and re.search(r"받|수령|연금|요건|충족", _s)
                    if _wrongreq:
                        _yr = re.search(r"(\d+)\s*년", _s)
                        if _yr and _yr.group(1) != "5" and "가입기간" not in _s:
                            calc_note += " 잘못된 납입기간 요건 제거"
                            continue
                    _kk.append(_s)
                _rl.append(" ".join(k for k in _kk if k.strip()))
            ans = "\n".join(_rl)
        if _req and PENSION_REQ_MARK not in ans and not _NOINFO.search(
                re.split(r"(?<=[.!?])\s+", ans.strip(), 1)[0]):
            ans = ans.rstrip() + "\n\n" + _req
            calc_note += " (연금수령 요건 코드 보강)"

        # [7단계] 출처 표기: 평가 기준 대응 — 사용한 문서의 출처를 답변 본문에 자동 명시
        srcs = []
        for c in used:
            if c["source"] not in srcs:
                srcs.append(c["source"])
        if srcs:
            ans = ans.rstrip() + "\n\n[참고 문서] " + ", ".join(srcs)

        # [8단계] v9.22: 출력 최종 정리 — 반드시 마지막에 실행되어야 하는 것만 모은다.
        #   중간에서 지웠는데 최종 출력에 남는 일이 있어 위치를 끝으로 옮기고,
        #   처리 건수를 trace에 숫자로 남겨 원인 추적이 가능하게 한다.
        clean_note = ""
        # (0) v9.25: 출처 줄을 잠시 떼어둔다 — 정리하며 덧붙이는 문장이
        #     '[참고 문서]' 뒤로 가면 어색하므로, 정리가 끝난 뒤 맨 끝에 다시 붙인다
        m_src = re.search(r"\n*\[참고 문서\][^\n]*$", ans)
        src_tail = m_src.group(0) if m_src else ""
        if src_tail:
            ans = ans[:m_src.start()].rstrip()
        # (0.5) v9.99l: doc27(과학기술인공제회 전용 FAQ)이 근거에 쓰였고 질문에
        #   과기공 맥락이 없는데도 생성이 '과학기술인공제회/과기공/공제회/발전
        #   장려금/출연연'을 흘리면(실측 R17·P13·P32) 해당 문장을 제거한다.
        #   주의 카드(조언)의 최종 방어. 단, 제거 후 본문이 너무 짧아지면(60자
        #   미만) 원복해 빈 답을 막는다(누출보다 무응답이 더 큰 실점).
        if any(c.get("source") == "doc27.pdf" for c in used) \
                and not re.search(r"과학기술|공제회|과기공|출연연|SEMA", question):
            _GLK = re.compile(r"과학기술인\s*공제회|과기공|공제회|발전\s*장려금|출연연")
            _gk, _gn = [], 0
            for _ln in ans.splitlines():
                _kk = []
                for _s in re.split(r"(?<=[.!?])\s+", _ln):
                    if _GLK.search(_s):
                        _gn += 1
                        continue
                    _kk.append(_s)
                _gk.append(" ".join(k for k in _kk if k.strip()))
            _scrubbed = "\n".join(x for x in _gk if x.strip())
            if _gn and len(re.sub(r"\s", "", _scrubbed)) >= 60:
                ans = _scrubbed
                clean_note += f" 과기공 누출 {_gn}문장 제거"
        # (1) '상품 A / 실제명', '상품1(실제명)' 처럼 지어낸 라벨을 떼어낸다
        ans, n_slash = re.subn(r"상품\s*[0-9A-Za-z]{1,3}\s*[/·∙・]\s*", "", ans)
        ans, n_paren = re.subn(r"상품\s*[0-9A-Za-z]{1,3}\s*\(([^)]{4,})\)", r"\1", ans)
        n_anon = n_slash + n_paren
        if n_anon:
            clean_note += f" 익명 상품라벨 {n_anon}건 제거"
        # (1-1a) v9.99p: 문서에 없는 개별 종목(ETF 등) 창작 제거 — 추천 최종 방어
        n_etf = 0
        if qtype == "추천" or _ETF_BRAND.search(ans) or re.search(r"ETF|펀드", ans):
            ans, n_etf = strip_unbacked_etf(ans, context)
            if n_etf:
                clean_note += f" 근거 밖 종목 {n_etf}건 제거"
        # 블록인용/포맷 흉터 정리 ('>-', '> -' → '-')
        ans = re.sub(r"(?m)^\s*>\s*-", "-", ans)
        # (1-1a1) v10.3: 경쟁사 ETF 브랜드(미래에셋 아님)를 추천 목록에서 제외.
        #   미래에셋 챗봇은 자사 TIGER를 안내한다(실측: 카드/문맥에 KODEX·ACE 유입).
        if qtype == "추천":
            _COMPET = re.compile(r"KODEX|KBSTAR|ARIRANG|HANARO|KOSEF|KINDEX|"
                                 r"\bACE\b|\bSOL\b|TIMEFOLIO|RISE\b|PLUS\b(?!\S)", re.I)
            _cl, _cn, _ci = [], 0, 0
            _cls = ans.splitlines()
            while _ci < len(_cls):
                _cln = _cls[_ci]
                if re.match(r"\s*(?:\d+[.)]|[-*•])\s*\*?\*?\s*"
                            r"(?:KODEX|KBSTAR|ARIRANG|HANARO|KOSEF|KINDEX|ACE|SOL|RISE)",
                            _cln, re.I):
                    _cn += 1
                    _ci += 1
                    while _ci < len(_cls) and re.match(r"\s+[-*•]", _cls[_ci]):
                        _ci += 1
                    continue
                _cl.append(_cln)
                _ci += 1
            if _cn:
                ans = _renumber_items("\n".join(_cl))
                clean_note += f" 경쟁사 브랜드 {_cn}건 제외"
        # (1-1a2) v10.0: 'ETF' 요청인데 재간접펀드(비상장 펀드)가 목록에 섞이면 제외
        #   (실측: '미래에셋…EMP(주식-재간접)'는 상장 ETF가 아니다 — 사용자 지적 #4)
        #   v10.1: 번호 항목뿐 아니라 불릿/줄 단위 '재간접' 표기도 제외.
        if qtype == "추천" and re.search(r"ETF|이티에프|상장지수", question):
            _l2, _rmj, _i2 = [], 0, 0
            _ls2 = ans.splitlines()
            while _i2 < len(_ls2):
                _ln2 = _ls2[_i2]
                # 번호+굵은 상품명에 '재간접'
                if re.match(r"\s*\d+[.)]\s*\*\*[^*\n]*재간접", _ln2) \
                        and not _ETF_BRAND.search(_ln2):
                    _rmj += 1
                    _i2 += 1
                    while _i2 < len(_ls2) and re.match(r"\s+[-*•]", _ls2[_i2]):
                        _i2 += 1
                    continue
                # 불릿/줄에 '재간접'만 나열된 경우(예: '- 성장형 펀드: …재간접…')
                if re.match(r"\s*[-*•]", _ln2) and "재간접" in _ln2 \
                        and not _ETF_BRAND.search(_ln2):
                    _rmj += 1
                    _i2 += 1
                    continue
                _l2.append(_ln2)
                _i2 += 1
            if _rmj:
                ans = _renumber_items("\n".join(_l2))
                n_etf += _rmj
                clean_note += f" 비ETF(재간접) {_rmj}건 제외"
        # (1-1b) v9.99p4: 추천 답변에서 요청 개수보다 실제 제시한 상품이 적으면
        #   '끝'이 아니라 '서두'에 개수를 먼저 공지한다(실측 사용자 지적).
        #   ETF 여부와 무관하게 추천 유형 전반에 적용. 개수를 채우려 지어내지 않는다.
        if qtype == "추천" or _ETF_BRAND.search(ans):
            _reqm = re.search(r"(\d+)\s*(?:가지|개|종목|곳|가지의|개의)", question)
            _kept = len(re.findall(r"(?m)^\s*\d+[.)]\s", ans))
            _prod_present = bool(_ETF_BRAND.search(ans))
            # 모델이 상품을 비정형(불릿)으로 나열하면서도 '종목 정보가 없어 어렵다'는
            #   거짓 서두를 붙이는 모순 완화(실측 10개 run) — 상품이 실제로 있을 때만.
            if _prod_present:
                ans = re.sub(r"제공된\s*자료에는?\s*개별\s*종목\s*정보가?\s*없어[^.\n]*"
                             r"(?:어렵|없)[^.\n]*\.", "제공된 자료에서 확인되는 상품을 "
                             "유형별로 안내드리겠습니다.", ans, count=1)
            if _reqm and int(_reqm.group(1)) > _kept \
                    and "근거가 확인되는" not in ans and "특정하기 어렵" not in ans \
                    and not (_kept == 0 and _prod_present):
                # 모델이 스스로 '종목 N가지를 추천/제안드리겠습니다'라고 요청 개수를
                #   그대로 약속한 서두 문장을 제거한다(서두 공지와 모순 방지 — 실측:
                #   서두 '2가지'인데 본문이 '5가지를 추천드리겠습니다').
                ans = re.sub(r"[^.!?\n]*다음과\s*같이[^.!?\n]*"
                             r"(?:추천|제안|소개)[^.!?\n]*[.!?]\s*", "", ans, count=1)
                ans = re.sub(r"[^.!?\n]*종목\s*\d+\s*가지[를을]?\s*"
                             r"(?:추천|제안|안내|소개)[^.!?\n]*[.!?]\s*", "", ans, count=1)
                # v10.6: '~N가지는 다음과 같습니다:' 처럼 요청 개수를 그대로 약속하는
                #   서두도 제거(서두 정직 공지와 모순 — 실측 10개 run '10가지는 다음과').
                ans = re.sub(r"[^.!?\n]*\d+\s*가지[는은가이]?\s*"
                             r"다음과\s*같습니다[:：]?\s*", "", ans, count=1)
                if _kept == 0:
                    # 근거 있는 개별 종목이 하나도 없을 때 — 빈 목록 대신 정직 안내
                    ans = (f"요청하신 {_reqm.group(1)}가지에 해당하는 개별 ETF 종목은 제공된 "
                           f"자료에서 근거 있게 특정하기 어렵습니다. 자료에 없는 종목은 지어내지 "
                           f"않으며, 투자 성향에 맞는 유형·선택 기준으로 안내드리니 구체적인 "
                           f"종목은 미래에셋증권 홈페이지·앱에서 확인해 주세요.\n\n"
                           + ans.lstrip())
                else:
                    ans = (f"요청하신 {_reqm.group(1)}가지 중, 제공된 자료에서 근거가 확인되는 "
                           f"상품은 {_kept}가지여서 그 {_kept}가지를 안내드립니다. 자료에 없는 "
                           f"종목은 개수를 채우려 지어내지 않으며, 더 많은 종목은 미래에셋증권 "
                           f"홈페이지·앱에서 확인하실 수 있습니다.\n\n" + ans.lstrip())
                clean_note += " 개수 부족 서두 공지"
            elif n_etf:
                ans = ans.rstrip() + ("\n\n※ 제공된 자료에서 근거가 확인되지 않는 종목은 "
                                      "제외했습니다. 자료에 없는 종목은 지어내지 않습니다.")
        # (1-1c) v9.99r: 추천 답변의 단정 표현 완화 + 외부 블로그 링크 제거(최종 방어).
        #   프롬프트만으론 확률적으로 '적합한 상품들입니다'가 남아(실측 5개 run).
        if qtype == "추천":
            # ① '~에게 적합한 상품(들)입니다' 단정 → '검토될 수 있는 상품' 으로 완화
            ans = re.sub(r"에게\s*적합한\s*상품들?\s*입니다",
                         "에게 검토될 수 있는 상품입니다", ans)
            ans, _n_fit = re.subn(r"에\s*적합한\s*(상품|펀드|ETF)(들)?\s*입니다",
                                  r"에 검토될 수 있는 \1입니다", ans)
            # ①-b '고위험=적합' 단순 연결 단정도 완화 (실측 '적합하다는 점을 반영')
            ans = re.sub(r"적합하다는\s*점을?\s*반영합니다",
                         "검토 근거가 될 수 있습니다", ans)
            ans = re.sub(r"에게\s*적합하다(?:는\s*점|고\s*볼\s*수\s*있)[^.]*\.",
                         "에게 검토 근거가 될 수 있습니다.", ans)
            ans = re.sub(r"(?:투자자|분들?|고객)에게\s*적합합니다",
                         "투자자가 검토할 수 있습니다", ans)
            # ①-c '성향에 적합합니다/적합.' 등 남은 적합 단정 완화(정중체·개조식 모두)
            ans = re.sub(r"에게\s*적합한\s*(몇\s*가지\s*)?(ETF|상품|펀드|종목)",
                         r"가 검토해 볼 수 있는 \1\2", ans)
            # '투자에 적합한 종목/상품' 같은 '에 적합한 X'도 완화
            ans = re.sub(r"에\s*적합한\s*(몇\s*가지\s*)?(ETF|상품|펀드|종목)",
                         r"에서 검토해 볼 수 있는 \1\2", ans)
            # '적합하며/적합하고/적합하기' 등 연결·활용형 단정도 완화
            ans = re.sub(r"에게\s*적합하며", "에게 부합하며", ans)
            ans = re.sub(r"에게\s*적합하고", "에게 부합하고", ans)
            ans = re.sub(r"적합하며", "적절할 수 있으며", ans)
            ans = re.sub(r"적합하고", "적절할 수 있고", ans)
            ans = re.sub(r"적합하기\s*때문", "적절할 수 있기 때문", ans)
            ans = re.sub(r"성향에\s*적합합니다", "성향에서 검토해 볼 수 있습니다", ans)
            ans = re.sub(r"에\s*적합합니다", "에서 검토해 볼 수 있습니다", ans)
            ans = re.sub(r"에게\s*적합합니다", "에게 검토 대상이 될 수 있습니다", ans)
            ans = re.sub(r"에게\s*적합(?=[\s.,]|$)", "에게 검토 대상이 될 수 있음", ans)
            ans = re.sub(r"에\s*적합(?=[\s.,]|$)", "에서 검토해 볼 수 있음", ans)
            # ② '~하는 것이 좋습니다' 추천 단정 → '하나의 방법일 수 있습니다'
            ans = re.sub(r"투자하는\s*것이\s*좋습니다",
                         "투자하는 것도 하나의 방법일 수 있습니다", ans)
            # ②-b 수익·우위 단정 완화
            ans = re.sub(r"높은\s*성과를\s*기대할\s*수\s*있습니다",
                         "성장 잠재력이 있으나 그만큼 손실 위험도 큽니다", ans)
            ans = re.sub(r"높은\s*수익(?:률)?을\s*기대할\s*수\s*있습니다",
                         "성장 잠재력이 있으나 손실 위험도 함께 존재합니다", ans)
            ans = re.sub(r"투자자에게\s*유리합니다", "투자자가 검토할 수 있습니다", ans)
            ans = re.sub(r"에게\s*유리합니다", "에게 유리할 수 있습니다", ans)
            ans = re.sub(r"유리합니다", "유리할 수 있습니다", ans)
            # 고위험=성향 연결 단정('성향에 부합합니다') 완화
            ans = re.sub(r"성향에?\s*부합합니다", "성향과 부합하는 면이 있습니다", ans)
            # ②-c 근거 없는 '연금 계좌 투자 가능' 단정은 그 절을 통째로 제거(주어 중복 방지)
            ans = re.sub(r"(?:위의|이|이들)?\s*ETF들?은?\s*(?:모두\s*)?연금저축\s*계좌에서"
                         r"\s*투자가?\s*가능하며,?\s*", "위의 ETF들은 ", ans)
            ans = re.sub(r"(?:모두\s*)?연금저축\s*계좌에서\s*투자가?\s*가능하며,?\s*", "", ans)
            ans = re.sub(r"(?:모두\s*)?연금(?:저축)?\s*계좌에서\s*투자가?\s*가능합니다\.?",
                         "", ans)
            # ②-d 이유·특징·유의 항목의 명사형(개조식) 종결을 정중체로 통일.
            #   행동 명사 + '.'/공백 종결 → '~합니다.', 상태 명사 → '~이 있습니다.'
            _ACTN = (r"분배(?:금)?|지급|투자|수취|추구|도모|관리|제공|존재|반영|노출|"
                     r"집중|기대|필요|가능|확대|성장|하락|상승|변동|추종|편입|분산|"
                     r"매도|매수|운용|목표로\s*함|목표")
            ans = re.sub(r"(?m)함\.\s*$", "합니다.", ans)
            ans = re.sub(r"(?m)됨\.\s*$", "됩니다.", ans)
            ans = re.sub(r"(?m)됨\s*$", "됩니다.", ans)
            ans = re.sub(r"(?m)(" + _ACTN + r")\.\s*$", r"\1합니다.", ans)
            ans = re.sub(r"(?m)(" + _ACTN + r")\s*$", r"\1합니다.", ans)
            # 상태 명사(가능성·리스크 등)로 끝나면 '있습니다'
            ans = re.sub(r"(?m)(가능성|리스크|위험성|변동성|필요성|불확실성)\.?\s*$",
                         r"\1이 있습니다.", ans)
            ans = re.sub(r"(?m)있음\.\s*$", "있습니다.", ans)
            ans = re.sub(r"(?m)큼\.\s*$", "큽니다.", ans)
            # 중복 정중체('합니다합니다', '있습니다이 있습니다') 방지 정리
            ans = re.sub(r"합니다\s*합니다", "합니다", ans)
            ans = re.sub(r"있습니다이\s*있습니다", "있습니다", ans)
            # ③ 외부 블로그/비공식 출처 제거(미래에셋 자료 밖) — 괄호 URL째, 문구+조사까지
            ans = re.sub(r"(?:,\s*그리고|그리고|,|및)?\s*네이버\s*블로그\s*"
                         r"(?:\([^)]*\))?\s*(?:등)?(?:에서도|에서|에|을|를|은|는)?", "", ans)
            ans = re.sub(r"https?://blog\.naver\.com/[^\s)]+", "", ans)
            # 링크·문구 제거로 생긴 흉터 정리('앱 에서', '가능하며에서도', 빈 괄호)
            ans = re.sub(r"(홈페이지(?:나|와)?\s*(?:모바일\s*)?앱)\s*(?:등)?\s*에서",
                         r"\1에서", ans)
            ans = re.sub(r"(가능하며|있으며|하며)\s*에서도\s*", r"\1 ", ans)
            ans = re.sub(r"\(\s*\)", "", ans)
            ans = re.sub(r"[ \t]{2,}", " ", ans)
            ans = re.sub(r"\s+([.,])", r"\1", ans)
            # ④ 상품을 제시한 추천 답변엔 균형 캐비엇을 보강(이미 있으면 생략)
            if (re.search(r"(?m)^\s*\d+[.)]\s", ans) or _ETF_BRAND.search(ans)) \
                    and "적합성을 단정" not in ans and "단정하기는 어렵" not in ans \
                    and "함께 고려" not in ans:
                ans = ans.rstrip() + ("\n\n※ 다만 연령·투자성향만으로 특정 상품의 적합성을 "
                                      "단정하기는 어려우며, 투자기간·손실 감내 수준·기존 "
                                      "자산배분 등을 함께 고려하셔야 합니다.")
                clean_note += " 추천 균형 캐비엇 보강"
            # ⑤ v9.99u: 수익률·성과 수치가 있으면 '과거 성과≠미래 보장' 1회 고지
            if re.search(r"수익률|초과수익|\d+(?:\.\d+)?\s*%|성과", ans) \
                    and "미래 수익을 보장" not in ans and "미래의 수익을 보장" not in ans:
                ans = ans.rstrip() + ("\n※ 과거의 수익률이나 성과는 미래의 수익을 "
                                      "보장하지 않습니다.")
                clean_note += " 과거성과 고지"
            # ⑥ v10.6: 번호 목록으로 2개 이상 상품을 제시했으면, 나열 순서가
            #   추천 우선순위·상품 간 우열을 뜻하지 않는다는 고지를 1회 붙인다.
            #   (수익률순 정렬은 '과거≠미래' 원칙과 모순되고 신생 종목을 불리하게
            #   해 채택하지 않음 — 순서는 무순위임을 명시하는 쪽을 택함.)
            if len(re.findall(r"(?m)^\s*\d+[.)]\s", ans)) >= 2 \
                    and "순서는" not in ans and "우선순위" not in ans:
                ans = ans.rstrip() + ("\n※ 위 나열 순서는 추천 우선순위나 상품 간 "
                                      "우열을 의미하지 않습니다.")
                clean_note += " 순서 무순위 고지"
        # (1-2) 순위·우열 단정 문장 제거 (최상급 요구가 있었던 경우만)
        ans, n_rank = strip_rank_claims(ans, sup_flag)
        if n_rank:
            clean_note += f" 순위 단정 {n_rank}건 제거"
        # (1-3) v9.30: 최상급 질문이면 '순위 자료 없음' 고지를 조건 없이 항상 붙인다.
        #   v9.25까지는 "이미 고지했는지"를 _NOINFO로 판단해 조건부로 붙였는데,
        #   그 판단 사전과 평가/테스트의 판단 사전이 달라 간헐적으로 어긋났다.
        #   판단 단계를 없애면 100% 결정적으로 동작한다. (같은 문장이 두 번 들어가지는 않음)
        RANK_NOTICE = ("제공된 자료에는 상품 간 순위나 비교 데이터가 없어 "
                       "'가장 ~한 상품'을 하나로 특정할 수 없습니다. "
                       "아래 내용은 자료에서 확인되는 범위의 안내입니다.")
        if sup_flag and RANK_NOTICE not in ans:
            ans = RANK_NOTICE + "\n\n" + ans.lstrip()
            clean_note += " 순위 없음 고지 추가"
        # (1-4) v9.26: 답변에 문서의 오표기가 그대로 인용되면 계산값으로 바꾸고 사실을 밝힌다
        n_unit = 0
        for n, pat in _NOTE_PAT:
            new, cnt = pat.subn(
                f"{n['right']}(자료 원문에는 '{n['wrong']}'으로 적혀 있으나 "
                f"{n['basis']}이므로 계산상 {n['right']}입니다)", ans)
            if cnt:
                ans, n_unit = new, n_unit + cnt
        if n_unit:
            clean_note += f" 단위 오표기 {n_unit}건 고지"

        # (1-4b) v9.49: 모델이 오표기를 알아서 고쳐 쓰면 (1-4)의 교체가 걸리지 않아
        #   '원문에 오기가 있다'는 사실이 통째로 사라진다. 사용자가 원문을 근거로
        #   물었을 때 특히 문제다(실측 H5). → 고지를 코드가 붙인다.
        if num_hits:
            _flat = re.sub(r"\s+", "", ans)
            _q = re.sub(r"\s+", "", question)
            for _n in num_hits:
                _w = re.sub(r"\s+", "", _n["wrong"])
                _r = re.sub(r"\s+", "", _n["right"])
                # v11.7: 최대/얼마까지 금액을 묻거나, 원문 오기를 직접 인용했을 때만 고지.
                _unit_ask = (_w in _q) or bool(re.search(
                    r"최대|얼마까지|얼마.*돌려받|최고|한도\s*금액", question))
                if _unit_ask and (_r in _flat or _w in _q) and "자료 원문에는" not in ans:
                    ans = ans.rstrip() + (
                        f"\n\n※ 자료 원문({_n['src']})에는 '{_n['wrong']}'으로 적혀 있으나, "
                        f"{_n['basis']}이므로 계산상 '{_n['right']}'이 맞습니다.")
                    clean_note += " 단위 오표기 고지 보강"
                    break

        # (1-4c) v9.55: 소득을 모르는데 금액을 하나로 확정하는 일이 반복된다(R31 변종).
        #   구간 계산기가 돌았으면 두 경우를 조건 없이 코드가 붙인다.
        if band_vals:
            _b = band_vals["base"]
            _line = (f"※ 소득 구간이 확인되지 않아 금액을 하나로 확정할 수 없습니다. "
                     f"공제 대상 {int(_b):,}만원 기준으로 총급여 5,500만원 이하이면 "
                     f"{_b * 0.165:,.1f}만원(16.5%), 5,500만원을 초과하면 "
                     f"{_b * 0.132:,.1f}만원(13.2%)입니다.")
            if "소득 구간이 확인되지 않아" not in ans:
                ans = ans.rstrip() + "\n\n" + _line
                clean_note += " 소득 미상 구간 고지"

        # (1-4d) v9.56: 세액공제를 받지 않은 납입금(과세제외금액)에는 기타소득세가
        #   붙지 않는다. 조건을 '답변'이 아니라 '질문'에 건다 — 답변은 매번 달라진다.
        # v9.77: '나머지·초과·찾을'은 인출과 무관한 질문에도 흔하다(실측 P0095:
        #   디폴트옵션 운용지시 질문에 세제 카드가 붙었다). 인출·해지 문맥어만 남기고,
        #   운용지시·디폴트옵션 문맥이면 세제 얘기를 붙일 자리가 아니다.
        _EXEMPT_ACT = ("인출", "해지", "깨", "빼", "출금", "환매", "중도", "돌려받")
        _EXEMPT_HINT = ("나머지", "초과", "찾")     # 넓은 말 — 세금 문맥이 있을 때만
        _EXEMPT_TAX = ("세액공제", "공제", "과세", "세금", "기타소득")
        _OPER_Q = ("디폴트옵션", "사전지정", "운용지시", "자동매수", "자동적용",
                   "포트폴리오", "옵트인")
        _fire = (any(k in question for k in _EXEMPT_ACT)
                 or (any(k in question for k in _EXEMPT_HINT)
                     and any(k in question for k in _EXEMPT_TAX)))
        # v11.7: '세액공제로 돌려받/환급'은 환급 문맥이지 인출 과세가 아님.
        #   세액공제·공제 질문인데 실제 인출·해지어가 없으면 과세제외 카드 미부착(E01 오탐 차단).
        if _fire and re.search(r"세액공제|공제(?:액|율|금액|한도)|환급", question) \
                and not any(k in question for k in
                            ("인출", "해지", "출금", "환매", "중도", "깨", "빼", "찾")):
            _fire = False
        if _fire and not any(k in question for k in _OPER_Q) \
                and "받지 않은 납입금" not in ans and "과세제외" not in ans:
            ans = ans.rstrip() + (
                "\n\n※ 기타소득세 16.5%는 세액공제를 받은 납입금과 운용수익을 인출할 때 "
                "적용됩니다. 세액공제를 받지 않은 납입금(과세제외금액)은 인출하더라도 "
                "기타소득세가 부과되지 않습니다.")
            clean_note += " 과세제외금액 예외 고지"

        # (1-5) v9.31: 되묻기·성향확인인데 답변에 질문이 없으면 코드가 질문을 넣는다.
        #   프롬프트에 맡기면 지시가 많을 때 질문이 통째로 빠진다(실측: R15/R35 2회 모두 실패).
        if ask_line and "?" not in ans:
            where, line = ask_line
            ans = (line + "\n\n" + ans.lstrip()) if where == "head" \
                else (ans.rstrip() + "\n\n" + line)
            clean_note += " 확인 질문 추가"

        # (1-6) v9.32: 잘못된 전제를 수긍한 문장을 문서 기준으로 교정
        ans, n_prem = fix_false_premise(ans)
        if n_prem:
            clean_note += f" 잘못된 전제 교정 {n_prem}건"

        # (1-6b) v9.41: ISA 전환금 질문이면 '대상 총액'을 코드가 계산해 붙인다.
        #   조건 없이 붙인다 — '이미 썼는지'를 판단하려 들면 그 판단이 또 어긋난다.
        if any(set(r[0]) & set(_ISA_KEYS) for r in scope_rules):
            _isa_line = isa_summary_line(question)
            if _isa_line and _isa_line not in ans:
                ans = ans.rstrip() + "\n\n" + _isa_line
                clean_note += " ISA 공제 총액 명시"

        # (1-7) v9.36: 제외 사유 설명이 빠지면 코드가 한 줄 보강한다.
        #   실측 K5: 카드에 '이유를 밝혀라'라고 했는데 회사 부담금 언급이 통째로 빠졌다.
        n_scope = 0
        for _keys, _note, _needs, _line in scope_rules:
            if not any(w in ans for w in _needs):
                ans = ans.rstrip() + "\n\n" + _line
                n_scope += 1
        if n_scope:
            clean_note += f" 제외 사유 보강 {n_scope}건"
        # (1-7b) v9.40: 회사 부담금이 걸린 질문에서만, '한도를 초과해서 제외'라는
        #   틀린 이유를 지운다. (회사 부담금은 한도와 무관하게 대상 자체가 아니다.
        #   한도 초과가 진짜 이유인 다른 질문은 이 조건에 걸리지 않는다.)
        if any("회사가" in k for r in scope_rules for k in r[0]):
            ans, n_bad = re.subn(
                r"[^\n]*한도[\s*_]*를?[\s*_]*초과한?[\s*_]*금액[^\n]*", "", ans)
            if n_bad:
                ans = re.sub(r"\n{3,}", "\n\n", ans).strip()
                clean_note += f" 잘못된 제외 사유 삭제 {n_bad}건"

        # (1-7c) v9.57: 답변 어디에 있든 PDF 쪽번호·머리글은 지운다.
        #   (모델이 참고 문서를 그대로 옮겨 적는 경우까지 잡는다)
        before_junk = ans
        ans = re.sub(r"[-–—]?\s*\d+\s*/\s*\d+\s*Mirae\s+Asset\s+Securities\s*",
                     " ", ans)
        ans = re.sub(r"Mirae\s+Asset\s+Securities\s*", " ", ans)
        ans = re.sub(r"(?m)^\s*[-–—]\s*\d+\s*[-–—]\s*$", "", ans)
        ans = re.sub(r"[ \t]{2,}", " ", ans)
        if ans != before_junk:
            clean_note += " 문서 머리글 제거"

        # (1-7c2) v9.84: "확인할 수 없습니다"로 시작하고 곧바로 내용을 설명하는 모순.
        #   실측 13건. 뒷내용이 '다만/그러나'로 시작하면 부분 정보 안내라 정상이다.
        _parts = re.split(r"(?<=[.!?])\s+", ans.strip(), 1)
        # v9.88: 질문 문장이 근거 안에 그대로 있는가 — 사정을 뗀 질문(q_search)
        #   기준, 공백 무시 비교. 있으면 '확인 불가'는 증명 가능한 거짓이다.
        _q_in_doc = len(re.sub(r"[\s?]", "", q_search)) >= 10 and \
            re.sub(r"[\s?]", "", q_search) in re.sub(r"\s", "", context)
        # v9.90: 질문이 문서 표현의 의역이면 위 게이트를 통과하지 못한다(P0697).
        #   그래도 서두가 '무엇을' 못 찾았는지조차 밝히지 않는 알맹이 없는
        #   거절이고, 본문이 "~에 따르면 / 명시되어 있"이라며 문서를 근거로
        #   내용을 설명한다면 — 답변 스스로 서두를 반박하는 자기모순이다.
        #   (R50류 "삼성 ○○의 총보수는 확인할 수 없습니다"는 대상이 명시된
        #    정당한 거절 → fullmatch에 걸리지 않아 보호된다)
        _bare_refuse = len(_parts) == 2 and re.fullmatch(
            r"(?:제공된\s*)?(?:자료|문서)(?:에서|에)는?\s*"
            r"확인(?:할 수 없|되지 않)습니다[.!]?",
            _parts[0].strip()) is not None
        # v9.96: "…정보는 다음과 같습니다: [사실 나열]"도 서두를 스스로 반박하는
        #   꼴이다 (실측 T03·T08 — 서두는 '확인 불가', 본문은 600/900 정리)
        _doc_backed = len(_parts) == 2 and re.search(
            r"(?:에 따르면|명시되어 있|명시하고 있|다음과 같습니다)",
            _parts[1][:200]) is not None
        if (_q_in_doc or (_bare_refuse and _doc_backed)) \
                and len(_parts) == 2 and _NOINFO.search(_parts[0]) \
                and len(_parts[1]) >= 90 \
                and not _NOINFO.search(_parts[1][:200]):
            # v9.87: '다만/하지만'으로 시작해도 뒷내용이 충분하면 회피 반사다.
            #   서두를 지우고 고아가 된 접속사도 함께 정리한다.
            #   (문턱 90/80자 — 실측 P0212가 105자였다. '문의해 보세요' 같은
            #    짧은 안내는 80자 미만이라 그대로 보호된다)
            _body2 = re.sub(r"^\s*(?:다만|그러나|하지만|단|대신)\s*,?\s*", "",
                            _parts[1].strip())
            if len(_body2) >= 80:
                ans = _body2[0].upper() + _body2[1:] if _body2[:1].isascii() else _body2
                clean_note += " 모순 서두 제거"

        # (1-7c3) v9.91: 문서를 근거로 인용한 답변("~라고 명시되어 있습니다")이
        #   결론 문장("따라서 ~")에서만 얼버무리면 앞뒤가 맞지 않는다
        #   (실측 P0697: 근거를 다 인용해 놓고 "어려울 것으로 보입니다").
        #   조건을 좁게 건다 — ① 답변에 근거 인용 표현이 있고 ② '따라서/그러므로'
        #   결론 문장 안이며 ③ 문법이 확정된 꼴만 사전식 치환(어간 변형 없음).
        #   P0725류 "가능성이 큽니다"(개인 사정에 대한 정당한 유보)는 사전에
        #   없으므로 건드리지 않는다.
        if re.search(r"(?:명시되어 있|에 따르면)", ans):
            before_hedge = ans
            for _h, _f in ((r"어려울 것으로 (?:보입니다|예상됩니다)", "어렵습니다"),
                           (r"가능할 것으로 (?:보입니다|예상됩니다)", "가능합니다"),
                           (r"될 것으로 (?:보입니다|예상됩니다)", "됩니다"),
                           (r"필요할 것으로 (?:보입니다|예상됩니다)", "필요합니다"),
                           (r"없을 것으로 (?:보입니다|예상됩니다)", "없습니다"),
                           (r"있을 것으로 (?:보입니다|예상됩니다)", "있습니다")):
                ans = re.sub(r"((?:따라서|그러므로)[^.!?\n]{0,120})" + _h,
                             r"\1" + _f, ans)
            if ans != before_hedge:
                clean_note += " 결론 얼버무림 교정"

        # (1-7d) v9.58: 답변이 '자료에 없다' 한 문장뿐인데 검색된 문서를 근거처럼
        #   달면 "근거가 있다는 건가?"라는 오해를 만든다(실측: 핀테크 허브 질문).
        _body = re.sub(r"\s+", " ", ans).strip()
        if len(_body) <= 80 and _NOINFO.search(_body) and not re.search(r"\d", _body):
            _note = ("※ 아래 문서는 검색 과정에서 함께 조회된 자료이며, "
                     "질문에 해당하는 내용은 포함되어 있지 않았습니다.")
            if _note not in ans:
                ans = ans.rstrip() + "\n\n" + _note
                clean_note += " 무근거 출처 고지"

        # (1-8) v9.36: LaTeX 수식이 그대로 노출되면 화면이 깨진다 ($$900만 \times 16.5\%$$)
        before_tex = ans
        ans = re.sub(r"\$\$?\s*(.*?)\s*\$\$?", r"\1", ans, flags=re.S)
        ans = ans.replace("\\times", "×").replace("\\%", "%").replace("\\,", " ")
        ans = re.sub(r"\\[a-zA-Z]+\{([^}]*)\}", r"\1", ans)   # \text{...} 등
        # v9.60: 마크다운 이스케이프가 그대로 보이는 것 (1억 이상\~3억 미만)
        ans = re.sub(r"\\([~*_\[\]()#+\-.!])", r"\1", ans)
        if ans != before_tex:
            clean_note += " 수식 표기 정리"

        # (1-8a) v9.90: 마크다운 링크 흉터 — 링크 문법이 그대로 노출되거나
        #   깨진 채 나온다 (실측 P0068: "[www.…)에](https://…)에)").
        #   표시 문구만 남기고, 그 과정에서 생기는 중복 조사와 잉여 괄호를 정리.
        before_md = ans
        ans = re.sub(r"\[([^\]\n]+)\]\((?:https?://|www\.)[^)\s]*\)", r"\1", ans)
        if ans != before_md:
            ans = ans.replace("에에", "에")
            ans = re.sub(r"\)에\)", ")에", ans)
            clean_note += " 링크 표기 정리"

        # (1-8b0) v9.92: 'N년 총보수 8.24%'는 라벨 오류다 (실측 R45x) —
        #   투자설명서의 'N년 투자 시 총비용 예시(누적)'를 총보수(연율)처럼 썼다.
        #   총보수는 정의상 연 단위이므로, 'N년 총보수'는 'N년 누적 총비용'으로
        #   조건 없이 다시 쓴다. ('총보수·비용' 같은 정식 라벨은 건드리지 않는다)
        before_fee = ans
        ans = re.sub(r"(\d+)\s*년\s*총\s*보수(?![·ㆍ\s]*비용)", r"\1년 누적 총비용", ans)
        if ans != before_fee:
            clean_note += " 보수 표기 교정"

        # (1-8b) v9.77: 붙어버린 표 행을 먼저 편다 — 뒤의 표 처리들이 온전한 표를 보게
        ans, n_tbl = fix_table_rows(ans)
        if n_tbl:
            clean_note += f" 표 행 정렬 {n_tbl}건"

        # (1-8b1) v9.93: 표가 완성된 뒤, 표와 모순되는 수수료 우열 주장을 검산
        ans, n_fee = fee_claim_check(ans)
        if n_fee:
            clean_note += f" 수수료 주장 검산 {n_fee}건 삭제"

        # (1-8b2) v9.98: 수치 행(수익률·시장잔고·보수) 칸의 숫자는 근거에 있어야
        #   한다. 실측 X1 — 6축을 요구하자 근거에 없는 "약 2.00%", "설정액 약
        #   500억 원"을 지어내 표를 채웠다. 칸의 소수·3자리 이상 숫자를 근거와
        #   대조해(자릿수 경계 매칭) 하나라도 없으면 그 칸을 '자료 없음'으로.
        _NUMROW = re.compile(r"수익률|시장잔고|설정액|순자산|총보수|수수료|보수")
        # 쉼표만 지운다 — 공백까지 지우면 "0.47 0.27"이 "0.470.27"로 붙어
        # 경계 매칭이 깨진다(자가 테스트에서 실측)
        _ctxnum = context.replace(",", "")
        _sl, n_scrub = [], 0
        for _ln in ans.splitlines():
            if _ln.count("|") >= 2 and not re.fullmatch(r"[\s|:\-–—]+", _ln):
                _cs = _ln.split("|")
                _first = _cs[1].strip() if len(_cs) > 2 else ""
                if _NUMROW.search(_first):
                    for _ci in range(2, len(_cs) - 1):
                        _nums = [x for x in
                                 re.findall(r"\d+(?:\.\d+)?", _cs[_ci].replace(",", ""))
                                 if "." in x or len(x) >= 3]
                        _bad = [x for x in _nums if not re.search(
                            r"(?<![\d.])" + re.escape(x) + r"(?![\d])", _ctxnum)]
                        if _bad:
                            _cs[_ci] = " 자료 없음 "
                            n_scrub += 1
                    _ln = "|".join(_cs)
            _sl.append(_ln)
        if n_scrub:
            ans = "\n".join(_sl)
            clean_note += f" 근거 밖 수치 칸 {n_scrub}개 정리"

        # (1-9) v9.41: 비교표에 빠진 비교 항목을 코드가 '자료 없음'으로 채운다.
        #   재생성(4.9단계)은 '줄 수가 너무 적을 때'만 돌아서, 5~6줄짜리 '조금 부족한
        #   표'는 그대로 나갔다. 상세함도 품질이므로 여기서 결정적으로 채운다.
        if system is COMPARE_SYSTEM:
            ans, n_cmp = ensure_compare_rows(ans)
            if n_cmp:
                clean_note += f" 비교 항목 {n_cmp}건 보강"

        # (1-9a) v9.99o: 유형 비교표의 칸 오배치 교정(상품분류에 위험등급, 판매
        #   클래스에 성향 설명). 표만 있으면 적용 — 함수가 내용으로 스스로 가드한다.
        if "|" in ans and "---" in ans:
            ans, n_ml = fix_cell_mislabel(ans)
            if n_ml:
                clean_note += f" 칸 오배치 {n_ml}건 교정"

        # (1-9b) v9.43: 위험등급은 원문(risk_prof)을 기준으로 표·문장을 바로잡는다
        if system is COMPARE_SYSTEM and risk_prof:
            ans, n_row, _matched, n_unver = enforce_risk_row(ans, risk_prof)
            ans, n_drop, _rnote = fix_risk_claims(ans, risk_prof, _matched,
                                                  question, n_unver)
            # v9.72: 실제로 한 일만 적는다 (예전에는 아무 일도 안 해도 찍혔다)
            if n_row:
                clean_note += f" 위험등급 표 {n_row}칸 교정"
            if n_drop:
                clean_note += f" 위험등급 모순 {n_drop}건 삭제"
            if n_unver:
                clean_note += f" 원문 미대조 {n_unver}칸"
            clean_note += _rnote
        # v9.99f: 카테고리 비교(TDF·원리금보장형 등)라 원문 상품을 못 찾으면
        #   risk_prof가 비어 위 블록이 통째로 건너뛴다. 그래도 표에 '위험등급'
        #   행이 등급을 주장하면(N등급) 어떤 마크도 없어 검사 불변식에 걸린다
        #   (실측 R27 반복 흔들림). 원문 대조를 못 했음을 WARN 마크로 밝힌다.
        if system is COMPARE_SYSTEM and not risk_prof \
                and RISK_CARD_MARK not in ans and RISK_WARN_MARK not in ans:
            _has_grade_row = any(
                ln.count("|") >= 2 and re.search(r"위험\s*등급", ln)
                and re.search(r"\d\s*등급", ln)
                for ln in ans.splitlines())
            if _has_grade_row:
                ans = ans.rstrip() + (
                    "\n\n" + RISK_WARN_MARK + " 불가] 표에 적힌 위험등급은 "
                    "질문에서 특정 상품을 지정하지 않아(상품군 비교) 각 상품의 "
                    "투자설명서 원문과 대조하지 못했습니다. 가입 전 각 상품의 "
                    "투자설명서에서 위험등급을 직접 확인하시기 바랍니다.")
                clean_note += " 위험등급 대조 불가 고지(상품군 비교)"
        # v9.79: 사냥 실측 창작 두 가지 — 문서에 없으면 지운다
        ans = re.sub(r"금융소비자보호법\s*\(\s*FINRA\s*\)", "금융소비자보호법", ans)
        _cal = re.compile(r"[^.!?\n]*(?:캘린더|달력)\s*기준[^.!?\n]*[.!?]?"
                          r"|[^.!?\n]*당일[은는이]?\s*포함되지\s*않[^.!?\n]*[.!?]?"
                          r"|[^.!?\n]*\d+\s*일째[^.!?\n]*[.!?]?")
        for _m in list(_cal.finditer(ans)):
            _s = _m.group().strip()
            if not _s:
                continue
            # v9.91: '59일째' 같은 날수 재계산은 문서에 그 숫자가 없으면 창작이다
            #   — 다른 방어보다 먼저 본다 (합법 정보와 한 문장에 섞여도 지운다)
            _mday = re.search(r"\d+\s*일째", _s)
            if _mday:
                if _mday.group().replace(" ", "") in context.replace(" ", ""):
                    continue          # 문서가 그 날수를 실제로 말한다 → 보존
                ans = ans.replace(_m.group(), "", 1)
                clean_note += " 달력 해석 창작 제거"
                continue
            # v9.91: 문서가 실제로 그 달력 해석을 말하면 의역이라도 지우지 않는다
            #   (실측 doc33: "(60일은 캘린더 기준, 만기일 당일 미포함)" — 진짜 정보다.
            #    예전 방어는 '앞 20자 그대로 인용'일 때만 살렸다 → 의미 기준으로 완화)
            if ("캘린더" in _s or "달력" in _s) and \
                    re.search(r"(?:캘린더|달력)\s*기준", context):
                continue
            if "포함되지" in _s and \
                    re.search(r"당일\s*(?:미포함|불산입|포함되지\s*않)", context):
                continue
            if _s[:20] not in context:
                ans = ans.replace(_m.group(), "", 1)
                clean_note += " 달력 해석 창작 제거"
        # v9.80: 근거·질문에 없는 연도가 든 문장 제거 (실측 P0167: 2023→2028 왜곡)
        _ctx_years = set(re.findall(r"(?:19|20)\d{2}", context + " " + question))
        _bad_years = [y for y in set(re.findall(r"(?:19|20)\d{2}", ans))
                      if y not in _ctx_years]
        if _bad_years:
            _ny, _out = 0, []
            for _l in ans.splitlines():
                if _l.count("|") >= 2 or _l.startswith(("[참고 문서]", "※", "[위험등급")):
                    _out.append(_l)
                    continue
                _keep = []
                for _sent in re.split(r"(?<![0-9]\.)(?<=[.!?])\s+", _l):
                    if any(y in _sent for y in _bad_years):
                        _ny += 1
                        continue
                    _keep.append(_sent)
                _out.append(" ".join(k for k in _keep if k.strip()))
            if _ny:
                ans = re.sub(r"\n{3,}", "\n\n", "\n".join(_out))
                clean_note += f" 근거 밖 연도 문장 {_ny}건 제거"
        # v9.82: 구기준 400만원 세액공제 문장 제거 (2014년 이전 기준 — 현행 600만원)
        _old400 = re.compile(r"[^.!?\n]*400\s*만\s*원[^.!?\n]*세\s*액\s*공제[^.!?\n]*[.!?]?"
                             r"|[^.!?\n]*세\s*액\s*공제[^.!?\n]*400\s*만\s*원[^.!?\n]*[.!?]?")
        for _m in list(_old400.finditer(ans)):
            _g = _m.group()
            if not any(w in _g for w in ("과거", "예전", "이전 기준", "종전")):
                ans = ans.replace(_g, "", 1)
                clean_note += " 구기준 400만원 문장 제거"
        ans, n_reason = strip_invented_reason(ans)
        if n_reason:
            clean_note += f" 지어낸 이유 {n_reason}건 제거"
        ans, n_spec = strip_speculation(ans)
        if n_spec:
            clean_note += f" 근거 없는 추측 {n_spec}건 정리"
        # v9.59: 각주는 표 보강·추측 정리가 모두 끝난 뒤에 붙인다
        ans, n_foot = ensure_noinfo_footnote(ans)
        if n_foot:
            clean_note += " 자료 없음 각주 추가"
        if system is COMPARE_SYSTEM:
            ans, n_gen = warn_partial_generalization(ans)
            if n_gen:
                clean_note += f" 부분자료 일반화 주의 {n_gen}건"

        # (1-9z) v9.83: 6.5단계 이후 붙은 블록(기한 보강 등)의 파일명을 한 번 더 청소
        ans = "\n".join(
            _l if _l.strip().startswith("[참고 문서]")
            else _FNAME_IN.sub("아래 참고 문서", _l)
            for _l in ans.splitlines())
        ans = ans.replace("∙", "·")

        # (1-10) v9.81: 청소가 남긴 구두점 흉터 (실측: "때문입니다.,,")
        ans = re.sub(r"([.!?])\s*,+", r"\1", ans)
        ans = re.sub(r",{2,}", ",", ans)
        ans = re.sub(r"(?m)[ \t]*,[ \t]*$", "", ans)
        # (1-11) v9.83: 잘린 꼬리 — 코드가 붙인 카드(※·[참고 문서] 등)는 보존하고
        #   그 '위'를 검사한다 (v9.81은 카드를 만나면 멈춰서 잘린 조각을 못 봤다).
        _tl = ans.rstrip().splitlines()
        _prot, _n_tail = [], 0
        _END_SENT = re.compile(r"(?:[.!?…\]\)]|다|요|음|함|임|됨|것)\s*$")
        while _tl:
            _last = _tl[-1].strip()
            if not _last:
                _tl.pop()
                continue
            if _last.startswith(("[참고 문서]", "※", "[위험등급", "[연금수령")):
                _prot.insert(0, _tl.pop())
                continue
            if _last.count("|") >= 2 or _END_SENT.search(_last):
                break
            if _n_tail >= 2:
                break
            # 조각이 정상 문장과 한 줄에 붙어 있으면 마지막 문장부호 뒤만 잘라낸다.
            #   (자르기는 답을 비우지 않으므로 '한 줄뿐' 가드보다 먼저 — v9.83 실측)
            _pos = max(_tl[-1].rfind("."), _tl[-1].rfind("!"), _tl[-1].rfind("?"))
            if _pos >= 10 and len(_tl[-1]) - _pos > 8:
                _tl[-1] = _tl[-1][:_pos + 1]
                _n_tail += 1
                break
            if len(_tl) == 1:
                break
            _tl.pop()
            _n_tail += 1
        if _n_tail:
            ans = "\n".join(_tl + _prot)
            clean_note += f" 잘린 꼬리 {_n_tail}건 제거"

        # (2) 지우고 남은 이중 공백 정리
        ans = re.sub(r"\|\s{2,}\|", "| |", ans)
        ans = re.sub(r"[ \t]{3,}", "  ", ans)
        # [8.5단계] v11.6: 최종 마크다운 정리 — src_tail([참고 문서])이 아직 분리된
        #   상태에서 본문만 정리하므로 출처 줄은 보호된다. 내용은 건드리지 않는다.
        _pre = ans
        ans = _final_cleanup(ans)
        if ans != _pre:
            clean_note += " 9) 최종정리(글리치·중복·흉터)"
        if src_tail:                      # v9.25: 출처 줄을 맨 끝으로 되돌린다
            ans = ans.rstrip() + "\n\n" + src_tail.strip()
        if clean_note:
            clean_note = " 8) 출력 정리:" + clean_note

        # [9단계] v11.5: 외부 공식기관 최신성/상태변경 교차검증(선택·never-block).
        #   기존 verify_answer(문서 근거 검증)와 역할이 다름 — 절대 섞지 않는다.
        #   EXTERNAL_VERIFICATION_ENABLED=False(기본)면 즉시 []→답변·trace 불변.
        #   timeout/exception/인증불가/데이터없음이면 문서 기준 답변을 그대로 유지.
        #   CONFLICT여도 본문을 덮어쓰지 않고 '차이가 있다'만 병기.
        ext_note = ""
        if verify_layer is not None and ans != "답변 생성에 실패했습니다.":
            try:
                _ext = verify_layer.verify_answer(ans, context, question, qtype)
                if _ext:
                    ans = verify_layer.apply_verification(ans, _ext)   # 병기만(삭제·덮어쓰기 없음)
                    ext_note = verify_layer.verification_trace(_ext)   # 검증여부·status·reason 기록
            except Exception as _ve:
                ext_note = ""      # never-block: 무슨 일이 있어도 답변을 막지 않는다

        trace = (f"{mt_note}1) {SEARCH_MODE} 검색으로 {len(idx_list)}개 청크 비교"
                 f"{_exp_note} "
                 f"2) 임계값 {THRESHOLD} 통과 (최고 유사도 {top_score:.3f}) "
                 f"3) LLM 유형 분류: '{qtype}'{action_note} "
                 f"4) 근거 문서 {len(used)}개 사용 "
                 f"(유사도: {', '.join(f'{s:.3f}' for s in used_scores[:len(used)])}) "
                 f"5) '{qtype}' 전용 프롬프트로 HCX-005 답변 생성"
                 f"{verify_note}{calc_note} 7) 참고 문서 출처 표기{clean_note}"
                 f"{ext_note}"
                 f" | 총 {time.time() - t_start:.1f}초")

        HISTORY.append((question, ans, was_askback))  # 멀티턴용: 대화 저장 (무관 답변은 저장 안 함)
        return {
            "question_id": question_id,
            "question": question,
            "retrieved_context": context,
            "think_trace": trace,
            "answer": ans,
        }
    except Exception as e:
        # v9.73: 예외를 삼키지 않는다. 무엇이 어디서 났는지 남겨야 고칠 수 있다.
        import traceback
        tb = traceback.format_exc()
        try:
            with open("error.log", "a", encoding="utf-8") as _f:
                _f.write(f"\n===== {time.strftime('%m-%d %H:%M:%S')} "
                         f"qid={question_id} retried={_retried}\n"
                         f"질문: {question}\n{tb}")
        except OSError:
            pass
        _loc = ""
        _hits = [l for l in tb.splitlines() if 'main.py", line' in l]
        if _hits:
            _loc = " @" + _hits[-1].strip().split(",")[1].strip()
        # v9.73: 심사는 질문당 1회뿐이다. 여기서 포기하면 그 문항은 통째로 날아간다.
        #   한 번만 통째로 다시 시도한다 (무한 반복은 _retried로 막는다).
        if not _retried:
            time.sleep(3)
            out = answer(question_id=question_id, question=question, _retried=True)
            out["think_trace"] = (f"[1차 시도 실패: {type(e).__name__}{_loc} → 재시도] "
                                  + out.get("think_trace", ""))
            return out
        return {
            "question_id": question_id,
            "question": question,
            "retrieved_context": "",
            "think_trace": f"오류 발생: {type(e).__name__}: {e}{_loc} (재시도 후에도 실패)",
            "answer": "일시적인 오류가 발생했습니다.",
        }
