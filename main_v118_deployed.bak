#   한 답변 안에 '확인 질문 + 경우별 실질 안내'를 모두 담게 한다.
ASK_BACK_SYSTEM = (
    "너는 미래에셋증권의 연금 전문 상담사야. 사용자가 상품 추천을 원하지만 "
    "나이대·투자성향 정보가 없어서 하나로 특정할 수 없는 상황이야.\n"
    "※ 이 상담은 한 번의 답변으로 끝난다. 되물어도 사용자가 답할 기회가 없으므로 "
    "질문만 하고 끝내면 안 된다. 아래 세 가지를 반드시 '한 답변 안에' 모두 담아라.\n"
    "1) 더 정확한 추천을 위해 필요한 정보 두 가지(나이대 또는 은퇴까지 남은 기간, "
    "투자성향)를 정중히 여쭙는다. 1~2문장으로 짧게.\n"
    "2) 답을 기다리지 말고, 대표적인 경우를 2~3가지로 나눠 각각 안내한다. "
    "예: '은퇴까지 20년 이상 남고 변동성을 감수할 수 있다면', "
    "'은퇴가 가깝거나 원금 보전을 우선한다면'처럼 경우를 명시하고, "
    "각 경우마다 참고 문서에 근거한 선택 기준과 문서에 실제로 등장하는 상품 유형·예시를 "
    "제시한다.\n"
    "3) 각 경우의 근거(위험등급, 수수료, 세제 혜택, 투자 대상 등)를 문서에서 인용해 밝힌다.\n"
    "- 특정 상품을 '이걸 사세요'라고 단정하지 마. 경우별 예시와 기준으로 안내해.\n"
    "- 문서에 없는 상품명이나 내용은 절대 지어내지 마. 문서에서 못 찾으면 "
    "'제공된 자료에는 개별 상품 정보가 없습니다'라고 밝히고 선택 기준만 안내해.\n"
    "- 투자 판단의 최종 책임은 투자자 본인에게 있다는 점을 자연스럽게 언급해."
)


def pension_limit(question):
    """v9.32: 세액공제 한도는 상품에 따라 다르다.
    연금저축에만 넣었으면 600만원, IRP(또는 퇴직연금)가 함께면 합산 900만원.
    실측 오류: '연금저축에 1,800만원' 질문에 한도 900을 적용해 148.5만원이라 답했다
    (정답은 600만 x 16.5% = 99만원)."""
    q = question.upper()
    has_irp = any(k in q for k in ("IRP", "개인형퇴직연금", "퇴직연금", "DC", "DB"))
    has_only_ysj = ("연금저축" in question) and not has_irp
    if has_only_ysj:
        return 600, "연금저축 단독"
    return 900, "연금저축+IRP 합산"


def calc_pension_tax_credit(salary, paid, limit=900, limit_label="연금저축+IRP 합산"):
    """연금계좌 세액공제 계산기 — 문서 기준 반영
    salary: 총급여(만원), paid: 연간 납입액(만원), limit: 상품별 공제 한도(만원)"""
    LIMIT = limit
    if salary <= 5500:  # 총급여 5,500만원 이하 (종합소득 4,500만원 이하)
        rate, rate_txt = 0.165, "16.5%"
        band = "총급여 5,500만원 이하"
    else:
        rate, rate_txt = 0.132, "13.2%"
        band = "총급여 5,500만원 초과"
    base = min(paid, LIMIT)
    credit = base * rate
    lines = [
        "[세액공제 계산기 결과]",
        f"- 총급여: {int(salary):,}만원 → {band} → 공제율 {rate_txt} (지방소득세 포함)",
        f"- 연간 납입액: {int(paid):,}만원 → 공제 대상 금액: {int(base):,}만원 "
        f"({limit_label} 세액공제 한도 {int(LIMIT):,}만원 적용)",
        f"- 예상 세액공제액: {int(base):,}만원 × {rate_txt} = 약 {credit:,.1f}만원",
    ]
    if paid > LIMIT:
        lines.append(f"- 참고: 한도({int(LIMIT):,}만원)를 초과한 {int(paid - LIMIT):,}만원은 "
                     f"세액공제 대상이 아님")
    # v9.13: 답변을 코드로 검증하기 위해 계산 값도 함께 돌려준다
    return "\n".join(lines), {"paid": paid, "base": base, "limit": LIMIT,
                              "rate": rate, "rate_txt": rate_txt, "credit": credit}


# v9.13: LLM이 계산기 결과를 무시하고 다른 숫자를 쓰는 문제를 코드로 교정한다.
#   실제 오류: 400만+300만=700만인데 답변이 '합산 900만원 x 13.2% = 118.8만원'
#   → 프롬프트 지시만으로는 막히지 않아 계산식 자체를 정규식으로 바로잡는다.
_CALC_PAT = re.compile(
    r"([\d,]+)\s*만\s*원?\s*[x\u00d7X*]\s*([\d.]+)\s*%\s*=\s*(?:약\s*)?([\d,.]+)\s*만\s*원?")


def enforce_calc(ans, calc):
    """계산기가 돌았을 때 답변 속 계산식을 계산기 값으로 강제 교정"""
    if not calc:
        return ans, ""
    base, rate_txt, credit = calc["base"], calc["rate_txt"], calc["credit"]
    correct = f"{int(base):,}만원 \u00d7 {rate_txt} = 약 {credit:,.1f}만원"
    cnt = [0]

    def _fix(m):
        try:
            a = float(m.group(1).replace(",", ""))
            r = float(m.group(2))
            c = float(m.group(3).replace(",", ""))
        except ValueError:
            return m.group(0)
        if abs(a - base) < 0.5 and abs(r - calc["rate"] * 100) < 0.01 \
                and abs(c - credit) < 0.05:
            return m.group(0)          # 계산기와 일치 → 그대로 둔다
        cnt[0] += 1
        return correct

    ans = _CALC_PAT.sub(_fix, ans)

    # (2) '한도(900만원)를 납입액으로 착각한' 값이 본문에 남아 있으면 바로잡는다
    wrong = calc["limit"] * calc["rate"]
    if abs(wrong - credit) > 0.05:
        wpat = re.compile(r"(?<![\d.])" + re.escape(f"{wrong:,.1f}") + r"\s*만\s*원?")
        ans, k = wpat.subn(f"{credit:,.1f}만원", ans)
        cnt[0] += k

    # (3) '합산하여 900만원' 처럼 납입액을 한도로 바꿔 말한 문장을 통째로 교체
    if calc["paid"] < calc["limit"]:
        limit_txt = f"{int(calc['limit']):,}"
        out = []
        for sent in re.split(r"(?<=[.!?])\s+|\n", ans):
            if ("합산" in sent or "합쳐" in sent or "합해" in sent) \
                    and re.search(limit_txt + r"\s*만\s*원", sent):
                out.append(f"연금저축과 IRP를 합산한 납입액은 {int(calc['paid']):,}만원으로, "
                           f"세액공제 한도({limit_txt}만원) 이내입니다.")
                cnt[0] += 1
            else:
                out.append(sent)
        ans = "\n".join(out)

    # 교정 후에도 정답 금액이 답변에 없으면 결과를 맨 위에 못박는다
    if f"{credit:,.1f}" not in ans and f"{int(round(credit)):,}" not in ans:
        ans = (f"납입하신 {int(base):,}만원에 대한 예상 세액공제액은 "
               f"**{correct}**입니다.\n\n" + ans)
        cnt[0] += 1
    if cnt[0]:
        return ans, f" (계산식 코드 교정 {cnt[0]}건)"
    return ans, ""


def reconcile_sum_limit(ans, paid, base, limit):
    """v11.6: 소득 미상(band_vals)이라 enforce_calc가 안 돌 때, 연금저축+IRP '합산'
    맥락에서 LLM이 남긴 잘못된 결론 문장('합해/합산/분산 … 한도/대상 X만원 적용')의
    X가 계산된 공제대상(base)과 다르면 그 '문장만' 계산값 기준으로 in-place 재작성한다.
    특정 숫자('600')를 지우는 하드코딩이 아니라, 값이 어긋난 결론 문장을 값으로 교정.
    교정할 게 없으면 원문을 그대로 돌려준다(구조·다른 문장 불변)."""
    if base is None or paid is None or limit is None:
        return ans, 0
    n = [0]

    def _fix(m):
        pre, s = m.group(1), m.group(2)
        if re.search(r"합산|합해|합쳐|두 계좌|분산", s) and re.search(r"적용|대상", s):
            mv = re.search(r"(\d[\d,]*)\s*만\s*원", s)
            if mv and int(mv.group(1).replace(",", "")) != int(base):
                n[0] += 1
                return pre + (f"연금저축과 IRP 합산 납입액 {int(paid):,}만원은 세액공제 "
                              f"한도({int(limit):,}만원) 이내이므로, 세액공제 대상 금액은 "
                              f"{int(base):,}만원입니다.")
        return m.group(0)

    ans2 = re.sub(r"(\s*)([^\n.!?]+[.!?])", _fix, ans)
    return (ans2, n[0]) if n[0] else (ans, 0)


# v9.15: '연금저축 단독 900만원'처럼 한도를 뭉뚱그리는 오류 (회귀 R02 재발) 대응.
#   문서로 검증된 한도 구조를 카드로 만들어 참고 문서 맨 위에 못박는다.
LIMIT_CARD = (
