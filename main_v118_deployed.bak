#         (154)용어 확장 2건 추가 — '구개인연금'→'개인연금저축'(doc2),
#         '회사채/특수채'→'계열·매수한도·위험자산'(doc7 40% 규정).
#  v9.94: 새 문서 표적 사냥(193문항, 오류 0/의심 31)의 3대 원인 수리.
#         (150)분류기가 '연금' 단어 없는 앱·서비스 질문(MP구독·인증서·장려금)을
#         '무관'으로 오판해 반사 거절 — 유사도 0.55 이상이면 반증으로 보고
#         '제도'로 진행한다(실측: 진짜 무관 0.43~0.51 vs 오판 7건 0.64~0.75).
#         (151)정답 청크를 주고도 '확인할 수 없다'로 회피(4건) — 질문이 근거
#         문서의 FAQ 질문(QN.)과 바이그램 겹침 0.6 이상이면 'FAQ 일치 카드'를
#         코드가 붙여 그 항목의 답을 쓰도록 못박는다.
#         (152)한 문서가 검색 5자리를 독식해 정답 문서가 밀림(doc46×4,
#         doc54×5 실측) — 같은 문서는 최대 3청크까지만 뽑는다.
#  v9.93: (148)R45y 실측 — 표에는 단기 0.47/중장기 0.46/장기 0.45%인데 요약이
#         "단기가 약간 더 저렴합니다"라고 썼다(자기 표와 모순 + 우열 단정
#         금지 규칙 위반). 표가 답변 안에 있으므로 코드가 검산한다:
#         수수료 행의 %값을 파싱해, 우열 주장이 가리키는 상품(열 이름의
#         고유 단어로 판별, 긴 단어 우선 — '중장기' 안의 '장기' 오인 방지)이
#         최저가 열이 아니면 그 문장을 지운다. 맞는 주장은 보존(R27 보호).
#         (149)기존 행의 빈 칸('| | |')이 그대로 나갔다 — 행 보강은 빠진
#         '행'만 채웠다. fix_table_rows가 빈 칸을 '자료 없음'으로 채운다.
#  v9.92: (147)R45x 실측 두 가지 — 비교표 수수료 칸의 '자료 있음'(정보가 0인
#         표기)과 '10년 총보수 8.24%'(누적 총비용을 연율 라벨로 오기).
#         프롬프트에 수수료 칸 규칙(연 총보수를 클래스명과 함께)을 넣고,
#         코드가 ①'자료 있음' 칸을 '자료 없음'으로 되돌리고(각주가 설명)
#         ②'N년 총보수'를 'N년 누적 총비용'으로 조건 없이 다시 쓴다.
#         (146)달력 해석 제거(v9.79)의 방어가 '앞 20자 그대로 인용'일 때만
#         작동해, 재추출된 doc33이 실제로 말하는 "(60일은 캘린더 기준,
#         만기일자 불산입)"을 의역하면 진짜 정보가 지워졌다 → 의미 기준
#         방어로 완화(문서에 '캘린더/달력 기준', '당일 미포함/불산입'이
#         있으면 보존). 단 'N일째' 날수 재계산은 문서에 그 숫자가 그대로
#         없으면 여전히 창작으로 보고 지운다(P0310 방어 유지).

load_dotenv()
API_KEY = os.getenv("CLOVA_API_KEY")
EMB_URL = "https://clovastudio.stream.ntruss.com/v1/api-tools/embedding/v2"
CHAT_URL = "https://clovastudio.stream.ntruss.com/v3/chat-completions/HCX-005"
HEADERS = {"Authorization": f"Bearer {API_KEY}", "Content-Type": "application/json"}

# ---- 서버 시작 시 딱 1번 로딩 (질문마다 다시 안 읽음) ----
print("검색 인덱스 로딩 중...")
with open("chunks.json", encoding="utf-8") as f:
    chunks = json.load(f)
with open("embeddings.json", encoding="utf-8") as f:
    embs = json.load(f)
idx_list = [e["idx"] for e in embs]
matrix = np.array([e["embedding"] for e in embs])
matrix = matrix / np.linalg.norm(matrix, axis=1, keepdims=True)
print(f"로딩 완료: 청크 {len(idx_list)}개")

# ---- v7: 경량 BM25 키워드 인덱스 (외부 라이브러리 없이 직접 구현) ----
import math
from collections import Counter

def _tok(text):
    """한국어 대응 토큰화: 공백 단어 + 2글자 조각(바이그램)"""
    words = text.lower().split()
    grams = []
    for w in words:
        grams.append(w)
        grams += [w[i:i + 2] for i in range(len(w) - 1)]
    return grams

try:
    print("BM25 키워드 인덱스 구축 중... (수십 초 걸릴 수 있음)")
    _N = len(idx_list)
    _doc_len = np.zeros(_N)
    _df = {}
    _tmp = []
    for i, j in enumerate(idx_list):
        c = Counter(_tok(chunks[j]["text"]))
        _tmp.append(c)
        _doc_len[i] = sum(c.values())
        for t in c:
            _df[t] = _df.get(t, 0) + 1
    _avg_len = float(_doc_len.mean()) or 1.0
    # 너무 흔한 토큰(전체 40% 이상 문서에 등장)은 제외 → 메모리·속도 절약
    _idf = {t: math.log(1 + (_N - n + 0.5) / (n + 0.5))
            for t, n in _df.items() if n <= _N * 0.4}
    _inv = {}
    for i, c in enumerate(_tmp):
        for t, tf in c.items():
            if t in _idf:
                _inv.setdefault(t, []).append((i, tf))
    _inverted = {t: (np.array([p[0] for p in v], dtype=np.int32),
                     np.array([p[1] for p in v], dtype=np.float32))
                 for t, v in _inv.items()}
    del _tmp, _inv, _df

    def bm25_scores(query, k1=1.5, b=0.75):
        s = np.zeros(_N)
        norm = k1 * (1 - b + b * _doc_len / _avg_len)
        for t in set(_tok(query)):
            hit = _inverted.get(t)
            if hit is None:
                continue
            ids, tfs = hit
            s[ids] += _idf[t] * tfs * (k1 + 1) / (tfs + norm[ids])
        return s

    HYBRID = True
    SEARCH_MODE = "임베딩+키워드(BM25) 하이브리드"
    print(f"BM25 인덱스 구축 완료 (토큰 {len(_inverted):,}종) → 하이브리드 검색 사용")
except Exception as _e:
    HYBRID = False
    SEARCH_MODE = "임베딩"
    print(f"BM25 구축 실패, 임베딩 단독 검색으로 진행: {_e}")

# v9.9: 응답에 charset=utf-8 을 명시해 클라이언트별 한글 깨짐을 방지
from fastapi.responses import JSONResponse


class UTF8JSONResponse(JSONResponse):
    media_type = "application/json; charset=utf-8"


app = FastAPI(default_response_class=UTF8JSONResponse)

